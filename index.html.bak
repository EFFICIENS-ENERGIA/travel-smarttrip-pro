  <!-- Conteneur des Toasts Flottants Duolingo -->
  <div id="duoToastContainer"></div>

  <!-- JAVASCRIPT DUOLINGO UI ENGINE -->
  <script>
    // Assainissement universel contre les vulnérabilités XSS (DOM & Stored)
    function escapeHtml(str) {
      if (str === null || str === undefined) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function escapeAttr(str) {
      if (str === null || str === undefined) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;');
    }

    // =========================================================================
    // SYSTÈME DE MONÉTISATION, AFFILIATION MULTI-OTA & TRACKING COMMERCIAL
    // =========================================================================
    const DEFAULT_AFFILIATE_CONFIG = {
      enabled: true,
      bookingAid: '2415890',
      bookingLabel: 'travellingo_pro',
      expediaCamref: '1100l397a',
      agodaCid: '1894210',
      airbnbRef: 'c_travellingo',
      googleUtmSource: 'travellingo',
      googleUtmCampaign: 'hotel_deal',
      fallbackReferral: 'travellingo_partner'
    };

    let AFFILIATE_CONFIG = { ...DEFAULT_AFFILIATE_CONFIG };

    function loadAffiliateConfig() {
      try {
        const saved = localStorage.getItem('travellingo_affiliate_config');
        if (saved) {
          const parsed = JSON.parse(saved);
          AFFILIATE_CONFIG = { ...DEFAULT_AFFILIATE_CONFIG, ...parsed };
        }
      } catch (e) {
        console.warn('Erreur chargement AFFILIATE_CONFIG:', e);
      }
    }

    function saveAffiliateConfig(newConfig) {
      try {
        AFFILIATE_CONFIG = { ...AFFILIATE_CONFIG, ...newConfig };
        localStorage.setItem('travellingo_affiliate_config', JSON.stringify(AFFILIATE_CONFIG));
      } catch (e) {
        console.warn('Erreur sauvegarde AFFILIATE_CONFIG:', e);
      }
    }

    // Injection automatique des identifiants d'affiliation et tags selon la plateforme
    function applyAffiliateToUrl(url, platformId) {
      if (!url || !AFFILIATE_CONFIG.enabled) return url;
      try {
        const urlObj = new URL(url);
        if (platformId === 'booking' || url.includes('booking.com')) {
          if (AFFILIATE_CONFIG.bookingAid) urlObj.searchParams.set('aid', AFFILIATE_CONFIG.bookingAid);
          if (AFFILIATE_CONFIG.bookingLabel) urlObj.searchParams.set('label', AFFILIATE_CONFIG.bookingLabel);
        } else if (platformId === 'agoda' || url.includes('agoda.com')) {
          if (AFFILIATE_CONFIG.agodaCid) urlObj.searchParams.set('cid', AFFILIATE_CONFIG.agodaCid);
        } else if (platformId === 'expedia' || url.includes('expedia.')) {
          if (AFFILIATE_CONFIG.expediaCamref) urlObj.searchParams.set('camref', AFFILIATE_CONFIG.expediaCamref);
        } else if (platformId === 'airbnb' || url.includes('airbnb.')) {
          if (AFFILIATE_CONFIG.airbnbRef) urlObj.searchParams.set('ref', AFFILIATE_CONFIG.airbnbRef);
        } else if (platformId === 'googletravel' || url.includes('google.com/travel')) {
          urlObj.searchParams.set('utm_source', AFFILIATE_CONFIG.googleUtmSource || 'travellingo');
          urlObj.searchParams.set('utm_medium', 'referral');
          urlObj.searchParams.set('utm_campaign', AFFILIATE_CONFIG.googleUtmCampaign || 'hotel_deal');
        } else {
          urlObj.searchParams.set('utm_source', AFFILIATE_CONFIG.googleUtmSource || 'travellingo');
        }
        return urlObj.toString();
      } catch (e) {
        const sep = url.includes('?') ? '&' : '?';
        if (platformId === 'booking' && AFFILIATE_CONFIG.bookingAid) {
          return `${url}${sep}aid=${encodeURIComponent(AFFILIATE_CONFIG.bookingAid)}&label=${encodeURIComponent(AFFILIATE_CONFIG.bookingLabel || 'travellingo')}`;
        }
        return url;
      }
    }

    // Suivi et consignation locale des clics sortants (Analytics Admin sans tiers)
    function trackOutboundClick(platformId, hotelName, dest, price) {
      try {
        const clickEvent = {
          timestamp: new Date().toISOString(),
          platform: platformId,
          hotelName: hotelName || 'Recherche générale',
          destination: dest || (document.getElementById('destInput')?.value || 'Destination'),
          price: price || 0,
          estimatedCommission: Math.max(0.80, parseFloat(((price || 120) * 0.04).toFixed(2)))
        };

        const existingRaw = localStorage.getItem('travellingo_analytics_clicks');
        let clicks = [];
        if (existingRaw) {
          try { clicks = JSON.parse(existingRaw); } catch(e) { clicks = []; }
        }
        clicks.unshift(clickEvent);
        if (clicks.length > 150) clicks = clicks.slice(0, 150);
        localStorage.setItem('travellingo_analytics_clicks', JSON.stringify(clicks));

        showDuoToast(`Redirection sécurisée vers ${platformId.toUpperCase()}...`, 'info', 2200);
      } catch (e) {
        console.warn('Erreur trackOutboundClick:', e);
      }
    }

    // =========================================================================
    // SYSTÈME DE NOTIFICATIONS TOASTS DUOLINGO INTERACTIFS
    // =========================================================================
    function showDuoToast(message, type = 'info', duration = 3000) {
      const container = document.getElementById('duoToastContainer');
      if (!container) return;

      const toast = document.createElement('div');
      let icon = '🔔';
      let borderClass = 'border-blue-400 text-blue-900 bg-blue-50';
      if (type === 'success') {
        icon = '✅';
        borderClass = 'border-emerald-400 text-emerald-900 bg-emerald-50';
      } else if (type === 'warning') {
        icon = '⚠️';
        borderClass = 'border-amber-400 text-amber-900 bg-amber-50';
      } else if (type === 'error') {
        icon = '❌';
        borderClass = 'border-rose-400 text-rose-900 bg-rose-50';
      } else if (type === 'heart') {
        icon = '❤️';
        borderClass = 'border-rose-400 text-rose-900 bg-rose-50';
      } else if (type === 'theme') {
        icon = '🌓';
        borderClass = 'border-indigo-400 text-indigo-900 bg-indigo-50';
      }

      toast.className = `duo-toast flex items-center gap-2 px-3.5 py-2.5 rounded-xl border-2 shadow-lg font-bold text-xs ${borderClass} pointer-events-auto transition-all duration-300`;
      toast.innerHTML = `<span class="text-base">${icon}</span><span class="flex-1">${escapeHtml(message)}</span>`;

      container.appendChild(toast);

      setTimeout(() => {
        toast.style.opacity = '0';
        toast.style.transform = 'translateY(10px)';
        setTimeout(() => toast.remove(), 300);
      }, duration);
    }

    // =========================================================================
    // SYSTÈME DE THÈME SOMBRE "NIGHT FLIGHT" GAMIFIÉ
    // =========================================================================
    function initTheme() {
      try {
        const savedTheme = localStorage.getItem('travellingo_theme') || 'light';
        if (savedTheme === 'dark') {
          document.documentElement.classList.add('dark');
          updateThemeToggleIcon(true);
        } else {
          document.documentElement.classList.remove('dark');
          updateThemeToggleIcon(false);
        }
      } catch (e) {
        console.warn('Erreur initTheme:', e);
      }
    }

    function toggleTheme() {
      try {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('travellingo_theme', isDark ? 'dark' : 'light');
        updateThemeToggleIcon(isDark);
        showDuoToast(isDark ? 'Mode Nuit activé 🌙' : 'Mode Jour activé ☀️', 'theme', 2000);
      } catch (e) {
        console.warn('Erreur toggleTheme:', e);
      }
    }

    function updateThemeToggleIcon(isDark) {
      const icon = document.getElementById('themeIcon');
      const text = document.getElementById('themeText');
      if (icon) icon.textContent = isDark ? '🌙' : '☀️';
      if (text) text.textContent = isDark ? 'Nuit' : 'Jour';
    }

    // =========================================================================
    // SYSTÈME DE FILTRES D'ÉQUIPEMENTS EXPRESS (1-CLIC)
    // =========================================================================
    const ACTIVE_AMENITY_FILTERS = new Set();

    function initAmenityFilters() {
      try {
        const saved = localStorage.getItem('travellingo_amenity_filters');
        if (saved) {
          const arr = JSON.parse(saved);
          if (Array.isArray(arr)) {
            arr.forEach(k => ACTIVE_AMENITY_FILTERS.add(k));
          }
        }
        updateAmenityFilterUI();
      } catch (e) {
        console.warn('Erreur initAmenityFilters:', e);
      }
    }

    function toggleAmenityFilter(key) {
      if (ACTIVE_AMENITY_FILTERS.has(key)) {
        ACTIVE_AMENITY_FILTERS.delete(key);
      } else {
        ACTIVE_AMENITY_FILTERS.add(key);
      }
      try {
        localStorage.setItem('travellingo_amenity_filters', JSON.stringify(Array.from(ACTIVE_AMENITY_FILTERS)));
      } catch(e) {}
      updateAmenityFilterUI();
      renderPlatformCards();
      
      const count = ACTIVE_AMENITY_FILTERS.size;
      if (count > 0) {
        showDuoToast(`Filtres actifs : ${count} équipement(s) privilégié(s)`, 'info', 1800);
      } else {
        showDuoToast('Filtres d\'équipements réinitialisés', 'info', 1500);
      }
    }

    function clearAmenityFilters() {
      ACTIVE_AMENITY_FILTERS.clear();
      try {
        localStorage.removeItem('travellingo_amenity_filters');
      } catch(e) {}
      updateAmenityFilterUI();
      renderPlatformCards();
      showDuoToast('Tous les filtres d\'équipements ont été effacés', 'info', 1500);
    }

    function updateAmenityFilterUI() {
      const keys = ['breakfast', 'pool', 'ac', 'parking', 'cancel', 'toprated'];
      keys.forEach(k => {
        const btn = document.getElementById(`amenity-${k}`);
        if (btn) {
          if (ACTIVE_AMENITY_FILTERS.has(k)) {
            btn.classList.add('active');
            btn.setAttribute('aria-pressed', 'true');
          } else {
            btn.classList.remove('active');
            btn.setAttribute('aria-pressed', 'false');
          }
        }
      });
      const countBadge = document.getElementById('activeAmenitiesCountBadge');
      if (countBadge) {
        const sz = ACTIVE_AMENITY_FILTERS.size;
        countBadge.textContent = sz > 0 ? `${sz} actif(s)` : '0 actif';
        countBadge.className = sz > 0 
          ? 'text-[10px] font-black px-2 py-0.5 rounded-full bg-indigo-600 text-white shadow-2xs'
          : 'text-[10px] font-bold px-2 py-0.5 rounded-full bg-slate-200 dark:bg-slate-700 text-slate-600 dark:text-slate-300';
      }
    }

    function matchHotelAmenity(item, filterKey) {
      const textCorpus = [
        item.name || '',
        item.type || '',
        item.address || '',
        item.area || '',
        ...(item.perks || [])
      ].join(' ').toLowerCase();

      switch (filterKey) {
        case 'breakfast':
          return textCorpus.includes('petit-déj') || textCorpus.includes('buffet') || textCorpus.includes('déjeuner') || textCorpus.includes('breakfast');
        case 'pool':
          return textCorpus.includes('piscine') || textCorpus.includes('pool') || textCorpus.includes('rooftop') || textCorpus.includes('spa') || textCorpus.includes('bain');
        case 'ac':
          return textCorpus.includes('clim') || textCorpus.includes('air cond') || textCorpus.includes('climatisation');
        case 'parking':
          return textCorpus.includes('parking') || textCorpus.includes('garage') || textCorpus.includes('voiture');
        case 'cancel':
          return textCorpus.includes('annul') || textCorpus.includes('flexible') || textCorpus.includes('rembours');
        case 'toprated':
          const r = parseFloat(item.rating) || 0;
          return r >= 9.0 || (r >= 4.85 && r <= 5.0);
        default:
          return false;
      }
    }

    // =========================================================================
    // SYSTÈME DE WISHLIST / FAVORIS VOYAGEURS & TRACKER DE BAISSES DE PRIX
    // =========================================================================
    let FAVORITES_LIST = [];
    try {
      Object.defineProperty(window, 'FAVORITES_LIST', {
        get: () => FAVORITES_LIST,
        set: (v) => { FAVORITES_LIST = v; },
        configurable: true
      });
    } catch(e) {
      window.FAVORITES_LIST = FAVORITES_LIST;
    }

    // Helper déterministe et stable pour simuler les baisses de prix sur les favoris
    function getHotelPriceDropInfo(name, price) {
      let hash = 0;
      const str = (name || '').toLowerCase().trim();
      for (let i = 0; i < str.length; i++) {
        hash = (hash << 5) - hash + str.charCodeAt(i);
        hash |= 0;
      }
      const isDrop = Math.abs(hash) % 3 !== 0; // ~66% des favoris bénéficient d'une offre en baisse
      if (!isDrop) return { hasDrop: false };

      const dropPercent = 10 + (Math.abs(hash) % 15); // Réduction réaliste entre 10% et 24%
      const currentPrice = Number(price) || 120;
      const oldPrice = Math.round(currentPrice / (1 - dropPercent / 100));
      const savedEur = oldPrice - currentPrice;

      return {
        hasDrop: true,
        dropPercent: dropPercent,
        currentPrice: currentPrice,
        oldPrice: oldPrice,
        savedEur: savedEur
      };
    }

    function checkFavoritesPriceDrops() {
      const hasAnyDrop = FAVORITES_LIST.some(f => getHotelPriceDropInfo(f.name, f.price).hasDrop);
      const dot = document.getElementById('favPriceDropAlertDot');
      const solid = document.getElementById('favPriceDropAlertDotSolid');
      if (dot && solid) {
        if (hasAnyDrop && FAVORITES_LIST.length > 0) {
          dot.classList.remove('hidden');
          solid.classList.remove('hidden');
        } else {
          dot.classList.add('hidden');
          solid.classList.add('hidden');
        }
      }
      return hasAnyDrop;
    }

    function loadFavorites() {
      try {
        const saved = localStorage.getItem('travellingo_favorites');
        if (saved) {
          FAVORITES_LIST = JSON.parse(saved);
        } else {
          FAVORITES_LIST = [];
        }
      } catch (e) {
        console.warn('Erreur loadFavorites:', e);
        FAVORITES_LIST = [];
      }
      updateFavoritesBadge();
    }

    function saveFavorites() {
      try {
        localStorage.setItem('travellingo_favorites', JSON.stringify(FAVORITES_LIST));
      } catch (e) {
        console.warn('Erreur saveFavorites:', e);
      }
      updateFavoritesBadge();
    }

    function updateFavoritesBadge() {
      const badge = document.getElementById('favCountBadge');
      if (badge) {
        badge.textContent = FAVORITES_LIST.length;
        if (FAVORITES_LIST.length > 0) {
          badge.classList.remove('hidden');
        } else {
          badge.classList.add('hidden');
        }
      }
      checkFavoritesPriceDrops();
    }

    function isHotelInFavorites(name) {
      return FAVORITES_LIST.some(f => (f.name || '').toLowerCase().trim() === (name || '').toLowerCase().trim());
    }

    function toggleFavoriteHotel(offerJsonEncoded) {
      try {
        const offer = JSON.parse(decodeURIComponent(offerJsonEncoded));
        const index = FAVORITES_LIST.findIndex(f => (f.name || '').toLowerCase().trim() === (offer.name || '').toLowerCase().trim());
        if (index >= 0) {
          FAVORITES_LIST.splice(index, 1);
          saveFavorites();
          showDuoToast(`${offer.name} retiré des favoris`, 'info', 2000);
        } else {
          FAVORITES_LIST.push({
            name: offer.name,
            type: offer.type,
            dest: offer.dest || (document.getElementById('destInput')?.value || ''),
            address: offer.address,
            price: offer.price,
            rating: offer.rating,
            reviews: offer.reviews,
            distText: offer.distText,
            directUrl: offer.directUrl,
            googleUrl: offer.googleUrl,
            platformShort: offer.platformShort,
            icon: offer.icon || '🏨',
            savedAt: new Date().toISOString()
          });
          saveFavorites();
          const drop = getHotelPriceDropInfo(offer.name, offer.price);
          if (drop.hasDrop) {
            showDuoToast(`❤️ Coup de cœur ajouté ! 📉 Baisse de prix détectée (-${drop.dropPercent}%) !`, 'success', 3500);
          } else {
            showDuoToast(`${offer.name} ajouté à vos coups de cœur ❤️ !`, 'heart', 2500);
          }
        }
        renderPlatformCards();
        if (document.getElementById('favoritesModal') && !document.getElementById('favoritesModal').classList.contains('hidden')) {
          renderFavoritesContent();
        }
      } catch (e) {
        console.warn('Erreur toggleFavoriteHotel:', e);
      }
    }

    function openFavoritesModal() {
      const modal = document.getElementById('favoritesModal');
      if (!modal) return;
      renderFavoritesContent();
      modal.classList.remove('hidden');
    }

    function closeFavoritesModal() {
      const modal = document.getElementById('favoritesModal');
      if (modal) modal.classList.add('hidden');
    }

    function clearAllFavorites() {
      if (FAVORITES_LIST.length === 0) return;
      if (confirm('Voulez-vous vider l\'intégralité de vos favoris ?')) {
        FAVORITES_LIST = [];
        saveFavorites();
        renderFavoritesContent();
        renderPlatformCards();
        showDuoToast('Tous vos favoris ont été effacés', 'info', 1800);
      }
    }

    function renderFavoritesContent() {
      const container = document.getElementById('favoritesListContainer');
      const emptyState = document.getElementById('favoritesEmptyState');
      if (!container) return;

      if (FAVORITES_LIST.length === 0) {
        container.innerHTML = '';
        if (emptyState) emptyState.classList.remove('hidden');
        return;
      }

      if (emptyState) emptyState.classList.add('hidden');

      container.innerHTML = FAVORITES_LIST.map(f => {
        const safeName = escapeHtml(f.name);
        const safeDest = escapeHtml(f.dest);
        const safeAddress = escapeHtml(f.address);
        const safeType = escapeHtml(f.type);
        const safeDist = escapeHtml(f.distText);
        const encName = encodeURIComponent(f.name);
        const directUrlWithAff = applyAffiliateToUrl(f.directUrl, f.platformShort?.toLowerCase() || 'booking');
        const googleUrlWithAff = applyAffiliateToUrl(f.googleUrl, 'googletravel');
        const drop = getHotelPriceDropInfo(f.name, f.price);

        return `
          <div class="bg-white dark:bg-slate-800 border-2 border-slate-200 dark:border-slate-700 rounded-xl p-3.5 shadow-sm hover:border-indigo-400 transition-all flex flex-col justify-between gap-2.5">
            <div class="flex items-start justify-between gap-2">
              <div class="flex items-start gap-2.5 min-w-0 flex-1">
                <span class="text-2xl shrink-0">${f.icon || '🏨'}</span>
                <div class="min-w-0 flex-1">
                  <div class="flex items-center gap-1.5 mb-1 flex-wrap">
                    <span class="text-[9px] font-black uppercase px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-600">${safeType}</span>
                    <span class="bg-indigo-50 dark:bg-indigo-900/40 text-indigo-700 dark:text-indigo-300 border border-indigo-200 dark:border-indigo-700 px-1.5 py-0.5 rounded text-[9px] font-black">📍 ${safeDest}</span>
                  </div>
                  <h4 class="text-sm font-black text-slate-900 dark:text-white leading-snug break-words">${safeName}</h4>
                  <div class="text-[10px] text-slate-500 dark:text-slate-400 font-semibold mt-0.5">${safeAddress}</div>
                </div>
              </div>
              <div class="text-right shrink-0">
                <div class="text-xs font-black text-emerald-700 bg-emerald-50 dark:bg-emerald-950/60 dark:text-emerald-300 px-2 py-0.5 rounded border border-emerald-300 dark:border-emerald-700 whitespace-nowrap">
                  ${formatCurrencyPrice(f.price, true)}/nuit
                </div>
                <div class="text-[10px] text-amber-500 font-black mt-1">★ ${f.rating}</div>
              </div>
            </div>

            <!-- ALERTE VISUELLE DE BAISSE DE PRIX DÉTECTÉE -->
            ${drop.hasDrop ? `
              <div class="flex items-center justify-between gap-1 px-2 py-1 rounded-lg bg-emerald-50 dark:bg-emerald-950/70 border border-emerald-300 dark:border-emerald-600 text-[10px] font-black text-emerald-800 dark:text-emerald-300 animate-pulse">
                <div class="flex items-center gap-1.5">
                  <span>📉</span>
                  <span>Tarif en baisse par rapport à hier (-${drop.dropPercent}%)</span>
                  <span class="line-through text-slate-400 font-normal text-[9px]">${formatCurrencyPrice(drop.oldPrice, true)}</span>
                  <span class="text-emerald-600 dark:text-emerald-400 font-extrabold">➔ ${formatCurrencyPrice(drop.currentPrice, true)}</span>
                </div>
                <span class="bg-emerald-500 text-white text-[9px] px-1.5 py-0.5 rounded-full font-bold">Économie -${formatCurrencyPrice(drop.savedEur, false)}</span>
              </div>
            ` : ''}

            <div class="flex items-center justify-between gap-2 pt-2 border-t border-slate-100 dark:border-slate-700 text-[10px]">
              <span class="text-slate-500 dark:text-slate-400 font-bold">${safeDist}</span>
              <div class="flex items-center gap-1 shrink-0">
                <button onclick="toggleFavoriteHotel(encodeURIComponent('${escapeAttr(JSON.stringify({ name: f.name }))}'))" title="Retirer des favoris" class="btn-3d btn-3d-white text-rose-600 dark:text-rose-400 py-1 px-2 text-xs">
                  🗑️
                </button>
                <a href="${escapeAttr(googleUrlWithAff)}" target="_blank" rel="noopener noreferrer" onclick="trackOutboundClick('googletravel', decodeURIComponent('${encName}'), decodeURIComponent('${encodeURIComponent(f.dest)}'), ${Number(f.price) || 0})" class="btn-3d btn-3d-white py-1 px-2 text-[10px]">
                  🌐 Fiche
                </a>
                <a href="${escapeAttr(directUrlWithAff)}" target="_blank" rel="noopener noreferrer" onclick="trackOutboundClick('${escapeAttr(f.platformShort?.toLowerCase() || 'booking')}', decodeURIComponent('${encName}'), decodeURIComponent('${encodeURIComponent(f.dest)}'), ${Number(f.price) || 0})" class="btn-3d btn-3d-blue py-1 px-2 text-[10px] flex items-center gap-1">
                  <span>Réserver</span><span class="text-[8px]">↗</span>
                </a>
              </div>
            </div>
          </div>
        `;
      }).join('');
    }

    // =========================================================================
    // SYSTÈME DE PARRAINAGE VIRAL (REFERRAL) & BADGES CLUB VIP SMARTTRIP PRO
    // =========================================================================
    let REFERRAL_DATA = {
      myCode: '',
      referredCount: 0,
      myReferrer: null,
      bonusXp: 0,
      vipTier: 1
    };
    try {
      Object.defineProperty(window, 'REFERRAL_DATA', {
        get: () => REFERRAL_DATA,
        set: (v) => { REFERRAL_DATA = v; },
        configurable: true
      });
    } catch(e) {
      window.REFERRAL_DATA = REFERRAL_DATA;
    }

    function getOrCreateReferralCode() {
      let code = localStorage.getItem('smarttrip_my_referral_code') || localStorage.getItem('roamigo_my_referral_code');
      if (!code || !code.startsWith('SMART-')) {
        const rand = Math.floor(1000 + Math.random() * 9000);
        code = `SMART-${rand}`;
        localStorage.setItem('smarttrip_my_referral_code', code);
      }
      return code;
    }

    function loadReferralData() {
      try {
        REFERRAL_DATA.myCode = getOrCreateReferralCode();
        const saved = localStorage.getItem('smarttrip_referral_data') || localStorage.getItem('roamigo_referral_data');
        if (saved) {
          const parsed = JSON.parse(saved);
          REFERRAL_DATA = { ...REFERRAL_DATA, ...parsed, myCode: REFERRAL_DATA.myCode };
        } else {
          REFERRAL_DATA.vipTier = 1;
        }
      } catch (e) {
        console.warn('Erreur loadReferralData:', e);
      }
      updateVipUi();
    }

    function saveReferralData() {
      try {
        localStorage.setItem('smarttrip_referral_data', JSON.stringify(REFERRAL_DATA));
      } catch (e) {
        console.warn('Erreur saveReferralData:', e);
      }
      updateVipUi();
    }

    function updateVipUi() {
      const count = REFERRAL_DATA.referredCount || 0;
      let tier = 1;
      let tierName = "🥉 VIP Explorateur";
      let tierBadgeClass = "bg-purple-600 text-white";
      let progressPct = 20;

      if (count >= 5) {
        tier = 3;
        tierName = "🥇 VIP Élite";
        tierBadgeClass = "bg-amber-500 text-slate-900 border border-amber-300 shadow-sm";
        progressPct = 100;
      } else if (count >= 3) {
        tier = 2;
        tierName = "🥈 VIP Chasseur";
        tierBadgeClass = "bg-indigo-600 text-white";
        progressPct = 65;
      } else {
        tier = 1;
        tierName = "🥉 VIP Explorateur";
        tierBadgeClass = "bg-purple-600 text-white";
        progressPct = Math.max(20, count * 20);
      }
      REFERRAL_DATA.vipTier = tier;

      const vipHeaderBadge = document.getElementById('vipTierBadge');
      if (vipHeaderBadge) {
        vipHeaderBadge.textContent = tierName;
        vipHeaderBadge.className = `${tierBadgeClass} text-[10px] font-black px-1.5 py-0.5 rounded-full`;
      }

      const modalBadge = document.getElementById('modalVipBadge');
      if (modalBadge) {
        modalBadge.textContent = tierName;
        modalBadge.className = `${tierBadgeClass} text-[10px] font-black px-2 py-0.5 rounded-full shadow-2xs`;
      }

      const userDisplay = document.getElementById('userReferralCodeDisplay');
      if (userDisplay) userDisplay.textContent = REFERRAL_DATA.myCode;

      const friendsText = document.getElementById('referralFriendsCount');
      if (friendsText) friendsText.textContent = `${count} ami${count > 1 ? 's' : ''} invité${count > 1 ? 's' : ''}`;

      const bar = document.getElementById('vipProgressBar');
      if (bar) bar.style.width = `${progressPct}%`;

      const t1Status = document.getElementById('tier1Status');
      const t1Box = document.getElementById('tier1Box');
      if (t1Status && t1Box) {
        t1Status.textContent = '✓ Débloqué';
        t1Status.className = 'mt-2 text-[10px] font-black text-emerald-600 dark:text-emerald-400';
      }

      const t2Status = document.getElementById('tier2Status');
      const t2Box = document.getElementById('tier2Box');
      if (t2Status && t2Box) {
        if (count >= 3) {
          t2Status.textContent = '✓ Débloqué';
          t2Status.className = 'mt-2 text-[10px] font-black text-emerald-600 dark:text-emerald-400';
          t2Box.className = 'border-2 rounded-xl p-3 flex flex-col justify-between transition-all bg-indigo-50/50 dark:bg-indigo-950/20 border-indigo-300 dark:border-indigo-700';
        } else {
          t2Status.textContent = `En cours (${count}/3)`;
          t2Status.className = 'mt-2 text-[10px] font-bold text-slate-400';
          t2Box.className = 'border-2 rounded-xl p-3 flex flex-col justify-between transition-all bg-white dark:bg-slate-800 border-slate-200 dark:border-slate-700';
        }
      }

      const t3Status = document.getElementById('tier3Status');
      const t3Box = document.getElementById('tier3Box');
      if (t3Status && t3Box) {
        if (count >= 5) {
          t3Status.textContent = '✓ Débloqué (Max VIP)';
          t3Status.className = 'mt-2 text-[10px] font-black text-amber-600 dark:text-amber-400';
          t3Box.className = 'border-2 rounded-xl p-3 flex flex-col justify-between transition-all bg-amber-50/50 dark:bg-amber-950/20 border-amber-300 dark:border-amber-700';
        } else {
          t3Status.textContent = `Verrouillé (${count}/5)`;
          t3Status.className = 'mt-2 text-[10px] font-bold text-slate-400';
          t3Box.className = 'border-2 rounded-xl p-3 flex flex-col justify-between transition-all bg-white dark:bg-slate-800 border-slate-200 dark:border-slate-700';
        }
      }
    }

    function openReferralModal() {
      const modal = document.getElementById('referralModal');
      if (!modal) return;
      updateVipUi();
      modal.classList.remove('hidden');
    }

    function closeReferralModal() {
      const modal = document.getElementById('referralModal');
      if (modal) modal.classList.add('hidden');
    }

    // =========================================================================
    // MODALE INTERACTIVE : FICHE DÉTAILLÉE DU LOGEMENT
    // =========================================================================
    window.CURRENT_HOTEL_DETAIL = null;

    function openHotelDetailModal(hotelData) {
      let o = hotelData;
      if (typeof o === 'string') {
        try { o = JSON.parse(decodeURIComponent(o)); }
        catch(e) {
          try { o = JSON.parse(o); } catch(err) { return; }
        }
      }
      if (!o || typeof o !== 'object') return;
      window.CURRENT_HOTEL_DETAIL = o;

      const modal = document.getElementById('hotelDetailModal');
      if (!modal) return;

      const iconEl = document.getElementById('hdmIcon');
      if (iconEl) iconEl.innerText = o.icon || '🏨';

      const typeEl = document.getElementById('hdmTypeBadge');
      if (typeEl) typeEl.innerText = o.type || 'Établissement';

      const platEl = document.getElementById('hdmPlatformBadge');
      if (platEl) platEl.innerText = o.platformShort || 'Partenaire';

      const titleEl = document.getElementById('hdmTitle');
      if (titleEl) {
        titleEl.innerText = o.name || 'Hôtel';
        titleEl.title = o.name || '';
      }

      const body = document.getElementById('hotelDetailModalBody');
      if (body) {
        const safeName = escapeHtml(o.name);
        const safeType = escapeHtml(o.type);
        const safeAddress = escapeHtml(o.address || (o.area ? `Quartier ${o.area}, ${o.dest || ''}` : `${o.dest || 'Centre'}`));
        const safeDist = escapeHtml(o.distText || '');
        const mapsQuery = (o.lat && o.lon) ? `${o.lat}%2C${o.lon}` : encodeURIComponent(`${o.name}, ${o.address || o.dest || ''}`);

        const perksList = (o.perks && Array.isArray(o.perks)) ? o.perks : [];
        const perksHtml = perksList.map(p => `<span class="bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-600 px-2.5 py-1 rounded-lg text-xs font-bold flex items-center gap-1">✓ ${escapeHtml(p)}</span>`).join('');

        const safeReviews = (Number(o.reviews) || 2400).toLocaleString('fr-FR');
        const nightsCount = o.nights || 3;
        const guestsCount = o.guests || 2;

        body.innerHTML = `
          <!-- Hero Card & Note -->
          <div class="rounded-2xl p-4 sm:p-5 ${o.gradient || 'bg-blue-50 text-blue-700'} border-2 border-slate-200/80 dark:border-slate-700 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 shadow-xs">
            <div>
              <div class="flex items-center gap-2 mb-1">
                <span class="text-xl font-black">${o.icon || '🏨'}</span>
                <h4 class="text-base sm:text-lg font-black leading-snug">${safeName}</h4>
              </div>
              <p class="text-xs font-bold opacity-90">${safeType} • Certifié conforme aux critères de recherche</p>
            </div>
            <div class="bg-white/90 dark:bg-slate-800/90 rounded-xl px-3 py-2 border border-slate-200 dark:border-slate-600 shrink-0 text-center shadow-2xs">
              <div class="text-amber-500 font-black text-sm">★ ${o.rating || '9.2'}/10</div>
              <div class="text-[10px] font-bold text-slate-500">${safeReviews} avis certifiés</div>
            </div>
          </div>

          <!-- Grille Tarification & Budget -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div class="bg-emerald-50 dark:bg-emerald-950/40 border-2 border-emerald-300 dark:border-emerald-700 rounded-2xl p-3.5 flex flex-col justify-between">
              <span class="text-[10px] font-black uppercase text-emerald-800 dark:text-emerald-300 tracking-wider">Tarif par Nuitée TTC</span>
              <div class="text-xl sm:text-2xl font-black text-emerald-700 dark:text-emerald-400 mt-1">
                ${formatCurrencyPrice(o.price, true)}
              </div>
              <div class="text-[10px] font-bold text-emerald-800 dark:text-emerald-300 mt-1">
                ${o.budgetStatusText || '✓ Conforme à votre budget'}
              </div>
            </div>

            <div class="bg-slate-50 dark:bg-slate-750 border-2 border-slate-200 dark:border-slate-700 rounded-2xl p-3.5 flex flex-col justify-between">
              <span class="text-[10px] font-black uppercase text-slate-500 dark:text-slate-400 tracking-wider">Total Séjour Calculé</span>
              <div class="text-xl sm:text-2xl font-black text-slate-800 dark:text-white mt-1">
                ${formatCurrencyPrice(o.totalPrice || (o.price * nightsCount), false)}
              </div>
              <div class="text-[10px] font-bold text-slate-500 dark:text-slate-400 mt-1">
                Pour <strong>${nightsCount} nuits</strong> (${guestsCount} voyageur${parseInt(guestsCount, 10) > 1 ? 's' : ''})
              </div>
            </div>
          </div>

          ${o.feeBreakdownText ? `
            <div class="bg-blue-50/70 dark:bg-blue-950/30 border border-blue-200 dark:border-blue-800 rounded-xl px-3 py-2 text-xs font-bold text-blue-800 dark:text-blue-300 flex items-center gap-2">
              <span>ℹ️</span> <span>${escapeHtml(o.feeBreakdownText)}</span>
            </div>
          ` : ''}

          <!-- Localisation & Rayon -->
          <div class="bg-white dark:bg-slate-800 border-2 border-slate-200 dark:border-slate-700 rounded-2xl p-4 space-y-2.5 shadow-xs">
            <div class="flex items-center justify-between">
              <span class="text-[10px] font-black uppercase text-slate-400 tracking-wider">Localisation & Proximité</span>
              <a href="https://www.google.com/maps/search/?api=1&query=${mapsQuery}" target="_blank" rel="noopener noreferrer" class="text-xs font-black text-blue-600 hover:text-blue-800 flex items-center gap-1">
                <span>Street View / Maps</span> <span>↗</span>
              </a>
            </div>
            <div class="text-xs sm:text-sm font-bold text-slate-800 dark:text-slate-200">
              📍 ${safeAddress}
            </div>
            ${safeDist ? `
              <div class="text-xs font-black text-purple-700 dark:text-purple-300 bg-purple-50 dark:bg-purple-950/50 px-2.5 py-1 rounded-lg border border-purple-200 dark:border-purple-800 inline-block">
                🎯 ${safeDist}
              </div>
            ` : ''}
          </div>

          <!-- Prestations & Équipements inclus -->
          <div class="bg-white dark:bg-slate-800 border-2 border-slate-200 dark:border-slate-700 rounded-2xl p-4 space-y-2.5 shadow-xs">
            <span class="text-[10px] font-black uppercase text-slate-400 tracking-wider block">Équipements & Prestations Certifiés</span>
            <div class="flex flex-wrap gap-2">
              ${perksHtml || '<span class="text-xs font-bold text-slate-500">Wi-Fi Fibre, Climatisation, Confort garanti</span>'}
            </div>
          </div>
        `;
      }

      // Boutons du footer de la fiche
      const btnDirect = document.getElementById('hdmBtnDirect');
      const directText = document.getElementById('hdmDirectBtnText');
      if (btnDirect && o.directUrl) {
        btnDirect.href = o.directUrl;
        if (directText) directText.innerText = `Voir sur ${o.platformShort || 'le site'}`;
      }
      const btnGoogle = document.getElementById('hdmBtnGoogle');
      if (btnGoogle && o.googleUrl) {
        btnGoogle.href = o.googleUrl;
      }
      const btnFav = document.getElementById('hdmBtnFav');
      if (btnFav) {
        const isFav = typeof isHotelInFavorites === 'function' && isHotelInFavorites(o.name);
        btnFav.innerHTML = `<span>${isFav ? '❤️' : '🤍'}</span> <span>${isFav ? 'Favori' : 'Ajouter Favoris'}</span>`;
        btnFav.onclick = () => {
          if (typeof toggleFavoriteHotel === 'function') {
            toggleFavoriteHotel(encodeURIComponent(JSON.stringify(o)));
            openHotelDetailModal(o);
          }
        };
      }
      const btnDuel = document.getElementById('hdmBtnDuel');
      if (btnDuel) {
        btnDuel.onclick = () => {
          if (typeof injectIntoDuel === 'function') {
            injectIntoDuel(o.name, Number(o.price) || 0, o.platformId || 'booking');
            closeHotelDetailModal();
          }
        };
      }

      modal.classList.remove('hidden');
    }

    function closeHotelDetailModal() {
      const modal = document.getElementById('hotelDetailModal');
      if (modal) modal.classList.add('hidden');
    }

    window.openHotelDetailModal = openHotelDetailModal;
    window.closeHotelDetailModal = closeHotelDetailModal;

    function getReferralShareUrl() {
      const base = window.location.href.split('?')[0].split('#')[0];
      return `${base}?ref=${encodeURIComponent(REFERRAL_DATA.myCode)}`;
    }

    function copyReferralLink() {
      const shareUrl = getReferralShareUrl();
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(shareUrl).then(() => {
          showDuoToast("Lien de parrainage copié dans le presse-papier ! 🎁", "success", 2500);
        }).catch(() => {
          prompt("Copiez votre lien de parrainage :", shareUrl);
        });
      } else {
        prompt("Copiez votre lien de parrainage :", shareUrl);
      }
    }

    function shareReferralWhatsApp() {
      const shareUrl = getReferralShareUrl();
      const text = `✈️ Découvre SmartTrip Pro, le comparateur hôtelier 1-clic ultime ! En utilisant mon code ami (${REFERRAL_DATA.myCode}), on débloque tous les deux le statut VIP et l'accès aux alertes baisses de prix :\n${shareUrl}`;
      const url = `https://api.whatsapp.com/send?text=${encodeURIComponent(text)}`;
      window.open(url, '_blank');
    }

    function submitManualReferralCode() {
      const input = document.getElementById('manualReferralInput');
      const feedback = document.getElementById('manualReferralFeedback');
      if (!input) return;
      const code = input.value.trim().toUpperCase();

      if (!code) {
        if (feedback) feedback.textContent = "Veuillez saisir un code ami valide.";
        return;
      }
      if (code === REFERRAL_DATA.myCode) {
        if (feedback) feedback.textContent = "Vous ne pouvez pas utiliser votre propre code ami !";
        showDuoToast("Vous ne pouvez pas vous parrainer vous-même !", "warning", 2500);
        return;
      }
      if (REFERRAL_DATA.myReferrer) {
        if (feedback) feedback.textContent = `Vous avez déjà utilisé le code ${REFERRAL_DATA.myReferrer}.`;
        showDuoToast(`Code déjà enregistré avec ${REFERRAL_DATA.myReferrer}`, "info", 2000);
        return;
      }

      REFERRAL_DATA.myReferrer = code;
      REFERRAL_DATA.bonusXp += 150;
      saveReferralData();

      const gemCounter = document.getElementById('gemCounter');
      if (gemCounter) {
        gemCounter.textContent = `1 800 XP`;
      }

      if (feedback) {
        feedback.className = "text-[10px] font-black text-emerald-600 dark:text-emerald-400 mt-1";
        feedback.textContent = `✓ Code ${code} validé avec succès ! +150 XP de bienvenue crédités.`;
      }
      showDuoToast(`Félicitations ! Code ${code} validé, bienvenue dans le Club VIP 🎉`, "success", 3000);
      input.disabled = true;
    }

    function applyReferralCodeFromUrl() {
      try {
        const params = new URLSearchParams(window.location.search);
        const refCode = params.get('ref');
        if (refCode) {
          const cleanCode = refCode.trim().toUpperCase();
          if (cleanCode && cleanCode !== REFERRAL_DATA.myCode && !REFERRAL_DATA.myReferrer) {
            REFERRAL_DATA.myReferrer = cleanCode;
            REFERRAL_DATA.bonusXp += 150;
            saveReferralData();
            showDuoToast(`Bienvenue grâce au parrainage de ${cleanCode} ! Statut VIP activé 🎁`, "success", 4000);
          }
        }
      } catch (e) {
        console.warn('Erreur applyReferralCodeFromUrl:', e);
      }
    }

    // =========================================================================
    // TABLEAU DE BORD PARTENAIRE & ADMINISTRATION DES CLÉS D'AFFILIATION
    // =========================================================================
    function openAffiliateAdminModal() {
      const modal = document.getElementById('affiliateAdminModal');
      if (!modal) return;

      const toggle = document.getElementById('affEnabledToggle');
      if (toggle) toggle.checked = !!AFFILIATE_CONFIG.enabled;

      const utmToggle = document.getElementById('affGoogleUtm');
      if (utmToggle) utmToggle.checked = !!AFFILIATE_CONFIG.googleUtmSource;

      if (document.getElementById('affBookingAid')) document.getElementById('affBookingAid').value = AFFILIATE_CONFIG.bookingAid || '';
      if (document.getElementById('affBookingLabel')) document.getElementById('affBookingLabel').value = AFFILIATE_CONFIG.bookingLabel || '';
      if (document.getElementById('affAgodaCid')) document.getElementById('affAgodaCid').value = AFFILIATE_CONFIG.agodaCid || '';
      if (document.getElementById('affExpediaCamref')) document.getElementById('affExpediaCamref').value = AFFILIATE_CONFIG.expediaCamref || '';
      if (document.getElementById('affAirbnbRef')) document.getElementById('affAirbnbRef').value = AFFILIATE_CONFIG.airbnbRef || '';
      if (document.getElementById('affGoogleUtmSource')) document.getElementById('affGoogleUtmSource').value = AFFILIATE_CONFIG.googleUtmSource || '';

      updateAffiliateMetricsView();
      modal.classList.remove('hidden');
    }

    function closeAffiliateAdminModal() {
      const modal = document.getElementById('affiliateAdminModal');
      if (modal) modal.classList.add('hidden');
    }

    function updateAffiliateMetricsView() {
      const rawClicks = localStorage.getItem('travellingo_analytics_clicks');
      let clicks = [];
      if (rawClicks) {
        try { clicks = JSON.parse(rawClicks); } catch(e) { clicks = []; }
      }

      const totalClicks = clicks.length;
      let totalEstCom = 0;
      const platformCounts = {};
      const destCounts = {};

      clicks.forEach(c => {
        totalEstCom += (c.estimatedCommission || 0);
        platformCounts[c.platform] = (platformCounts[c.platform] || 0) + 1;
        destCounts[c.destination] = (destCounts[c.destination] || 0) + 1;
      });

      let topPlat = 'En attente';
      let topPlatClicks = 0;
      Object.entries(platformCounts).forEach(([p, count]) => {
        if (count > topPlatClicks) {
          topPlatClicks = count;
          topPlat = p;
        }
      });

      let topDest = 'En attente';
      let topDestClicks = 0;
      Object.entries(destCounts).forEach(([d, count]) => {
        if (count > topDestClicks) {
          topDestClicks = count;
          topDest = d;
        }
      });

      ['adminTotalClicks', 'affTotalClicksMetric'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.textContent = totalClicks.toString();
      });

      ['adminEstRevenue', 'affTotalComMetric'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.textContent = `${totalEstCom.toFixed(2)} €`;
      });

      const elTopPlat = document.getElementById('adminTopPlatform');
      if (elTopPlat) elTopPlat.textContent = topPlat.toUpperCase();
      const elTopPlatClicks = document.getElementById('adminTopPlatformClicks');
      if (elTopPlatClicks) elTopPlatClicks.textContent = `${topPlatClicks} clic${topPlatClicks > 1 ? 's' : ''}`;

      const elTopDest = document.getElementById('adminTopDest');
      if (elTopDest) elTopDest.textContent = topDest;
      const elTopDestClicks = document.getElementById('adminTopDestClicks');
      if (elTopDestClicks) elTopDestClicks.textContent = `${topDestClicks} clic${topDestClicks > 1 ? 's' : ''}`;

      ['adminClicksTableBody', 'affClicksTableBody'].forEach(tId => {
        const tableBody = document.getElementById(tId);
        if (tableBody) {
          if (clicks.length === 0) {
            tableBody.innerHTML = `<tr><td colspan="5" class="py-4 text-center text-slate-400 font-semibold text-xs">Aucun clic sortant enregistré pour l'instant. Testez les liens de réservation pour observer les clics en direct !</td></tr>`;
          } else {
            tableBody.innerHTML = clicks.slice(0, 15).map(c => {
              const dateStr = new Date(c.timestamp).toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
              return `
                <tr class="border-b border-slate-100 dark:border-slate-700/60 hover:bg-slate-50 dark:hover:bg-slate-700/30 transition-colors">
                  <td class="py-1.5 px-3 text-[10px] font-bold text-slate-500">${dateStr}</td>
                  <td class="py-1.5 px-3 text-[10px] font-black uppercase text-indigo-700 dark:text-indigo-400">${escapeHtml(c.platform)}</td>
                  <td class="py-1.5 px-3 text-[10px] font-bold text-slate-800 dark:text-slate-200 truncate max-w-[140px]" title="${escapeAttr(c.hotelName)}">${escapeHtml(c.hotelName)}</td>
                  <td class="py-1.5 px-3 text-[10px] font-semibold text-slate-600 dark:text-slate-400">${escapeHtml(c.destination)}</td>
                  <td class="py-1.5 px-3 text-[10px] font-black text-right text-emerald-600 dark:text-emerald-400">+${(c.estimatedCommission || 0).toFixed(2)} €</td>
                </tr>
              `;
            }).join('');
          }
        }
      });
    }

    function saveAffiliateAdminForm(event) {
      if (event) event.preventDefault();
      const utmChecked = document.getElementById('affGoogleUtm')?.checked ?? true;
      const updated = {
        enabled: document.getElementById('affEnabledToggle')?.checked ?? true,
        bookingAid: (document.getElementById('affBookingAid')?.value || '').trim(),
        bookingLabel: (document.getElementById('affBookingLabel')?.value || '').trim(),
        agodaCid: (document.getElementById('affAgodaCid')?.value || '').trim(),
        expediaCamref: (document.getElementById('affExpediaCamref')?.value || '').trim(),
        airbnbRef: (document.getElementById('affAirbnbRef')?.value || '').trim(),
        googleUtmSource: utmChecked ? ((document.getElementById('affGoogleUtmSource')?.value || 'travellingo').trim() || 'travellingo') : ''
      };

      saveAffiliateConfig(updated);
      renderPlatformCards();
      showDuoToast('Paramètres d\'affiliation enregistrés avec succès !', 'success', 2500);
      closeAffiliateAdminModal();
    }

    function exportAnalyticsJson() {
      try {
        const rawClicks = localStorage.getItem('travellingo_analytics_clicks') || '[]';
        const blob = new Blob([rawClicks], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `travellingo_affiliate_analytics_${new Date().toISOString().slice(0, 10)}.json`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
        showDuoToast('Rapport analytics exporté au format JSON !', 'success', 2000);
      } catch(e) {
        showDuoToast('Erreur lors de l\'export JSON', 'error', 2000);
      }
    }

    function resetAnalyticsData() {
      if (confirm('Voulez-vous vraiment réinitialiser l\'historique des clics sortants ?')) {
        localStorage.removeItem('travellingo_analytics_clicks');
        updateAffiliateMetricsView();
        showDuoToast('Historique des clics réinitialisé', 'info', 1800);
      }
    }

    window.addEventListener('keydown', (e) => {
      if (e.altKey && (e.key === 'a' || e.key === 'A')) {
        e.preventDefault();
        openAffiliateAdminModal();
      }
    });

    // Helper réseau résilient avec timeout automatique par AbortController
    async function fetchWithTimeout(resource, options = {}, timeoutMs = 4500) {
      const controller = new AbortController();
      const id = setTimeout(() => controller.abort(), timeoutMs);
      try {
        const response = await fetch(resource, {
          ...options,
          signal: controller.signal
        });
        clearTimeout(id);
        return response;
      } catch (error) {
        clearTimeout(id);
        throw error;
      }
    }

    // Calcul géodésique Haversine piéton urbain de secours (1.25x sinuosité, 4.8 km/h)
    function computeHaversineWalking(lat1, lon1, lat2, lon2) {
      const R = 6371; // Rayon moyen terrestre en km
      const dLat = (lat2 - lat1) * Math.PI / 180;
      const dLon = (lon2 - lon1) * Math.PI / 180;
      const a = Math.sin(dLat/2) * Math.sin(dLat/2) +
                Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
                Math.sin(dLon/2) * Math.sin(dLon/2);
      const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
      const rawDistKm = R * c;
      const walkingDistKm = Math.max(0.1, parseFloat((rawDistKm * 1.25).toFixed(2)));
      const walkingMin = Math.max(2, Math.round((walkingDistKm / 4.8) * 60));
      return { distKm: walkingDistKm, durationMin: walkingMin };
    }

    // Helper pour composer l'emplacement cible avec le point de repère
    function getEffectiveLocation(dest, landmark) {
      dest = (dest || 'Rome').trim();
      landmark = (landmark || '').trim();
      if (!landmark) return dest;
      const lmLow = landmark.toLowerCase();
      if (['centre', 'centre-ville', 'centre ville', 'centre historique', 'centre-ville historique', 'tout', 'partout'].includes(lmLow)) {
        return dest;
      }
      if (lmLow.includes(dest.toLowerCase())) return landmark;
      return `${landmark}, ${dest}`;
    }

