            <input type="text" id="manualReferralInput" placeholder="Ex: SMART-1234" class="flex-1 px-3 py-2 bg-white dark:bg-slate-900 border-2 border-slate-200 dark:border-slate-700 rounded-xl text-xs font-mono font-bold uppercase">
