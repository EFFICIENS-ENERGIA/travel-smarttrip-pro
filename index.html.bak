            <button type="button" onclick="saveAffiliateAdminForm()" class="btn-3d btn-3d-green text-xs py-2 px-4 cursor-pointer">
              💾 Enregistrer la Configuration
            </button>
            <div class="flex items-center gap-2">
              <button type="button" onclick="exportAnalyticsJson()" class="btn-3d btn-3d-white text-xs py-1.5 px-3 cursor-pointer">
                📥 Exporter JSON
