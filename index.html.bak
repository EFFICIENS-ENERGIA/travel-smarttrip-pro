          { name: `Old Town Lodge & Hostel ${dest}`, type: "Concept Pods", icon: "🛌", gradient: "bg-orange-50 text-orange-600", perks: ["Pods insonorisés", "Wi-Fi 1Gbps", "Clim"] },
