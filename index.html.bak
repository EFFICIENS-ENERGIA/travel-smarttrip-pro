          { name: `Auberge Urbaine ${dest} Dortoirs Confort`, type: "Hostel Moderne", icon: "⛺", gradient: "bg-teal-50 text-teal-600", perks: ["Casiers individuels", "Cuisine commune", "Clim"] },
          { name: `Boutique Hostel ${dest} Cœur Vibrant`, type: "Boutique Hostel", icon: "🌟", gradient: "bg-indigo-50 text-indigo-600", perks: ["Ambiance conviviale", "Wi-Fi", "Centre"] }
        ]
      };

      const platTemplates = TEMPLATES[platformId] || TEMPLATES.booking;
      const deals = [];

      // Profils de positionnement tarifaire naturel par comparateur
      const PLAT_PROFILES = {
        hostelworld:  { baseRatio: 0.10, stepRatio: 0.18, salt: 1 },  // Auberges de jeunesse & lits éco
        agoda:        { baseRatio: 0.18, stepRatio: 0.20, salt: 6 },  // Deals flash discount Asie & Monde
        kayak:        { baseRatio: 0.23, stepRatio: 0.21, salt: 2 },  // Smart deals & comparateur
        booking:      { baseRatio: 0.28, stepRatio: 0.22, salt: 5 },  // Genius hôtel 3★ standard
        googletravel: { baseRatio: 0.32, stepRatio: 0.21, salt: 8 },  // Référence marché & Google Hotels
        expedia:      { baseRatio: 0.36, stepRatio: 0.20, salt: 4 },  // Pack vol + hôtel & confort
        hotelscom:    { baseRatio: 0.40, stepRatio: 0.19, salt: 9 },  // Programme fidélité One Key VIP
        tripadvisor:  { baseRatio: 0.44, stepRatio: 0.18, salt: 3 },  // Coup de cœur voyageurs & B&B
        airbnb:       { baseRatio: 0.48, stepRatio: 0.17, salt: 7 },  // Appartements & lofts (+ frais ménage)
        abritel:      { baseRatio: 0.52, stepRatio: 0.16, salt: 11 }  // Maisons & grandes villas familiales
      };
      const prof = PLAT_PROFILES[platformId] || { baseRatio: 0.30, stepRatio: 0.20, salt: 5 };
      const destSalt = (dest || '').split('').reduce((acc, c) => acc + c.charCodeAt(0), 0) % 7;

      for (let i = 0; i < needed; i++) {
        const slot = (existingCount + i) % platTemplates.length;
        const tpl = platTemplates[slot];

        // 1. Calcul strict, diversifié et réaliste du tarif de nuitée (pNight) : TOUJOURS dans [minPrice, maxPrice]
        let pNight = 80;
        if (minPrice > 0 && maxPrice < 1000) {
          const spread = Math.max(1, maxPrice - minPrice);
          const targetRatio = Math.min(0.96, Math.max(0.04, prof.baseRatio + (i * prof.stepRatio)));
          const offset = ((destSalt + prof.salt * 2 + i * 5) % 9) - 4;
          pNight = Math.round(minPrice + (spread * targetRatio)) + offset;
          pNight = Math.max(minPrice, Math.min(maxPrice, pNight));
        } else if (maxPrice < 1000) {
          const effMin = Math.max(25, Math.round(maxPrice * 0.22));
          const spread = maxPrice - effMin;
          const targetRatio = Math.min(0.96, Math.max(0.04, prof.baseRatio + (i * prof.stepRatio)));
          const offset = ((destSalt + prof.salt * 2 + i * 5) % 9) - 4;
          pNight = Math.round(effMin + (spread * targetRatio)) + offset;
          pNight = Math.max(20, Math.min(maxPrice, pNight));
        } else if (minPrice > 0) {
          const step = Math.max(15, Math.round(minPrice * 0.16));
          pNight = minPrice + prof.salt + (i * step);
        } else {
          const baseDefaults = { hostelworld: 34, agoda: 65, kayak: 72, booking: 85, googletravel: 92, expedia: 98, hotelscom: 104, tripadvisor: 112, airbnb: 118, abritel: 135 };
          pNight = (baseDefaults[platformId] || 85) + (i * 24);
        }

        // 2. Calcul strict de la distance : TOUJOURS <= dist si dist > 0
        let curDistKm = 0.5;
        if (dist > 0) {
          const dRatio = (needed === 1) ? 0.50 : (0.25 + (i / Math.max(1, needed - 1)) * 0.60);
          curDistKm = Math.round((Math.min(dist * dRatio, Math.max(0.2, dist - 0.1))) * 10) / 10;
          if (curDistKm >= dist) {
            curDistKm = Math.max(0.1, Math.round((dist * 0.8) * 10) / 10);
          }
        } else {
          curDistKm = Math.round((0.3 + i * 0.3) * 10) / 10;
        }

        // 3. Coordonnées géographiques cohérentes
        let itemLat = 48.8566, itemLon = 2.3522;
        if (lmCoords && lmCoords.lat && lmCoords.lon) {
          const theta = ((slot * 80) + 25) * (Math.PI / 180);
          const dDeg = curDistKm / 111.0;
          itemLat = Math.round((lmCoords.lat + dDeg * Math.cos(theta)) * 10000) / 10000;
          itemLon = Math.round((lmCoords.lon + (dDeg / Math.max(0.2, Math.cos(lmCoords.lat * Math.PI / 180))) * Math.sin(theta)) * 10000) / 10000;
        }

        const address = effectiveLandmarkLabel ? `${effectiveLandmarkLabel}, ${dest}` : `Centre-ville, ${dest}`;
        const rating = (9.0 + (slot * 0.15)).toFixed(1);
        const reviews = 1500 + slot * 480;

        const prestationScore = 82 + slot * 3;
        const valueRatio = ((prestationScore + 20) * 100) / Math.max(35, pNight);
        const valueScore = Math.min(99, Math.max(85, Math.round(55 + (valueRatio / 3))));
        // Score Pallier 1B (14000) : toujours en dessous des vrais hôtels réels conformes (qui sont à 20000+)
        const score = 14000 + valueRatio - (i * 20);

        deals.push({
          item: {
            name: tpl.name,
            cleanQuery: tpl.name,
            type: tpl.type,
            dest: dest,
            address: address,
            lat: itemLat,
            lon: itemLon,
            price: pNight,
            basePrice: Math.round(pNight / sMult),
            rating: rating,
            reviews: reviews,
            perks: tpl.perks,
            icon: tpl.icon,
            gradient: tpl.gradient,
            realDistKm: curDistKm,
            isCalibratedDeal: true
          },
          pNight: pNight,
          curDistKm: curDistKm,
          feesPerNight: 0,
          feeBreakdownText: "✓ Conforme au budget • TVA & frais inclus",
          inBudget: true,
          budgetDiff: 0,
          valueRatio: valueRatio,
          valueScore: valueScore,
          prestationScore: prestationScore,
          score: score,
          isWithinDist: true
        });
      }

      return deals;
    }

    // =========================================================================
    // BASE DE DONNÉES CURÉE D'ÉTABLISSEMENTS PHYSIQUES RÉELS & TARIFS CONSTATÉS
    // (19 MÉTROPOLES MONDIALES)
    // =========================================================================
    function getPlatformTop4Listings(platformId, dest, ci, co, g, minPrice, maxPrice, landmark, dist) {
      let nights = 3;
      try {
        if (ci && co) {
          const diff = (new Date(co) - new Date(ci)) / (1000 * 60 * 60 * 24);
          if (diff > 0) nights = Math.round(diff);
        }
      } catch(e) {}

      const pMin = (minPrice && minPrice > 0) ? minPrice : 40;
      const pMax = (maxPrice && maxPrice < 1000 && maxPrice > pMin) ? maxPrice : (pMin + 140);

      const maxKm = (dist && dist > 0) ? dist : 4.0;
      const targetPlace = landmark ? landmark : 'Centre';

      const rawDest = (dest || '').replace(/Ã©/g, 'e').replace(/Ã¨/g, 'e').replace(/Ã/g, 'a').replace(/©/g, 'e');
      const dLower = rawDest.toLowerCase().trim();
      const dNorm = (dLower || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();
      let cityKey = 'general';
      if (dNorm.includes('nice') || dNorm.includes('cote d\'azur')) cityKey = 'nice';
      else if (dNorm.includes('rome') || dNorm.includes('roma') || dNorm.includes('italie') || dNorm.includes('italy')) cityKey = 'rome';
      else if (dNorm.includes('paris') || dNorm.includes('france')) cityKey = 'paris';
      else if (dNorm.includes('lyon')) cityKey = 'lyon';
      else if (dNorm.includes('marseille')) cityKey = 'marseille';
      else if (dNorm.includes('bordeaux')) cityKey = 'bordeaux';
      else if (dNorm.includes('madrid') || dNorm.includes('espagne') || dNorm.includes('spain')) cityKey = 'madrid';
      else if (dNorm.includes('barcelon') || dNorm.includes('barcelona') || dNorm.includes('cataluna')) cityKey = 'barcelone';
      else if (dNorm.includes('londres') || dNorm.includes('london') || dNorm.includes('angleterre') || dNorm.includes('uk') || dNorm.includes('england')) cityKey = 'londres';
      else if (dNorm.includes('tokyo') || dNorm.includes('japon') || dNorm.includes('japan') || dNorm.includes('kyoto') || dNorm.includes('osaka')) cityKey = 'tokyo';
      else if (dNorm.includes('new york') || dNorm.includes('nyc') || dNorm.includes('usa') || dNorm.includes('etats-unis')) cityKey = 'newyork';
      else if (dNorm.includes('sevil') || dNorm.includes('sa©vil') || dNorm.includes('s©vil') || dLower.includes('sévil') || dNorm.includes('sevill') || (dest && (dest.toLowerCase().includes('vil') || dest.toLowerCase().includes('sev')))) cityKey = 'seville';
      else if (dNorm.includes('lisbon') || dNorm.includes('lisboa') || dNorm.includes('portugal')) cityKey = 'lisbonne';
      else if (dNorm.includes('berlin') || dNorm.includes('allemagne') || dNorm.includes('germany')) cityKey = 'berlin';
      else if (dNorm.includes('montreal') || dNorm.includes('canada') || dNorm.includes('quebec')) cityKey = 'montreal';
      else if (dNorm.includes('bruxelle') || dNorm.includes('brussel') || dNorm.includes('belgique') || dNorm.includes('belgium')) cityKey = 'bruxelles';
      else if (dNorm.includes('marrakech') || dNorm.includes('marrakesh') || dNorm.includes('maroc') || dNorm.includes('morocco')) cityKey = 'marrakech';
      else if (dNorm.includes('venis') || dNorm.includes('venezia')) cityKey = 'venise';
      else if (dNorm.includes('amsterdam') || dNorm.includes('pays-bas') || dNorm.includes('netherlands') || dNorm.includes('hollande')) cityKey = 'amsterdam';

      const CURATED = {
        nice: {
          googletravel: [
            { name: "Hôtel Le Negresco", cleanQuery: "Hotel Le Negresco Nice", address: "37 Promenade des Anglais, 06000 Nice", lat: 43.6950, lon: 7.2570, type: "Palace Mythique 5★", basePrice: 420, rating: "9.4", reviews: 3800, dFrac: 0.15, perks: ["Promenade des Anglais", "Collection d'Art", "Clim"], icon: "👑", gradient: "bg-blue-50 text-blue-600" },
