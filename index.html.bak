  <!-- MODAL : FICHE DÉTAILLÉE DU LOGEMENT (INTERACTIVE & CERTIFIÉE) -->
  <div id="hotelDetailModal" class="hidden fixed inset-0 z-50 bg-slate-900/70 backdrop-blur-xs flex items-center justify-center p-3 md:p-6 overflow-y-auto" onclick="if(event.target===this)closeHotelDetailModal()" role="dialog" aria-modal="true" aria-labelledby="hdmTitle">
    <div class="bg-white dark:bg-slate-800 rounded-3xl max-w-2xl w-full max-h-[92vh] overflow-hidden shadow-2xl flex flex-col border-2 border-slate-200 dark:border-slate-700 transition-all">
      
      <!-- En-tête de la fiche -->
