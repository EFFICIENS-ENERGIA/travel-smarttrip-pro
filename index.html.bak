      else if (cityKey === 'barcelone') cityTaxPerPerson = 5.50;
      else if (cityKey === 'nice') cityTaxPerPerson = 2.50;
      else if (cityKey === 'lyon' || cityKey === 'bordeaux' || cityKey === 'marseille') cityTaxPerPerson = 2.00;
      else if (cityKey === 'madrid') cityTaxPerPerson = 0; // Madrid n'applique pas de taxe de séjour municipale
      else if (cityKey === 'londres') cityTaxPerPerson = 0;
      else if (cityKey === 'tokyo') cityTaxPerPerson = 1.20;
      else if (cityKey === 'newyork') cityTaxPerPerson = 4.50;
      else if (cityKey === 'seville') cityTaxPerPerson = 0; // Andalousie : exonéré
      else if (cityKey === 'lisbonne') cityTaxPerPerson = 2.00;
      else if (cityKey === 'berlin') cityTaxPerPerson = 2.50;
      else if (cityKey === 'montreal') cityTaxPerPerson = 3.00;
