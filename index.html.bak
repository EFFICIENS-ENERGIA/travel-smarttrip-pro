          ],
          hotelscom: [
            { name: "Hyatt Regency Palais Méditerranée", cleanQuery: "Hyatt Regency Nice Palais de la Mediterranee", address: "13 Promenade des Anglais, 06000 Nice", lat: 43.6958, lon: 7.2625, type: "Palace 5★ One Key", basePrice: 340, rating: "9.3", reviews: 2100, dFrac: 0.20, perks: ["Piscine face mer", "One Key VIP", "Clim"], icon: "🎁", gradient: "bg-red-50 text-red-600" },
