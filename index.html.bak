      // 1. Récupération stricte et exclusive des propositions de CETTE plateforme
      let platformItems = [];
      if (window.verifiedAccommodationsCache[dLower] && window.verifiedAccommodationsCache[dLower].platforms) {
        const livePlats = window.verifiedAccommodationsCache[dLower].platforms;
        if (livePlats[platformId] && Array.isArray(livePlats[platformId]) && livePlats[platformId].length > 0) {
          platformItems = livePlats[platformId];
        }
      }
      if (platformItems.length === 0 && CURATED[cityKey] && CURATED[cityKey][platformId]) {
        platformItems = CURATED[cityKey][platformId];
      }
