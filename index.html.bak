                  <th class="py-2 px-3">Date / Heure</th>
                  <th class="py-2 px-3">Plateforme</th>
                  <th class="py-2 px-3">Établissement</th>
                  <th class="py-2 px-3">Destination</th>
                  <th class="py-2 px-3 text-right">Tarif</th>
                </tr>
              </thead>
