<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SmartTrip Pro • Comparateur d'Hébergements 1-Clic, Parrainage VIP &amp; Alertes Baisses de Prix</title>
  
  <!-- PWA & Mobile Web App Meta -->
  <link rel="manifest" href="manifest.webmanifest">
  <meta name="theme-color" content="#58cc02">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="SmartTrip Pro">
  <link rel="icon" type="image/svg+xml" href="icon-192.svg">
  <link rel="apple-touch-icon" href="icon-192.svg">

  <!-- Google Fonts : Nunito Rounded -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@600;700;800;900&display=swap" rel="stylesheet">
  
  <!-- Tailwind CSS -->
  <script src="https://www.gstatic.com/antigravity/web/dev/tailwindcss.min.js"></script>
  
  <style>
    :root {
      --duo-green: #58cc02;
      --duo-green-shadow: #46a302;
      --duo-green-tint: #d7ffb8;
      --duo-blue: #1cb0f6;
      --duo-blue-shadow: #1899d6;
      --duo-blue-tint: #ddf4fe;
      --duo-yellow: #ffc800;
      --duo-yellow-shadow: #e5a100;
      --duo-yellow-tint: #fff5d6;
      --duo-orange: #ff9600;
      --duo-orange-shadow: #e07700;
      --duo-orange-tint: #ffe8cc;
      --duo-red: #ff4b4b;
      --duo-red-shadow: #ea2b2b;
      --duo-purple: #ce82ff;
      --duo-purple-shadow: #a559d9;
      --duo-gray: #e5e5e5;
      --duo-charcoal: #4b4b4b;
    }

    body {
      font-family: 'Nunito', system-ui, -apple-system, sans-serif;
      background-color: #f7f7f7;
      color: var(--duo-charcoal);
      -webkit-font-smoothing: antialiased;
    }

    /* Style des boutons 3D Duolingo */
    .btn-3d {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      border-radius: 16px;
      cursor: pointer;
      user-select: none;
      transition: transform 0.08s ease, box-shadow 0.08s ease, filter 0.08s ease;
      border: none;
      outline: none;
    }
    .btn-3d:hover { filter: brightness(1.05); }
    .btn-3d:active {
      transform: translateY(4px);
      box-shadow: 0 0 0 transparent !important;
    }

    .btn-3d-green { background-color: var(--duo-green); color: #ffffff; box-shadow: 0 4px 0 var(--duo-green-shadow); }
    .btn-3d-blue { background-color: var(--duo-blue); color: #ffffff; box-shadow: 0 4px 0 var(--duo-blue-shadow); }
    .btn-3d-yellow { background-color: var(--duo-yellow); color: #ffffff; box-shadow: 0 4px 0 var(--duo-yellow-shadow); }
    .btn-3d-orange { background-color: var(--duo-orange); color: #ffffff; box-shadow: 0 4px 0 var(--duo-orange-shadow); }
    .btn-3d-purple { background-color: var(--duo-purple); color: #ffffff; box-shadow: 0 4px 0 var(--duo-purple-shadow); }
    .btn-3d-white {
      background-color: #ffffff;
      color: var(--duo-charcoal);
      border: 2px solid var(--duo-gray);
      box-shadow: 0 3px 0 var(--duo-gray);
    }
    .btn-3d-white:hover { background-color: #fdfdfd; border-color: #d1d5db; }
    .btn-3d-white:active { transform: translateY(3px); box-shadow: 0 0 0 transparent !important; }

    /* Cartes épaisses Duolingo */
    .card-duo {
      background-color: #ffffff;
      border: 2px solid var(--duo-gray);
      border-bottom: 5px solid #dcdcdc;
      border-radius: 20px;
      transition: all 0.15s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .card-duo-interactive:hover {
      border-color: #84d8ff;
      border-bottom-color: var(--duo-blue);
      transform: translateY(-2px);
      box-shadow: 0 10px 20px -5px rgba(28, 176, 246, 0.12);
    }

    /* Barre de progression */
    .progress-pill {
      background-color: #e5e5e5;
      border-radius: 9999px;
      overflow: hidden;
      position: relative;
    }
    .progress-pill-bar {
      background-color: var(--duo-green);
      height: 100%;
      border-radius: 9999px;
      transition: width 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
      position: relative;
    }
    .progress-pill-bar::after {
      content: '';
      position: absolute;
      top: 3px;
      left: 6px;
      right: 6px;
      height: 35%;
      background: rgba(255, 255, 255, 0.4);
      border-radius: 9999px;
    }

    .tab-btn {
      transition: all 0.1s ease;
      white-space: nowrap;
    }
    .tab-btn.active {
      background-color: var(--duo-blue-tint);
      color: var(--duo-blue);
      border-color: var(--duo-blue);
      box-shadow: 0 3px 0 var(--duo-blue-shadow);
      font-weight: 900;
    }

    @keyframes duoWiggle {
      0%, 100% { transform: rotate(0deg); }
      25% { transform: rotate(-6deg); }
      75% { transform: rotate(6deg); }
    }
    .mascot-wiggle:hover { animation: duoWiggle 0.5s ease-in-out infinite; }

    input[type="range"] {
      accent-color: var(--duo-blue);
    }

    /* ========================================================================= */
    /* 📄 STYLES IMPRESSION & EXPORTATION PDF A4 PRO                             */
    /* ========================================================================= */
    @media print {
      body * {
        visibility: hidden !important;
      }
      #tripSummaryModal, #tripSummaryModal * {
        visibility: visible !important;
      }
      #tripSummaryModal {
        position: absolute !important;
        left: 0 !important;
        top: 0 !important;
        width: 100% !important;
        min-height: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
        background: #ffffff !important;
        display: block !important;
        box-shadow: none !important;
        border: none !important;
        z-index: 999999 !important;
      }
      #tripSummaryModal > div {
        max-width: 100% !important;
        max-height: none !important;
        border: none !important;
        box-shadow: none !important;
        border-radius: 0 !important;
      }
      .no-print {
        display: none !important;
      }
      .print-table {
        width: 100% !important;
        border-collapse: collapse !important;
      }
      .print-table th, .print-table td {
        border: 1px solid #cbd5e1 !important;
        padding: 8px 12px !important;
      }
      @page {
        margin: 1.2cm;
        size: A4 portrait;
      }
    }

    /* ========================================================================= */
    /* 🌙 DARK MODE GAMIFIÉ (« NIGHT FLIGHT » DUOLINGO)                         */
    /* ========================================================================= */
    html.dark {
      background-color: #0b1329 !important;
      color: #f1f5f9 !important;
    }
    html.dark body {
      background-color: #0b1329 !important;
      color: #f1f5f9 !important;
    }
    html.dark header,
    html.dark .card-duo {
      background-color: #131f37 !important;
      border-color: #273859 !important;
      border-bottom-color: #1a2844 !important;
      color: #f8fafc !important;
    }
    html.dark .bg-white {
      background-color: #131f37 !important;
      color: #f8fafc !important;
    }
    html.dark .bg-slate-50 {
      background-color: #0f1a30 !important;
    }
    html.dark .bg-slate-100 {
      background-color: #1a2844 !important;
    }
    html.dark .border-slate-100,
    html.dark .border-slate-200 {
      border-color: #273859 !important;
    }
    html.dark .text-slate-800,
    html.dark .text-slate-900 {
      color: #f8fafc !important;
    }
    html.dark .text-slate-700 {
      color: #cbd5e1 !important;
    }
    html.dark .text-slate-600,
    html.dark .text-slate-500 {
      color: #94a3b8 !important;
    }
    html.dark input,
    html.dark select {
      background-color: #0f1a30 !important;
      border-color: #273859 !important;
      color: #f8fafc !important;
    }
    html.dark input:focus,
    html.dark select:focus {
      border-color: var(--duo-blue) !important;
    }
    html.dark .btn-3d-white {
      background-color: #1e2c4a !important;
      border-color: #334469 !important;
      color: #f1f5f9 !important;
      box-shadow: 0 3px 0 #152238 !important;
    }
    html.dark .btn-3d-white:hover {
      background-color: #243557 !important;
    }
    html.dark #tripSummaryModal > div,
    html.dark #favoritesModal > div,
    html.dark #affiliateAdminModal > div {
      background-color: #131f37 !important;
      border-color: #273859 !important;
      color: #f8fafc !important;
    }

    /* 🛋️ FILTRES D'ÉQUIPEMENTS PILULES ACTIVES */
    .amenity-pill.active {
      background-color: #d7ffb8 !important;
      color: #166534 !important;
      border-color: #22c55e !important;
      box-shadow: 0 3px 0 #15803d !important;
      font-weight: 900 !important;
    }
    html.dark .amenity-pill.active {
      background-color: #14532d !important;
      color: #86efac !important;
      border-color: #22c55e !important;
      box-shadow: 0 3px 0 #166534 !important;
    }

    /* 🦉 TOASTS FLOTTANTS GAMIFIÉS DUOLINGO */
    #duoToastContainer {
      position: fixed;
      bottom: 24px;
      right: 24px;
      z-index: 9999999;
      display: flex;
      flex-direction: column;
      gap: 10px;
      pointer-events: none;
    }
    .duo-toast {
      pointer-events: auto;
      min-width: 260px;
      max-width: 380px;
      padding: 12px 16px;
      border-radius: 16px;
      font-weight: 800;
      font-size: 13px;
      display: flex;
      align-items: center;
      gap: 10px;
      box-shadow: 0 10px 25px -5px rgba(0,0,0,0.25);
      animation: duoSlideIn 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      transition: all 0.2s ease;
    }
    @keyframes duoSlideIn {
      from { transform: translateY(20px) scale(0.9); opacity: 0; }
      to { transform: translateY(0) scale(1); opacity: 1; }
    }
    .duo-toast.toast-success {
      background-color: #58cc02;
      color: #ffffff;
      border-bottom: 3px solid #46a302;
    }
    .duo-toast.toast-info {
      background-color: #1cb0f6;
      color: #ffffff;
      border-bottom: 3px solid #1899d6;
    }
    .duo-toast.toast-warning {
      background-color: #ff9600;
      color: #ffffff;
      border-bottom: 3px solid #e07700;
    }
  </style>
</head>
<body class="p-3 md:p-6 max-w-6xl mx-auto min-h-screen">

  <!-- TOP BAR GAMIFIÉE DUOLINGO -->
  <header class="bg-white border-2 border-slate-200 border-b-4 rounded-2xl p-4 mb-5 flex flex-wrap items-center justify-between gap-4 shadow-sm">
    <div class="flex items-center gap-3">
      <div class="w-12 h-12 rounded-2xl bg-emerald-100 border-2 border-emerald-400 flex items-center justify-center text-2xl mascot-wiggle cursor-pointer shadow-sm">
        🦉
      </div>
      <div>
        <div class="flex items-center gap-2">
          <h1 class="text-xl md:text-2xl font-black tracking-tight text-slate-800 dark:text-white">SmartTrip Pro</h1>
          <span class="bg-indigo-600 text-white text-[11px] font-black uppercase px-2 py-0.5 rounded-full tracking-wider shadow-2xs">Comparaison 1-Clic</span>
        </div>
        <p class="text-xs font-bold text-slate-400">10 comparateurs mondiaux &bull; Google Hotels inclus &bull; Parrainage VIP &amp; Alertes Baisses de Prix</p>
      </div>
    </div>

    <!-- Contrôles PWA, Sélecteur Multi-Devises & Stats Duo -->
    <div class="flex items-center gap-2 md:gap-3 flex-wrap">
      <!-- Sélecteur Multi-Devises Interactif -->
      <div class="flex items-center gap-1 bg-slate-100 border-2 border-slate-200 px-2 py-1 rounded-xl shadow-2xs">
        <span class="text-[10px] font-black text-slate-400 uppercase mr-0.5">Devise :</span>
        <button type="button" onclick="setUserCurrency('EUR')" id="currBtnEUR" title="Zone Euro (€)" class="currency-btn text-xs font-black px-1.5 py-0.5 rounded-lg transition-all bg-white text-blue-600 shadow-sm border border-blue-300">EUR €</button>
        <button type="button" onclick="setUserCurrency('USD')" id="currBtnUSD" title="Dollar Américain ($)" class="currency-btn text-xs font-black px-1.5 py-0.5 rounded-lg transition-all text-slate-500 hover:text-slate-800">USD $</button>
        <button type="button" onclick="setUserCurrency('GBP')" id="currBtnGBP" title="Livre Sterling (£)" class="currency-btn text-xs font-black px-1.5 py-0.5 rounded-lg transition-all text-slate-500 hover:text-slate-800">GBP £</button>
        <button type="button" onclick="setUserCurrency('CAD')" id="currBtnCAD" title="Dollar Canadien ($)" class="currency-btn text-xs font-black px-1.5 py-0.5 rounded-lg transition-all text-slate-500 hover:text-slate-800">CAD $</button>
        <button type="button" onclick="setUserCurrency('JPY')" id="currBtnJPY" title="Yen Japonais (¥)" class="currency-btn text-xs font-black px-1.5 py-0.5 rounded-lg transition-all text-slate-500 hover:text-slate-800">JPY ¥</button>
        <button type="button" onclick="setUserCurrency('CHF')" id="currBtnCHF" title="Franc Suisse (CHF)" class="currency-btn text-xs font-black px-1.5 py-0.5 rounded-lg transition-all text-slate-500 hover:text-slate-800">CHF</button>
      </div>

      <!-- Bouton PWA (Installable Mobile / Desktop) -->
      <button type="button" id="btnInstallPwa" onclick="installPwaApp()" class="hidden btn-3d btn-3d-green text-xs py-1.5 px-3 flex items-center gap-1.5 shadow-sm cursor-pointer" title="Installer l'application sur votre écran d'accueil">
        <span>📲</span>
        <span class="hidden sm:inline">Installer l'App</span>
      </button>

      <!-- 🌙 Bascule Thème Sombre / Clair (Night Flight) -->
      <button type="button" id="btnThemeToggle" onclick="toggleTheme()" class="btn-3d btn-3d-white text-xs py-1.5 px-2.5 flex items-center gap-1 cursor-pointer" title="Basculer entre Mode Jour et Mode Nuit (Sombre)">
        <span id="themeIcon">☀️</span>
        <span class="hidden sm:inline text-[11px]" id="themeLabel">Clair</span>
      </button>

      <!-- 🎁 Club VIP & Parrainage Amis (Referral) -->
      <button type="button" id="btnOpenReferral" onclick="openReferralModal()" class="btn-3d bg-purple-50 hover:bg-purple-100 text-purple-800 border-2 border-purple-200 text-xs py-1.5 px-2.5 rounded-xl flex items-center gap-1 cursor-pointer" title="Inviter des amis et débloquer des avantages VIP">
        <span>🎁</span>
        <span class="hidden sm:inline font-extrabold text-[11px]">Club VIP</span>
        <span id="vipTierBadge" class="bg-purple-600 text-white text-[10px] font-black px-1.5 py-0.5 rounded-full">🥉 VIP</span>
      </button>

      <!-- ❤️ Wishlist / Favoris Voyageurs avec Alerte Baisse de Prix -->
      <button type="button" id="btnOpenFavorites" onclick="openFavoritesModal()" class="btn-3d bg-rose-50 hover:bg-rose-100 text-rose-700 border-2 border-rose-200 text-xs py-1.5 px-2.5 rounded-xl flex items-center gap-1 cursor-pointer relative" title="Consulter mes hébergements favoris & alertes baisses de prix">
        <span>❤️</span>
        <span class="hidden sm:inline font-extrabold text-[11px]">Favoris</span>
        <span id="favCountBadge" class="bg-rose-500 text-white text-[10px] font-black px-1.5 py-0.5 rounded-full">0</span>
        <span id="favPriceDropAlertDot" class="hidden absolute -top-1 -right-1 w-3.5 h-3.5 bg-emerald-500 border-2 border-white rounded-full animate-ping" title="Baisse de prix détectée !"></span>
        <span id="favPriceDropAlertDotSolid" class="hidden absolute -top-1 -right-1 w-3.5 h-3.5 bg-emerald-500 border-2 border-white rounded-full" title="Baisse de prix détectée !"></span>
      </button>

      <!-- 📊 Tableau de Bord Partenaire & Affiliation (Admin) -->
      <button type="button" id="btnOpenAffiliateAdmin" onclick="openAffiliateAdminModal()" class="btn-3d bg-amber-50 hover:bg-amber-100 text-amber-800 border-2 border-amber-200 text-xs py-1.5 px-2.5 rounded-xl flex items-center gap-1 cursor-pointer" title="Tableau de bord Partenaire & Affiliation (Alt+A)">
        <span>📊</span>
        <span class="hidden md:inline font-extrabold text-[11px]">Partenaire</span>
      </button>

      <div class="flex items-center gap-1.5 bg-orange-50 border-2 border-orange-200 px-3 py-1.5 rounded-xl">
        <span class="text-lg">🔥</span>
        <span class="text-xs font-black text-orange-600">7 JOURS</span>
      </div>
      <div class="flex items-center gap-1.5 bg-blue-50 border-2 border-blue-200 px-3 py-1.5 rounded-xl">
        <span class="text-lg">💎</span>
        <span id="gemCounter" class="text-xs font-black text-blue-600">1 650 XP</span>
      </div>
      <div class="flex items-center gap-1.5 bg-emerald-50 border-2 border-emerald-200 px-3 py-1.5 rounded-xl">
        <span class="text-lg">🛡️</span>
        <span class="text-xs font-black text-emerald-600">SÉCURISÉ</span>
      </div>
    </div>
  </header>

  <!-- FORMULAIRE DE RECHERCHE RAPIDE -->
  <section class="card-duo p-5 md:p-6 mb-6">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
      
      <!-- Destination avec Auto-complétion Mondiale en Direct -->
      <div class="lg:col-span-2 relative">
        <div class="flex items-center justify-between mb-1.5">
          <label class="block text-xs font-black text-slate-500 uppercase tracking-wider">📍 Destination (Monde entier)</label>
          <span class="text-[10px] font-bold text-emerald-600">● Mémorisation active</span>
        </div>
        <div class="flex items-center gap-2">
          <div class="relative flex-1">
            <input type="text" id="destInput" value="Rome" placeholder="Ex: Séville, Tokyo, Montréal, Berlin, Nice..." autocomplete="off"
              class="w-full px-4 py-3 bg-slate-50 border-2 border-slate-200 rounded-xl text-slate-800 font-bold focus:bg-white focus:border-blue-400 focus:outline-none transition-colors text-sm pr-9">
            <span id="destAutocompleteSpinner" class="hidden absolute right-3 top-3.5 text-xs animate-spin" title="Recherche en direct...">⏳</span>
          </div>
          <button type="button" onclick="executeSearch()" id="btnExecuteSearch" class="btn-3d btn-3d-green px-4 py-3 text-xs font-black shrink-0 flex items-center gap-1.5 shadow-md cursor-pointer" title="Lancer la recherche et actualiser les 10 OTA & 40 offres">
            <span>🔍</span> <span>RECHERCHER</span>
          </button>
        </div>
        <!-- Dropdown d'auto-complétion mondiale -->
        <div id="destSuggestionsDropdown" class="hidden absolute left-0 right-0 top-full mt-1 bg-white border-2 border-slate-200 rounded-2xl shadow-2xl z-50 overflow-hidden max-h-72 overflow-y-auto divide-y divide-slate-100"></div>
      </div>

      <!-- Arrivée -->
      <div>
        <label class="block text-xs font-black text-slate-500 uppercase tracking-wider mb-1.5">📅 Check-in</label>
        <input type="date" id="checkInInput" 
          class="w-full px-3 py-3 bg-slate-50 border-2 border-slate-200 rounded-xl text-slate-800 font-bold focus:bg-white focus:border-blue-400 focus:outline-none text-sm">
      </div>

      <!-- Départ -->
      <div>
        <label class="block text-xs font-black text-slate-500 uppercase tracking-wider mb-1.5">📅 Check-out</label>
        <input type="date" id="checkOutInput" 
          class="w-full px-3 py-3 bg-slate-50 border-2 border-slate-200 rounded-xl text-slate-800 font-bold focus:bg-white focus:border-blue-400 focus:outline-none text-sm">
      </div>

      <!-- Voyageurs -->
      <div>
        <label class="block text-xs font-black text-slate-500 uppercase tracking-wider mb-1.5">👥 Voyageurs</label>
        <select id="guestsInput" 
          class="w-full px-3 py-3 bg-slate-50 border-2 border-slate-200 rounded-xl text-slate-800 font-bold focus:bg-white focus:border-blue-400 focus:outline-none text-sm">
          <option value="1">👤 1 voyageur (Solo)</option>
          <option value="2" selected>👥 2 voyageurs (Couple / Duo)</option>
          <option value="3">👨‍👩‍👧 3 voyageurs (Trio / Triple)</option>
          <option value="4">👨‍👩‍👧‍👦 4 voyageurs (Petite famille / Quad)</option>
          <option value="5">👨‍👩‍👧‍👦 5 voyageurs (Famille nombreuse • 3 ch.)</option>
          <option value="6">👥 6 voyageurs (3 chambres ou Villa)</option>
          <option value="7">👥 7 voyageurs (Grande famille • 4 ch.)</option>
          <option value="8">🏡 8 voyageurs (Grand groupe / Villa 4ch)</option>
          <option value="9">🏡 9 voyageurs (Tribu • 5 ch.)</option>
          <option value="10">🏡 10 voyageurs (Grande Villa • 5 ch.)</option>
          <option value="12">🏰 12 voyageurs (Grand domaine / Villa 6ch)</option>
          <option value="14">🏰 14 voyageurs (Domaine / Gîte XXL • 7 ch.)</option>
          <option value="16">🏰 16 voyageurs (Séminaire / Tribu • 8 ch.)</option>
          <option value="20">🎉 20 voyageurs (Groupe XXL / Domaine)</option>
          <option value="30">🎉 30 voyageurs (Événement / Privatisation)</option>
        </select>
      </div>

<!-- Raccourcis Dates Express & Statut Séjour & Actions Partage -->
      <div class="col-span-1 md:col-span-4 flex flex-wrap items-center justify-between gap-2.5 pt-2.5 border-t border-slate-100">
        <div class="flex flex-wrap items-center gap-1.5">
          <span class="text-[11px] font-black text-slate-400 uppercase mr-1">⚡ Raccourcis Dates :</span>
          <button type="button" onclick="setDatePreset('weekend')" class="btn-3d btn-3d-white text-[11px] py-1 px-2.5">🏖️ Ce week-end (2n)</button>
          <button type="button" onclick="setDatePreset('nextWeekend')" class="btn-3d btn-3d-white text-[11px] py-1 px-2.5">🗓️ Week-end prochain (2n)</button>
          <button type="button" onclick="setDatePreset('inTwoWeeks')" class="btn-3d btn-3d-white text-[11px] py-1 px-2.5">✈️ Dans 2 semaines (5n)</button>
          <button type="button" onclick="setDatePreset('oneWeek')" class="btn-3d btn-3d-white text-[11px] py-1 px-2.5">🧳 1 semaine (7n)</button>
          <button type="button" onclick="setDatePreset('tomorrow')" class="btn-3d btn-3d-white text-[11px] py-1 px-2.5">🚀 Départ demain (3n)</button>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <div id="headerStayBadge" class="text-xs font-black text-indigo-700 bg-indigo-50 border border-indigo-200 px-3 py-1 rounded-xl shadow-2xs">
            📅 Séjour : 5 nuits
          </div>
          <!-- Actions Partage & Export en 1 Clic -->
          <div class="flex items-center gap-1.5">
            <button type="button" id="btnShareLink" onclick="copyShareLink(this)" title="Copier le lien partageable avec tous vos filtres actifs" class="btn-3d btn-3d-white text-xs py-1 px-2.5 flex items-center gap-1 cursor-pointer">
              🔗 <span class="hidden sm:inline">Copier le lien</span>
            </button>
            <button type="button" id="btnShareWhatsApp" onclick="shareOnWhatsApp()" title="Partager ce projet de voyage complet sur WhatsApp" class="btn-3d bg-emerald-500 hover:bg-emerald-600 text-white font-extrabold text-xs py-1 px-2.5 rounded-xl border-b-2 border-emerald-700 shadow-2xs flex items-center gap-1 cursor-pointer">
              💬 <span class="hidden sm:inline">WhatsApp</span>
            </button>
            <button type="button" id="btnOpenSummaryModal" onclick="openTripSummaryModal()" title="Consulter et imprimer la fiche récapitulative A4 / PDF" class="btn-3d bg-indigo-600 hover:bg-indigo-700 text-white font-extrabold text-xs py-1 px-2.5 rounded-xl border-b-2 border-indigo-800 shadow-2xs flex items-center gap-1 cursor-pointer">
              📄 <span class="hidden sm:inline">Fiche PDF</span>
            </button>
          </div>
        </div>
      </div>

    </div>

    <!-- 💰 CURSEURS DE PRIX MINI & MAXI -->
    <div class="mt-4 pt-4 border-t-2 border-slate-100">
      <div class="flex flex-wrap items-center gap-2 mb-3">
        <span class="text-xs font-black text-slate-500 uppercase tracking-wider">💰 Budget par nuit :</span>
        <span id="priceRangeBadge" class="bg-blue-100 text-blue-800 text-xs font-black px-3 py-1 rounded-full border border-blue-300">
          40 € ➔ 180 € / nuit
        </span>
        <span id="totalStayEstimateBadge" class="hidden sm:inline-block bg-emerald-100 text-emerald-800 text-[11px] font-bold px-2.5 py-0.5 rounded-full border border-emerald-300">
          ≈ 200 € à 900 € (5 nuits)
        </span>
      </div>

      <!-- Curseur Double (Min & Max Synchronisés) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 bg-slate-50 border-2 border-slate-200 rounded-2xl p-4">
        
        <!-- Curseur Prix Minimum -->
        <div>
          <div class="flex items-center justify-between mb-1.5">
            <div class="flex items-center gap-1.5">
              <span class="w-2.5 h-2.5 rounded-full bg-blue-500 inline-block"></span>
              <label for="minPriceRange" class="text-xs font-black text-slate-700 uppercase tracking-wide">Prix Minimum</label>
            </div>
            <div class="flex items-center gap-1 bg-white border-2 border-slate-200 rounded-lg px-2 py-0.5 shadow-sm">
              <input type="number" id="minPriceInput" min="0" max="1000" step="5" value="40"
                oninput="handleMinPriceChange(this.value, 'input')"
                class="w-16 text-right text-xs font-black text-slate-800 bg-transparent focus:outline-none">
              <span id="minPriceCurrSymbol" class="text-xs font-black text-slate-500">€/n</span>
            </div>
          </div>
          <input type="range" id="minPriceRange" min="0" max="1000" step="5" value="40"
            oninput="handleMinPriceChange(this.value, 'range')"
            class="w-full accent-blue-500 cursor-pointer h-2.5 bg-slate-200 rounded-lg">
          <div class="flex justify-between text-[10px] font-bold text-slate-400 mt-1">
            <span>0 € (Sans min)</span>
            <span>250 €</span>
            <span>500 €</span>
            <span>1000 €</span>
          </div>
        </div>

        <!-- Curseur Prix Maximum -->
        <div>
          <div class="flex items-center justify-between mb-1.5">
            <div class="flex items-center gap-1.5">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 inline-block"></span>
              <label for="maxPriceRange" class="text-xs font-black text-slate-700 uppercase tracking-wide">Prix Maximum</label>
            </div>
            <div class="flex items-center gap-1 bg-white border-2 border-slate-200 rounded-lg px-2 py-0.5 shadow-sm">
              <input type="number" id="maxPriceInput" min="10" max="1000" step="5" value="180"
                oninput="handleMaxPriceChange(this.value, 'input')"
                class="w-16 text-right text-xs font-black text-slate-800 bg-transparent focus:outline-none">
              <span id="maxPriceCurrSymbol" class="text-xs font-black text-slate-500">€/n</span>
            </div>
          </div>
          <input type="range" id="maxPriceRange" min="10" max="1000" step="5" value="180"
            oninput="handleMaxPriceChange(this.value, 'range')"
            class="w-full accent-emerald-500 cursor-pointer h-2.5 bg-slate-200 rounded-lg">
          <div class="flex justify-between text-[10px] font-bold text-slate-400 mt-1">
            <span>50 €</span>
            <span>200 €</span>
            <span>500 €</span>
            <span>1000 €+ (Illimité)</span>
          </div>
        </div>

      </div>
    </div>

    <!-- 🎯 CURSEUR DE DISTANCE PAR RAPPORT À UNE ADRESSE / POINT DE REPÈRE -->
    <div class="mt-4 pt-4 border-t-2 border-slate-100">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 mb-3">
        <div class="flex flex-wrap items-center gap-2">
          <span class="text-xs font-black text-slate-500 uppercase tracking-wider">🎯 Distance &amp; Adresse cible :</span>
          <span id="distBadge" class="bg-purple-100 text-purple-800 text-xs font-black px-3 py-1 rounded-full border border-purple-300">
            Rayon : Max 3.0 km de la cible
          </span>
          <span id="walkTimeEstimateBadge" class="hidden sm:inline-block bg-emerald-100 text-emerald-800 text-[11px] font-bold px-2.5 py-0.5 rounded-full border border-emerald-300">
            🚶 ~35 min à pied max
          </span>
        </div>

        <!-- Raccourcis Profils Distance Express -->
        <div class="flex flex-wrap items-center gap-1.5">
          <span class="text-[11px] font-black text-slate-400 uppercase mr-1">⚡ Rayons :</span>
          <button type="button" onclick="setDistancePreset(1)" class="btn-3d btn-3d-white text-[11px] py-1 px-2.5">🚶 Ultra-Centre (&lt; 1 km)</button>
          <button type="button" onclick="setDistancePreset(3)" class="btn-3d btn-3d-white text-[11px] py-1 px-2.5">🚲 Proche (&lt; 3 km)</button>
          <button type="button" onclick="setDistancePreset(7)" class="btn-3d btn-3d-white text-[11px] py-1 px-2.5">🚇 Métro / Tram (&lt; 7 km)</button>
          <button type="button" onclick="setDistancePreset(15)" class="btn-3d btn-3d-white text-[11px] py-1 px-2.5">🚗 Périphérie (&lt; 15 km)</button>
          <button type="button" onclick="setDistancePreset(0)" class="btn-3d btn-3d-white text-[11px] py-1 px-2.5">♾️ Sans limite</button>
        </div>
      </div>

      <!-- Contrôles Distance : Champ Adresse Cible + Curseur de Rayon -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 bg-slate-50 border-2 border-slate-200 rounded-2xl p-4">
        
        <!-- Adresse / Point de Repère Clé -->
        <div>
          <div class="flex items-center justify-between mb-1.5">
            <div class="flex items-center gap-1.5">
              <span class="w-2.5 h-2.5 rounded-full bg-indigo-500 inline-block"></span>
              <label for="landmarkInput" class="text-xs font-black text-slate-700 uppercase tracking-wide">Adresse, Quartier ou Monument Clé</label>
            </div>
            <button type="button" onclick="clearLandmark()" class="text-[10px] font-bold text-slate-400 hover:text-rose-500 underline cursor-pointer">Effacer</button>
          </div>
          <div class="relative">
            <input type="text" id="landmarkInput" value="" placeholder="Ex: Centre-ville, Gare, Tour Eiffel, Plage..." autocomplete="off"
              oninput="handleLandmarkChange(this.value)"
              class="w-full px-3 py-2 bg-white border-2 border-slate-200 rounded-xl font-bold text-slate-800 text-xs focus:outline-none focus:border-indigo-400 pl-8 pr-8">
            <span class="absolute left-2.5 top-2 text-xs">📍</span>
            <span id="landmarkAutocompleteSpinner" class="hidden absolute right-2.5 top-2 text-xs animate-spin" title="Recherche du repère...">⏳</span>
            <!-- Dropdown d'auto-complétion repères mondiaux -->
            <div id="landmarkSuggestionsDropdown" class="hidden absolute left-0 right-0 top-full mt-1.5 bg-white border-2 border-slate-200 rounded-2xl shadow-2xl z-50 overflow-hidden max-h-64 overflow-y-auto divide-y divide-slate-100"></div>
          </div>
          
          <!-- Suggestions d'adresses en 1 clic (dynamiques selon la destination active) -->
          <div id="landmarkSuggestionsContainer" class="flex flex-wrap items-center gap-1.5 mt-2">
            <span class="text-[10px] font-black text-slate-400 uppercase">Idées :</span>
            <button type="button" onclick="setLandmarkSuggestion('Centre Historique')" class="text-[10px] font-bold bg-white border border-slate-200 px-2 py-0.5 rounded-lg hover:border-indigo-400 text-slate-600">🏛️ Centre</button>
            <button type="button" onclick="setLandmarkSuggestion('Gare Centrale')" class="text-[10px] font-bold bg-white border border-slate-200 px-2 py-0.5 rounded-lg hover:border-indigo-400 text-slate-600">🚆 Gare</button>
            <button type="button" onclick="setLandmarkSuggestion('Plage')" class="text-[10px] font-bold bg-white border border-slate-200 px-2 py-0.5 rounded-lg hover:border-indigo-400 text-slate-600">🏖️ Plage</button>
            <button type="button" onclick="setLandmarkSuggestion('Aéroport')" class="text-[10px] font-bold bg-white border border-slate-200 px-2 py-0.5 rounded-lg hover:border-indigo-400 text-slate-600">✈️ Aéroport</button>
          </div>
        </div>

        <!-- Curseur Distance Maximale -->
        <div>
          <div class="flex items-center justify-between mb-1.5">
            <div class="flex items-center gap-1.5">
              <span class="w-2.5 h-2.5 rounded-full bg-purple-500 inline-block"></span>
              <label for="distRange" class="text-xs font-black text-slate-700 uppercase tracking-wide">Rayon Maximal de Recherche</label>
            </div>
            <div class="flex items-center gap-1 bg-white border-2 border-slate-200 rounded-lg px-2 py-0.5 shadow-sm">
              <input type="number" id="distInput" min="0" max="30" step="0.5" value="3.0"
                oninput="handleDistanceChange(this.value, 'input')"
                class="w-14 text-right text-xs font-black text-slate-800 bg-transparent focus:outline-none">
              <span class="text-xs font-black text-slate-500">km</span>
            </div>
          </div>
          <input type="range" id="distRange" min="0" max="30" step="0.5" value="3.0"
            oninput="handleDistanceChange(this.value, 'range')"
            class="w-full accent-purple-500 cursor-pointer h-2.5 bg-slate-200 rounded-lg">
          <div class="flex justify-between text-[10px] font-bold text-slate-400 mt-1">
            <span>0 km (Partout)</span>
            <span>5 km</span>
            <span>15 km</span>
            <span>30 km</span>
          </div>

          <!-- Bouton Satellite Google Maps -->
          <div class="mt-2 text-right">
            <button type="button" onclick="openTargetMap()" class="text-[11px] font-black text-indigo-600 hover:text-indigo-800 underline inline-flex items-center gap-1 cursor-pointer">
              <span>🗺️ Voir la zone cible sur Google Maps</span>
              <span class="text-[9px]">↗</span>
            </button>
          </div>
        </div>

      </div>
    </div>

    <!-- 🛋️ FILTRES D'ÉQUIPEMENTS EXPRESS (1-CLIC BOOST CONVIVIALITÉ) -->
    <div class="mt-4 pt-4 border-t-2 border-slate-100">
      <div class="flex flex-wrap items-center justify-between gap-2 mb-2.5">
        <div class="flex items-center gap-2">
          <span class="text-xs font-black text-slate-500 uppercase tracking-wider">✨ Équipements &amp; Confort 1-Clic :</span>
          <span id="activeAmenitiesCountBadge" class="text-[10px] font-black text-emerald-700 bg-emerald-50 border border-emerald-300 px-2.5 py-0.5 rounded-full shadow-2xs">Tous critères</span>
        </div>
        <button type="button" onclick="clearAmenityFilters()" class="text-[11px] font-bold text-slate-400 hover:text-slate-600 underline cursor-pointer">
          ✕ Réinitialiser filtres
        </button>
      </div>
      <div class="flex flex-wrap items-center gap-2" id="amenitiesFilterBar">
        <button type="button" onclick="toggleAmenityFilter('breakfast')" id="amenity-breakfast" class="amenity-pill btn-3d btn-3d-white text-xs py-1.5 px-3 flex items-center gap-1.5 cursor-pointer">
          <span>☕</span> <span>Petit-déjeuner inclus</span>
        </button>
        <button type="button" onclick="toggleAmenityFilter('pool')" id="amenity-pool" class="amenity-pill btn-3d btn-3d-white text-xs py-1.5 px-3 flex items-center gap-1.5 cursor-pointer">
          <span>🏊</span> <span>Piscine / Rooftop</span>
        </button>
        <button type="button" onclick="toggleAmenityFilter('ac')" id="amenity-ac" class="amenity-pill btn-3d btn-3d-white text-xs py-1.5 px-3 flex items-center gap-1.5 cursor-pointer">
          <span>❄️</span> <span>Climatisation</span>
        </button>
        <button type="button" onclick="toggleAmenityFilter('parking')" id="amenity-parking" class="amenity-pill btn-3d btn-3d-white text-xs py-1.5 px-3 flex items-center gap-1.5 cursor-pointer">
          <span>🚗</span> <span>Parking / Garage</span>
        </button>
        <button type="button" onclick="toggleAmenityFilter('cancel')" id="amenity-cancel" class="amenity-pill btn-3d btn-3d-white text-xs py-1.5 px-3 flex items-center gap-1.5 cursor-pointer">
          <span>🔄</span> <span>Annulation flexible</span>
        </button>
        <button type="button" onclick="toggleAmenityFilter('toprated')" id="amenity-toprated" class="amenity-pill btn-3d btn-3d-white text-xs py-1.5 px-3 flex items-center gap-1.5 cursor-pointer">
          <span>🌟</span> <span>Note &gt; 9.0 (Excellence)</span>
        </button>
      </div>
    </div>

    <!-- 💡 BANDEAU ZÉRO-CLIC (MÉTÉO + DEVISE + FÉRIÉ) -->
    <div class="mt-4 pt-3 border-t-2 border-slate-100 grid grid-cols-1 sm:grid-cols-3 gap-3">
      <div class="bg-sky-50 border border-sky-200 rounded-xl p-3 flex items-center gap-3">
        <span class="text-2xl" id="stripWeatherIcon">⛅</span>
        <div class="min-w-0">
          <div class="text-[10px] font-black uppercase text-sky-600 tracking-wider">Météo Destination</div>
          <div class="text-xs font-black text-slate-800 truncate" id="stripWeatherText">Chargement météo...</div>
        </div>
      </div>
      <div class="bg-amber-50 border border-amber-200 rounded-xl p-3 flex items-center gap-3">
        <span class="text-2xl">💱</span>
        <div class="min-w-0">
          <div class="text-[10px] font-black uppercase text-amber-700 tracking-wider">Taux de Change (BCE)</div>
          <div class="text-xs font-black text-slate-800 truncate" id="stripCurrencyText">1 EUR = 1.00 EUR (Zone Euro)</div>
        </div>
      </div>
      <div id="stripHolidayBox" class="bg-emerald-50 border border-emerald-200 rounded-xl p-3 flex items-center gap-3">
        <span class="text-2xl" id="stripHolidayIcon">✅</span>
        <div class="min-w-0">
          <div class="text-[10px] font-black uppercase text-emerald-700 tracking-wider" id="stripHolidayTitle">Calendrier Local</div>
          <div class="text-xs font-black text-slate-800 truncate" id="stripHolidayText">Tarifs normaux (aucun férié)</div>
        </div>
      </div>
    </div>

  </section>

  <!-- 🚀 MASTER BANNER : TOUT COMPARER EN 1 CLIC (TOUS LES COMPARATEURS & GOOGLE) -->
  <div class="bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-700 rounded-2xl p-5 text-white mb-6 shadow-xl border-2 border-blue-400">
    <div class="flex flex-col lg:flex-row items-center justify-between gap-5">
      <div class="flex items-center gap-4 text-center lg:text-left">
        <div class="w-14 h-14 rounded-2xl bg-white/20 backdrop-blur flex items-center justify-center text-3xl shadow-inner shrink-0">
          🚀
        </div>
        <div>
          <div class="flex items-center justify-center lg:justify-start gap-2">
            <h2 class="text-lg md:text-xl font-black tracking-tight">Comparaison Exhaustive en 1 Clic</h2>
            <span class="bg-amber-400 text-slate-900 text-[10px] font-black uppercase px-2 py-0.5 rounded-full">Google Hotels Inclus</span>
          </div>
          <p class="text-xs font-bold text-blue-100 mt-1">
            Lancez instantanément la recherche sur <strong>tous les comparateurs du web</strong> sans avoir à chercher site par site.
          </p>
        </div>
      </div>

      <!-- Boutons d'Action 1-Clic -->
      <div class="flex flex-wrap items-center justify-center gap-3 w-full lg:w-auto">
        <button onclick="openAllPlatforms()" class="btn-3d btn-3d-green bg-emerald-400 text-slate-900 hover:bg-emerald-300 py-3.5 px-6 text-sm font-black shadow-lg">
          ⚡ TOUT OUVRIR EN 1 CLIC (10 SITES) ↗
        </button>
        <button onclick="openTop3Platforms()" class="btn-3d btn-3d-blue bg-white text-blue-700 hover:bg-blue-50 py-3.5 px-5 text-xs font-black">
          🌐 Top 3 (Google + Booking + Airbnb) ↗
        </button>
        <button onclick="shareTripSummary()" id="btnShareTrip" class="btn-3d btn-3d-white py-3.5 px-4 text-xs font-black" title="Copier tous les liens prêts pour WhatsApp / Email">
          📤 PARTAGER
        </button>
        <button onclick="resetAllTool()" id="btnMasterReset" class="btn-3d btn-3d-white py-3.5 px-4 text-xs font-black text-rose-600 hover:text-rose-700" title="Réinitialiser l'ensemble de l'outil et de tous ses modules à zéro">
          🔄 TOUT REMETTRE À ZÉRO
        </button>
      </div>
    </div>

    <!-- Notification / Conseil Popup -->
    <div class="mt-3.5 pt-3 border-t border-white/20 flex flex-wrap items-center justify-between text-[11px] font-bold text-blue-100 gap-2">
      <div class="flex items-center gap-1.5">
        <span>💡</span>
        <span>Le bouton <strong>"TOUT OUVRIR"</strong> lance simultanément Google Hotels, Booking, Airbnb, Agoda, Expedia, Kayak, etc.</span>
      </div>
      <div class="text-amber-200">
        Si votre navigateur bloque les pop-ups multiples, autorisez-les une fois pour ce site.
      </div>
    </div>
  </div>

  <!-- NAVIGATION PAR ONGLETS CHUNKY DUOLINGO -->
  <div class="overflow-x-auto pb-2 mb-6">
    <nav class="flex gap-2 min-w-max" role="tablist" aria-label="Fonctionnalités principales">
      <button onclick="switchTab('platforms')" id="tabBtn-platforms" role="tab" aria-selected="true" aria-controls="tab-platforms" class="tab-btn active btn-3d btn-3d-white py-2.5 px-4 text-xs md:text-sm">
        🌐 10 Comparateurs (Google Inclus)
      </button>
      <button onclick="switchTab('duel')" id="tabBtn-duel" role="tab" aria-selected="false" aria-controls="tab-duel" class="tab-btn btn-3d btn-3d-white py-2.5 px-4 text-xs md:text-sm">
        ⚔️ Duel 3 Voies (Google vs Booking vs Airbnb)
      </button>
      <button onclick="switchTab('negotiate')" id="tabBtn-negotiate" role="tab" aria-selected="false" aria-controls="tab-negotiate" class="tab-btn btn-3d btn-3d-white py-2.5 px-4 text-xs md:text-sm">
        💬 Négociation Hôtes
      </button>
      <button onclick="switchTab('tco')" id="tabBtn-tco" role="tab" aria-selected="false" aria-controls="tab-tco" class="tab-btn btn-3d btn-3d-white py-2.5 px-4 text-xs md:text-sm">
        🧮 Coût Réel (TCO)
      </button>
      <button onclick="switchTab('handbook')" id="tabBtn-handbook" role="tab" aria-selected="false" aria-controls="tab-handbook" class="tab-btn btn-3d btn-3d-white py-2.5 px-4 text-xs md:text-sm">
        📄 Carnet Hors-Ligne &amp; Urgences
      </button>
      <button onclick="switchTab('security')" id="tabBtn-security" role="tab" aria-selected="false" aria-controls="tab-security" class="tab-btn btn-3d btn-3d-white py-2.5 px-4 text-xs md:text-sm">
        🛡️ Quête Anti-Arnaque
      </button>
      <button onclick="switchTab('calendar')" id="tabBtn-calendar" role="tab" aria-selected="false" aria-controls="tab-calendar" class="tab-btn btn-3d btn-3d-white py-2.5 px-4 text-xs md:text-sm">
        📅 Rappels (.ics)
      </button>
      <button onclick="switchTab('walkscore')" id="tabBtn-walkscore" role="tab" aria-selected="false" aria-controls="tab-walkscore" class="tab-btn btn-3d btn-3d-white py-2.5 px-4 text-xs md:text-sm">
        🚶 Distance &amp; Walk Score
      </button>
    </nav>
  </div>

  <!-- ============================================== -->
  <!-- ONGLET 1 : LES 10 COMPARATEURS MONDAUX         -->
  <!-- ============================================== -->
  <section id="tab-platforms" class="space-y-4">
    <div class="flex flex-wrap items-center justify-between gap-3 mb-2">
      <div class="flex items-center gap-2">
        <h3 class="text-base md:text-lg font-black text-slate-800">
          🏆 Liste des 10 Grands Comparateurs Mondiaux
        </h3>
        <span class="bg-blue-100 text-blue-800 text-xs font-black px-2 py-0.5 rounded-full">Google Hotels en tête</span>
      </div>
      
      <!-- Filtres rapides de sous-groupes -->
      <div class="flex items-center gap-2">
        <span class="text-xs font-black text-slate-400 uppercase">Ouverture par profil :</span>
        <button onclick="openCategory('hotels')" class="btn-3d btn-3d-white text-xs py-1 px-3">🏨 Tous les Hôtels ↗</button>
        <button onclick="openCategory('rentals')" class="btn-3d btn-3d-white text-xs py-1 px-3">🏡 Toutes les Locations ↗</button>
      </div>
    </div>

    <!-- 🛡️ BANDEAU DE VÉRIFICATION EN DIRECT DES HÔTELS ET LOGEMENTS RÉELS -->
    <div id="sourceVerificationBadge" class="bg-emerald-50 border-2 border-emerald-300 rounded-2xl p-3.5 flex flex-wrap items-center justify-between gap-3 shadow-sm transition-all mb-3">
      <div class="flex items-center gap-3">
        <span class="text-2xl shrink-0" id="sourceVerificationIcon">🛡️</span>
        <div>
          <div class="text-xs font-black text-emerald-950 flex items-center gap-2">
            <span id="sourceVerificationTitle">Sources 100% Réelles Vérifiées</span>
            <span class="bg-emerald-200 text-emerald-900 text-[10px] font-black px-2 py-0.5 rounded-full border border-emerald-400" id="sourceVerificationStatus">Certifié OSM & Google</span>
          </div>
          <div class="text-[11px] font-bold text-emerald-800" id="sourceVerificationDesc">
            Hôtels et hébergements physiques réels vérifiés par géolocalisation et cadastre hôtelier mondial.
          </div>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <button onclick="refreshLiveAccommodations()" class="btn-3d btn-3d-white text-xs py-1.5 px-3 flex items-center gap-1" title="Actualiser la vérification des sources hôtelières en direct">
          <span>🔄 Revérifier la ville</span>
        </button>
      </div>
    </div>

    <!-- ⚡ BARRE D'ACTION DES 4 MEILLEURS RÉSULTATS PAR COMPARATEUR -->
    <!-- 📅 BANDEAU DE RESPECT ET SYNCHRONISATION DES DATES DU SÉJOUR -->
    <div id="staySummaryBanner" class="bg-gradient-to-r from-blue-50 via-indigo-50 to-purple-50 border-2 border-indigo-200 rounded-2xl p-3.5 flex flex-wrap items-center justify-between gap-3 shadow-sm mb-3">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-indigo-600 text-white flex items-center justify-center text-lg font-black shadow-xs shrink-0">
          📅
        </div>
        <div>
          <div class="text-xs font-black text-indigo-950 flex items-center gap-2">
            <span id="staySummaryTitle">Dates du séjour : du 22 sept. au 27 sept. 2026</span>
            <span id="staySummaryNightsBadge" class="bg-indigo-600 text-white text-[10px] font-black px-2 py-0.5 rounded-full">5 Nuits</span>
          </div>
          <div class="text-[11px] font-bold text-slate-600" id="staySummaryDetails">
            📍 Rome • 👥 2 personnes • Tous les comparateurs et tarifs réels sont calibrés sur cette période exacte.
          </div>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-[10px] font-black text-emerald-700 bg-emerald-100 border border-emerald-300 px-2.5 py-1 rounded-full flex items-center gap-1 shadow-2xs">
          <span>✓</span> <span>Dates verrouillées sur les 10 comparateurs</span>
        </span>
      </div>
    </div>

    <div class="bg-indigo-50 border-2 border-indigo-200 rounded-2xl p-3.5 flex flex-wrap items-center justify-between gap-3 shadow-sm">
      <div class="flex items-center gap-3">
        <span class="text-2xl">✨</span>
        <div>
          <div class="text-xs font-black text-indigo-950 flex items-center gap-2">
            <span>4 Meilleurs Logements en direct sous chaque comparateur</span>
            <span class="bg-emerald-100 text-emerald-800 text-[10px] font-black px-2 py-0.5 rounded-full border border-emerald-300">40 Offres Actives</span>
          </div>
          <div class="text-[11px] font-bold text-indigo-700">Consultez les hébergements directement dans l'outil sans devoir aller sur les sites</div>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <button onclick="expandAllOffers()" class="btn-3d btn-3d-blue text-xs py-1.5 px-3">📂 Tout Déplier (40 offres)</button>
        <button onclick="collapseAllOffers()" class="btn-3d btn-3d-white text-xs py-1.5 px-3">📁 Tout Replier</button>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" id="platformsGrid"></div>
  </section>

  <!-- ============================================== -->
  <!-- ONGLET 2 : DUEL COMPARATIF 3 VOIES             -->
  <!-- (GOOGLE HOTELS vs BOOKING vs AIRBNB)           -->
  <!-- ============================================== -->
  <section id="tab-duel" class="hidden space-y-6">
    <div class="card-duo p-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4 pb-3 border-b-2 border-slate-100">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-orange-100 text-orange-600 flex items-center justify-center font-black text-xl">⚔️</div>
          <div>
            <h3 class="text-base md:text-lg font-black text-slate-800">Le Comparatif Arbitrage 3 Voies (Google vs Booking vs Airbnb)</h3>
            <p class="text-xs font-bold text-slate-400">Entrez les prix constatés sur chaque plateforme pour identifier le vrai vainqueur net</p>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <button type="button" onclick="populateDuelWithTopOffers()" class="btn-3d btn-3d-blue text-xs py-1.5 px-3" title="Pré-remplir avec les meilleures offres de votre recherche active">
            ⚡ Remplir avec les offres actives
          </button>
          <button type="button" onclick="resetDuel(true)" class="btn-3d btn-3d-white text-xs py-1.5 px-3" title="Effacer tous les champs du duel">
            🧹 Vider le duel
          </button>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
        
        <!-- Option 1 : Google Hotels (Méta-moteur) -->
        <div class="border-2 border-blue-300 rounded-2xl p-4 bg-blue-50/50 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-black uppercase text-blue-700">1. Google Hotels</span>
              <span class="bg-blue-200 text-blue-800 text-[10px] font-black px-2 py-0.5 rounded">MÉTA-MOTEUR</span>
            </div>
            <div class="space-y-2.5">
              <div>
                <label class="block text-[10px] font-black text-slate-500 uppercase mb-1">Hôtel / Offre Repérée</label>
                <input type="text" id="duelNameGoogle" value="Grand Hôtel Roma 4★ (Offre directe)" class="w-full px-2.5 py-1.5 bg-white border border-slate-200 rounded-lg text-xs font-bold">
              </div>
              <div class="grid grid-cols-2 gap-2">
                <div>
                  <label id="duelCurrencyLabelG" class="block text-[10px] font-black text-slate-500 uppercase mb-1">Loyer (€ / nuit)</label>
                  <input type="number" id="duelPriceGoogle" value="120" oninput="computeDuel()" class="w-full px-2.5 py-1.5 bg-white border border-slate-200 rounded-lg text-xs font-bold">
                </div>
                <div>
                  <label class="block text-[10px] font-black text-slate-500 uppercase mb-1">Ménage (€)</label>
                  <input type="number" id="duelCleanGoogle" value="0" oninput="computeDuel()" class="w-full px-2.5 py-1.5 bg-white border border-slate-200 rounded-lg text-xs font-bold">
                </div>
              </div>
              <div>
                <label class="block text-[10px] font-black text-slate-500 uppercase mb-1">Parking / Extras (€ / jour)</label>
                <input type="number" id="duelParkGoogle" value="20" oninput="computeDuel()" class="w-full px-2.5 py-1.5 bg-white border border-slate-200 rounded-lg text-xs font-bold">
              </div>
            </div>
          </div>
          <div class="mt-4 pt-3 border-t border-blue-200 text-right">
            <span class="text-[11px] font-bold text-slate-500" id="duelNightsLabelGoogle">Total 5 nuits : </span>
            <span class="text-lg font-black text-blue-700" id="duelTotalGoogle">700,00 €</span>
          </div>
        </div>

        <!-- Option 2 : Booking.com -->
        <div class="border-2 border-indigo-300 rounded-2xl p-4 bg-indigo-50/50 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-black uppercase text-indigo-700">2. Booking.com</span>
              <span class="bg-indigo-200 text-indigo-800 text-[10px] font-black px-2 py-0.5 rounded">CENTRALE HÔTELS</span>
            </div>
            <div class="space-y-2.5">
              <div>
                <label class="block text-[10px] font-black text-slate-500 uppercase mb-1">Hôtel / Offre Repérée</label>
                <input type="text" id="duelNameBooking" value="Hôtel Splendido Roma (Genius -10%)" class="w-full px-2.5 py-1.5 bg-white border border-slate-200 rounded-lg text-xs font-bold">
              </div>
              <div class="grid grid-cols-2 gap-2">
                <div>
                  <label id="duelCurrencyLabelB" class="block text-[10px] font-black text-slate-500 uppercase mb-1">Loyer (€ / nuit)</label>
                  <input type="number" id="duelPriceBooking" value="115" oninput="computeDuel()" class="w-full px-2.5 py-1.5 bg-white border border-slate-200 rounded-lg text-xs font-bold">
                </div>
                <div>
                  <label class="block text-[10px] font-black text-slate-500 uppercase mb-1">Ménage (€)</label>
                  <input type="number" id="duelCleanBooking" value="0" oninput="computeDuel()" class="w-full px-2.5 py-1.5 bg-white border border-slate-200 rounded-lg text-xs font-bold">
                </div>
              </div>
              <div>
                <label class="block text-[10px] font-black text-slate-500 uppercase mb-1">Parking / Extras (€ / jour)</label>
                <input type="number" id="duelParkBooking" value="25" oninput="computeDuel()" class="w-full px-2.5 py-1.5 bg-white border border-slate-200 rounded-lg text-xs font-bold">
              </div>
            </div>
          </div>
          <div class="mt-4 pt-3 border-t border-indigo-200 text-right">
            <span class="text-[11px] font-bold text-slate-500" id="duelNightsLabelBooking">Total 5 nuits : </span>
            <span class="text-lg font-black text-indigo-700" id="duelTotalBooking">700,00 €</span>
          </div>
        </div>

        <!-- Option 3 : Airbnb -->
        <div class="border-2 border-rose-300 rounded-2xl p-4 bg-rose-50/50 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-black uppercase text-rose-700">3. Airbnb</span>
              <span class="bg-rose-200 text-rose-800 text-[10px] font-black px-2 py-0.5 rounded">APPARTEMENT</span>
            </div>
            <div class="space-y-2.5">
              <div>
                <label class="block text-[10px] font-black text-slate-500 uppercase mb-1">Logement Repéré</label>
                <input type="text" id="duelNameAirbnb" value="Appartement Centre avec Cuisine" class="w-full px-2.5 py-1.5 bg-white border border-slate-200 rounded-lg text-xs font-bold">
              </div>
              <div class="grid grid-cols-2 gap-2">
                <div>
                  <label id="duelCurrencyLabelA" class="block text-[10px] font-black text-slate-500 uppercase mb-1">Loyer (€ / nuit)</label>
                  <input type="number" id="duelPriceAirbnb" value="95" oninput="computeDuel()" class="w-full px-2.5 py-1.5 bg-white border border-slate-200 rounded-lg text-xs font-bold">
                </div>
                <div>
                  <label class="block text-[10px] font-black text-slate-500 uppercase mb-1">Ménage (€)</label>
                  <input type="number" id="duelCleanAirbnb" value="55" oninput="computeDuel()" class="w-full px-2.5 py-1.5 bg-white border border-slate-200 rounded-lg text-xs font-bold">
                </div>
              </div>
              <div>
                <label class="block text-[10px] font-black text-slate-500 uppercase mb-1">Parking / Extras (€ / jour)</label>
                <input type="number" id="duelParkAirbnb" value="0" placeholder="0 si gratuit" oninput="computeDuel()" class="w-full px-2.5 py-1.5 bg-white border border-slate-200 rounded-lg text-xs font-bold">
              </div>
            </div>
          </div>
          <div class="mt-4 pt-3 border-t border-rose-200 text-right">
            <span class="text-[11px] font-bold text-slate-500" id="duelNightsLabelAirbnb">Total 5 nuits : </span>
            <span class="text-lg font-black text-rose-700" id="duelTotalAirbnb">530,00 €</span>
          </div>
        </div>

      </div>

      <!-- Verdict du Match 3 Voies -->
      <div id="duelVerdictBox" class="mt-6 bg-gradient-to-r from-amber-100 to-yellow-100 border-2 border-amber-300 border-b-4 rounded-2xl p-4 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-3 text-center sm:text-left">
          <span class="text-4xl">🏆</span>
          <div>
            <div class="text-xs font-black text-amber-800 uppercase tracking-wide">Meilleur Prix Net Constate</div>
            <div class="text-base font-black text-slate-900" id="duelWinnerTitle">Airbnb est le Vainqueur Économique !</div>
            <p class="text-xs font-bold text-amber-900 mt-0.5" id="duelWinnerDiff">Vous économisez 170,00 € par rapport aux hôtels traditionnels.</p>
          </div>
        </div>
        <button onclick="switchTab('platforms')" class="btn-3d btn-3d-green py-2.5 px-4 text-xs whitespace-nowrap">
          RÉSERVER AU MEILLEUR PRIX ↗
        </button>
      </div>

    </div>
  </section>

  <!-- ============================================== -->
  <!-- ONGLET 3 : NÉGOCIATION & MESSAGES HÔTES        -->
  <!-- ============================================== -->
  <section id="tab-negotiate" class="hidden space-y-6">
    <div class="card-duo p-6">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-10 h-10 rounded-xl bg-purple-100 text-purple-600 flex items-center justify-center font-black text-xl">💬</div>
        <div>
          <h3 class="text-base md:text-lg font-black text-slate-800">Le Négociateur Diplomatique Multilingue</h3>
          <p class="text-xs font-bold text-slate-400">Générez en 1 clic des messages ultra polis pour négocier des réductions ou des avantages</p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
        <div>
          <label class="block text-xs font-black text-slate-500 uppercase mb-1.5">🎯 Objectif de la négociation</label>
          <select id="negoScenario" onchange="generateNegotiationMessage()" class="w-full px-3 py-2.5 bg-slate-50 border-2 border-slate-200 rounded-xl font-bold text-xs">
            <option value="Discount">🏷️ Remise séjour multi-nuits (-12%)</option>
            <option value="EarlyCheckIn">⏰ Demande d'arrivée anticipée / Dépôt de bagages</option>
            <option value="WiFiCheck">🛜 Vérification de la fiabilité & débit Wi-Fi</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-black text-slate-500 uppercase mb-1.5">🗣️ Langue de l'hôte</label>
          <select id="negoLang" onchange="generateNegotiationMessage()" class="w-full px-3 py-2.5 bg-slate-50 border-2 border-slate-200 rounded-xl font-bold text-xs">
            <option value="IT">🇮🇹 Italien (Italiano)</option>
            <option value="EN">🇬🇧 Anglais (English)</option>
            <option value="ES">🇪🇸 Espagnol (Español)</option>
            <option value="JA">🇯🇵 Japonais (日本語)</option>
            <option value="DE">🇩🇪 Allemand (Deutsch)</option>
            <option value="FR">🇫🇷 Français</option>
          </select>
        </div>
      </div>

      <div class="relative">
        <textarea id="negoText" rows="7" 
          class="w-full p-4 bg-slate-50 border-2 border-slate-200 rounded-2xl font-bold text-slate-800 text-xs md:text-sm focus:outline-none focus:border-purple-400"></textarea>
      </div>

      <div class="flex flex-wrap items-center justify-between gap-3 mt-4">
        <div class="text-xs font-bold text-slate-400 flex items-center gap-1.5">
          <span>💡</span> <span>Astuce : Envoyez ce message avant de réserver sur Booking ou Airbnb !</span>
        </div>
        <button onclick="copyNegoMessage()" id="btnCopyNego" class="btn-3d btn-3d-purple py-2.5 px-5 text-xs">
          📋 COPIER LE MESSAGE
        </button>
      </div>
    </div>
  </section>

  <!-- ============================================== -->
  <!-- ONGLET 4 : SIMULATEUR COÛT RÉEL (TCO)          -->
  <!-- ============================================== -->
  <section id="tab-tco" class="hidden space-y-6">
    <div class="card-duo p-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4 pb-3 border-b-2 border-slate-100">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-blue-100 text-blue-600 flex items-center justify-center font-black text-xl">🧮</div>
          <div>
            <h3 class="text-base md:text-lg font-black text-slate-800">Calculateur du Vrai Coût Global (Anti-Frais Cachés)</h3>
            <p class="text-xs font-bold text-slate-400">Ne te fais plus avoir par un loyer faussement pas cher</p>
          </div>
        </div>
        <button type="button" onclick="resetTco()" class="btn-3d btn-3d-white text-xs py-1.5 px-3" title="Remettre à zéro les valeurs du TCO">
          🔄 Réinitialiser TCO
        </button>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-black text-slate-600 uppercase mb-1.5">Loyer de base par nuit (€)</label>
              <input type="number" id="tcoPricePerNight" value="110" min="0" oninput="computeTco()"
                class="w-full px-4 py-2.5 bg-slate-50 border-2 border-slate-200 rounded-xl font-bold text-slate-800 text-sm focus:outline-none focus:border-blue-400">
            </div>
            <div>
              <label class="block text-xs font-black text-slate-600 uppercase mb-1.5">Nombre de nuits</label>
              <input type="number" id="tcoNights" value="5" min="1" oninput="computeTco()"
                class="w-full px-4 py-2.5 bg-slate-50 border-2 border-slate-200 rounded-xl font-bold text-slate-800 text-sm focus:outline-none focus:border-blue-400">
            </div>
            <div>
              <label class="block text-xs font-black text-slate-600 uppercase mb-1.5">Frais de ménage (€ total)</label>
              <input type="number" id="tcoCleaning" value="45" min="0" oninput="computeTco()"
                class="w-full px-4 py-2.5 bg-slate-50 border-2 border-slate-200 rounded-xl font-bold text-slate-800 text-sm focus:outline-none focus:border-blue-400">
            </div>
            <div>
              <label class="block text-xs font-black text-slate-600 uppercase mb-1.5">Taxe de séjour (€ / nuit / pers)</label>
              <input type="number" id="tcoCityTax" value="3.5" min="0" step="0.5" oninput="computeTco()"
                class="w-full px-4 py-2.5 bg-slate-50 border-2 border-slate-200 rounded-xl font-bold text-slate-800 text-sm focus:outline-none focus:border-blue-400">
            </div>
            <div>
              <label class="block text-xs font-black text-slate-600 uppercase mb-1.5">Parking / Garage (€ par jour)</label>
              <input type="number" id="tcoParking" value="15" min="0" oninput="computeTco()"
                class="w-full px-4 py-2.5 bg-slate-50 border-2 border-slate-200 rounded-xl font-bold text-slate-800 text-sm focus:outline-none focus:border-blue-400">
            </div>
            <div>
              <label class="block text-xs font-black text-slate-600 uppercase mb-1.5">Frais de change / banque (%)</label>
              <input type="number" id="tcoBankFees" value="2.5" min="0" step="0.5" oninput="computeTco()"
                class="w-full px-4 py-2.5 bg-slate-50 border-2 border-slate-200 rounded-xl font-bold text-slate-800 text-sm focus:outline-none focus:border-blue-400">
            </div>
          </div>
        </div>

        <!-- Résultat & Bilan Chunky -->
        <div class="bg-gradient-to-b from-blue-50 to-indigo-50 border-2 border-blue-200 border-b-4 rounded-2xl p-5 flex flex-col justify-between">
          <div>
            <div class="text-xs font-black uppercase text-blue-600 tracking-wider mb-1">Total Réel TTC Clé en Main</div>
            <div class="text-3xl md:text-4xl font-black text-slate-800" id="tcoTotalDisplay">722,88 €</div>
            <div class="text-xs font-bold text-slate-500 mt-1" id="tcoPerNightDisplay">Soit 144,58 € / nuit réelle</div>

            <div class="my-4 pt-3 border-t-2 border-blue-200/60 space-y-2 text-xs font-bold text-slate-600">
              <div class="flex justify-between"><span>Loyer net (<span id="tcoSumNights">5</span>n) :</span><span class="font-extrabold text-slate-800" id="tcoSumBase">550,00 €</span></div>
              <div class="flex justify-between"><span>Ménage :</span><span class="font-extrabold text-slate-800" id="tcoSumClean">45,00 €</span></div>
              <div class="flex justify-between"><span>Taxes de séjour :</span><span class="font-extrabold text-slate-800" id="tcoSumTax">35,00 €</span></div>
              <div class="flex justify-between"><span>Parking total :</span><span class="font-extrabold text-slate-800" id="tcoSumPark">75,00 €</span></div>
              <div class="flex justify-between"><span>Frais bancaires :</span><span class="font-extrabold text-slate-800" id="tcoSumBank">17,88 €</span></div>
            </div>
          </div>
          <div class="mt-2 bg-white border-2 border-emerald-200 rounded-xl p-3 flex items-center gap-2">
            <span class="text-2xl">💡</span>
            <div class="text-[11px] font-bold text-slate-600 leading-tight">
              Les frais annexes représentent <strong class="text-emerald-600" id="tcoExtraPercent">+31.4%</strong> par rapport au loyer facial.
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================== -->
  <!-- ONGLET 5 : CARNET HORS-LIGNE & URGENCES        -->
  <!-- ============================================== -->
  <section id="tab-handbook" class="hidden space-y-6">
    <div class="card-duo p-6">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-10 h-10 rounded-xl bg-rose-100 text-rose-600 flex items-center justify-center font-black text-xl">📄</div>
        <div>
          <h3 class="text-base md:text-lg font-black text-slate-800">Carnet de Voyage Hors-Ligne &amp; Fiche d'Urgence</h3>
          <p class="text-xs font-bold text-slate-400">Emportez toutes les informations indispensables sur votre mobile sans connexion</p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
        <div>
          <label class="block text-xs font-black text-slate-500 uppercase mb-1">Nom du logement / Hôtel</label>
          <input type="text" id="handbookHotel" value="Hôtel Splendido & Suites" class="w-full px-3 py-2 bg-slate-50 border-2 border-slate-200 rounded-xl font-bold text-xs">
        </div>
        <div>
          <label class="block text-xs font-black text-slate-500 uppercase mb-1">Contact de l'hôte / Téléphone</label>
          <input type="text" id="handbookContact" value="+39 06 12345678" class="w-full px-3 py-2 bg-slate-50 border-2 border-slate-200 rounded-xl font-bold text-xs">
        </div>
        <div class="md:col-span-2">
          <label class="block text-xs font-black text-slate-500 uppercase mb-1">Adresse exacte</label>
          <input type="text" id="handbookAddress" value="Via Cavour 45, 00184 Roma, Italie" class="w-full px-3 py-2 bg-slate-50 border-2 border-slate-200 rounded-xl font-bold text-xs">
        </div>
      </div>

      <div class="bg-rose-50 border-2 border-rose-200 rounded-2xl p-4 mb-4">
        <div class="text-xs font-black uppercase text-rose-800 tracking-wider mb-2">🚨 Numéros d'urgence officiels intégrés</div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs font-bold text-rose-900">
          <div class="bg-white p-2.5 rounded-xl border border-rose-200">
            <span class="text-slate-500 block text-[10px]">POLICE :</span>
            <span class="text-base font-black text-rose-700">112 / 113</span>
          </div>
          <div class="bg-white p-2.5 rounded-xl border border-rose-200">
            <span class="text-slate-500 block text-[10px]">SAMU / MÉDICAL :</span>
            <span class="text-base font-black text-rose-700">118</span>
          </div>
          <div class="bg-white p-2.5 rounded-xl border border-rose-200">
            <span class="text-slate-500 block text-[10px]">AMBASSADE FR :</span>
            <span class="text-xs font-black text-rose-700">+39 06 68 60 11</span>
          </div>
        </div>
      </div>

      <div class="flex flex-wrap gap-3">
        <button onclick="downloadOfflineHandbook()" class="btn-3d btn-3d-green py-2.5 px-5 text-xs flex-1">
          📥 TÉLÉCHARGER LE CARNET HORS-LIGNE (.HTML)
        </button>
        <button onclick="window.print()" class="btn-3d btn-3d-white py-2.5 px-5 text-xs">
          🖨️ IMPRIMER / PDF
        </button>
      </div>
    </div>
  </section>

  <!-- ============================================== -->
  <!-- ONGLET 6 : QUÊTE ANTI-ARNAQUE GAMIFIÉE         -->
  <!-- ============================================== -->
  <section id="tab-security" class="hidden space-y-6">
    <div class="card-duo p-6">
      <div class="flex flex-col md:flex-row md:items-center justify-between pb-5 border-b-2 border-slate-100 gap-4 mb-6">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 rounded-2xl bg-orange-100 text-orange-600 flex items-center justify-center font-black text-2xl">🛡️</div>
          <div>
            <h3 class="text-lg font-black text-slate-800">Quête Sécurité : Bouclier Anti-Arnaque</h3>
            <p class="text-xs font-bold text-slate-400">Valide les 4 points de contrôle avant de verser le moindre euro</p>
          </div>
        </div>
        <div class="w-full md:w-64">
          <div class="flex justify-between text-xs font-black text-slate-500 uppercase tracking-wider mb-1.5">
            <span>Sécurité du deal</span>
            <span id="scamPercentText" class="text-emerald-600">0%</span>
          </div>
          <div class="progress-pill h-4">
            <div id="scamProgressBar" class="progress-pill-bar" style="width: 0%;"></div>
          </div>
        </div>
      </div>

      <div class="space-y-3">
        <label class="card-duo card-duo-interactive p-4 flex items-start gap-3 cursor-pointer select-none">
          <input type="checkbox" id="checkScam1" onchange="updateScamProgress()" class="mt-1 w-5 h-5 rounded-lg text-emerald-500 focus:ring-0 border-2 border-slate-300">
          <div>
            <div class="text-sm font-black text-slate-800">1. Paiement 100% à l'intérieur de la plateforme officielle</div>
            <p class="text-xs font-bold text-slate-500 mt-0.5">L'hôte ne t'a jamais demandé de virement direct (IBAN), mandat Western Union, PayPal entre amis ou lien externe par WhatsApp.</p>
          </div>
        </label>
        <label class="card-duo card-duo-interactive p-4 flex items-start gap-3 cursor-pointer select-none">
          <input type="checkbox" id="checkScam2" onchange="updateScamProgress()" class="mt-1 w-5 h-5 rounded-lg text-emerald-500 focus:ring-0 border-2 border-slate-300">
          <div>
            <div class="text-sm font-black text-slate-800">2. Profil de l'hôte vérifié avec historique d'avis réels</div>
            <p class="text-xs font-bold text-slate-500 mt-0.5">Le logement ou l'hôte possède plusieurs avis détaillés étalés dans le temps, ou le statut Superhost / Préférence Voyageurs.</p>
          </div>
        </label>
        <label class="card-duo card-duo-interactive p-4 flex items-start gap-3 cursor-pointer select-none">
          <input type="checkbox" id="checkScam3" onchange="updateScamProgress()" class="mt-1 w-5 h-5 rounded-lg text-emerald-500 focus:ring-0 border-2 border-slate-300">
          <div>
            <div class="text-sm font-black text-slate-800">3. Cohérence du tarif avec le marché local</div>
            <p class="text-xs font-bold text-slate-500 mt-0.5">Le prix n'est pas "trop beau pour être vrai" (par exemple un loft de 100m² avec vue Colisée à 35€/nuit en plein mois d'août).</p>
          </div>
        </label>
        <label class="card-duo card-duo-interactive p-4 flex items-start gap-3 cursor-pointer select-none">
          <input type="checkbox" id="checkScam4" onchange="updateScamProgress()" class="mt-1 w-5 h-5 rounded-lg text-emerald-500 focus:ring-0 border-2 border-slate-300">
          <div>
            <div class="text-sm font-black text-slate-800">4. Photos authentiques et vérification Street View</div>
            <p class="text-xs font-bold text-slate-500 mt-0.5">L'adresse fournie existe bien sur Google Maps / Street View et la vue correspond à l'environnement décrit.</p>
          </div>
        </label>
      </div>

      <div id="scamSuccessBox" class="hidden mt-6 bg-emerald-50 border-2 border-emerald-300 border-b-4 rounded-2xl p-4 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <span class="text-3xl">🏆</span>
          <div>
            <div class="text-sm font-black text-emerald-800 uppercase tracking-wide">Bouclier 100% Activé !</div>
            <div class="text-xs font-bold text-emerald-600">Bravo ! Tu as validé tous les critères. Tu gagnes +50 XP et une réservation sans stress !</div>
          </div>
        <button onclick="claimXp(this)" id="btnClaimXp" class="btn-3d btn-3d-green py-2 px-4 text-xs">RÉCLAMER XP</button>
      </div>
    </div>
  </section>

  <!-- ============================================== -->
  <!-- ONGLET 7 : RAPPEL CALENDRIER (.ICS)           -->
  <!-- ============================================== -->
  <section id="tab-calendar" class="hidden space-y-6">
    <div class="card-duo p-6">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-10 h-10 rounded-xl bg-purple-100 text-purple-600 flex items-center justify-center font-black text-xl">📅</div>
        <div>
          <h3 class="text-base font-black text-slate-800">Générateur de Rappels d'Annulation Gratuite (.ics)</h3>
          <p class="text-xs font-bold text-slate-400">Compatible Google Agenda, Apple Calendar, Microsoft Outlook</p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
        <div>
          <label class="block text-xs font-black text-slate-500 uppercase mb-1">Nom de l'hôtel / Logement</label>
          <input type="text" id="icsHotelName" value="Hôtel Splendido & Suites" 
            class="w-full px-4 py-2.5 bg-slate-50 border-2 border-slate-200 rounded-xl font-bold text-slate-800 text-sm focus:outline-none focus:border-purple-400">
        </div>
        <div>
          <label class="block text-xs font-black text-slate-500 uppercase mb-1">Date limite d'annulation gratuite</label>
          <input type="date" id="icsDeadlineDate" 
            class="w-full px-4 py-2.5 bg-slate-50 border-2 border-slate-200 rounded-xl font-bold text-slate-800 text-sm focus:outline-none focus:border-purple-400">
        </div>
      </div>

      <button onclick="downloadIcsFile()" class="btn-3d btn-3d-purple w-full py-3 text-sm">
        📥 Télécharger l'événement pour mon agenda (.ics)
      </button>
    </div>
  </section>

  <!-- ============================================== -->
  <!-- ONGLET 8 : DISTANCE & WALK SCORE CALCULATOR    -->
  <!-- ============================================== -->
  <section id="tab-walkscore" class="hidden space-y-6">
    <div class="card-duo p-6">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-10 h-10 rounded-xl bg-purple-100 text-purple-700 flex items-center justify-center font-black text-xl">🚶</div>
        <div>
          <h3 class="text-base font-black text-slate-800">Calculateur de Distance Piétonne &amp; Walk Score (OSRM / OpenStreetMap)</h3>
          <p class="text-xs font-bold text-slate-400">Mesurez le temps de marche réel entre un hébergement et votre point de repère (100% gratuit, sans clé)</p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
        <div>
          <label class="block text-xs font-black text-slate-500 uppercase mb-1">🏠 Adresse ou Nom de l'Hébergement</label>
          <input type="text" id="wsOrigin" value="Via Cavour 45, Rome" placeholder="Ex: Via Cavour 45, Rome" 
            class="w-full px-4 py-2.5 bg-slate-50 border-2 border-slate-200 rounded-xl font-bold text-slate-800 text-xs focus:outline-none focus:border-purple-400">
        </div>
        <div>
          <label class="block text-xs font-black text-slate-500 uppercase mb-1">🎯 Point de Repère / Monument Cible</label>
          <input type="text" id="wsTarget" value="Colisée, Rome" placeholder="Ex: Colisée, Rome ou Tour Eiffel" 
            class="w-full px-4 py-2.5 bg-slate-50 border-2 border-slate-200 rounded-xl font-bold text-slate-800 text-xs focus:outline-none focus:border-purple-400">
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-3 mb-5">
        <button onclick="computeWalkScoreLive()" id="btnComputeWs" class="btn-3d btn-3d-purple py-3 px-6 text-xs flex-1 sm:flex-none">
          🚶 CALCULER LE TRAJET PIÉTON RÉEL
        </button>
        <button type="button" onclick="syncWalkScoreWithSearch()" class="btn-3d btn-3d-white py-3 px-4 text-xs" title="Synchroniser l'adresse avec la destination et le repère actifs de votre recherche">
          📍 Synchroniser avec ma recherche
        </button>
        <button onclick="openGoogleMapsWalkRoute()" class="btn-3d btn-3d-blue py-3 px-4 text-xs">
          🗺️ ITINÉRAIRE GOOGLE MAPS ↗
        </button>
        <button onclick="openOsmRoute()" class="btn-3d btn-3d-white py-3 px-4 text-xs">
          🌍 OPENSTREETMAP ↗
        </button>
      </div>

      <!-- Résultat Walk Score -->
      <div id="wsResultBox" class="bg-purple-50 border-2 border-purple-200 rounded-2xl p-5">
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
          <div>
            <div class="flex items-center gap-2 mb-1">
              <span class="text-xs font-black uppercase text-purple-700">Indice d'Accessibilité Piétonne</span>
              <span id="wsScoreBadge" class="bg-emerald-500 text-white text-xs font-black px-2.5 py-0.5 rounded-full">Score : 9.5 / 10</span>
            </div>
            <div class="text-base font-black text-slate-800" id="wsVerdictText">Emplacement exceptionnel : Tout se fait facilement à pied !</div>
            <p class="text-xs font-bold text-slate-500 mt-1" id="wsDetailText">Distance de marche : ~1.1 km • Durée estimée : ~14 minutes à pied</p>
          </div>
          
          <div class="text-center sm:text-right shrink-0 bg-white border border-purple-200 rounded-xl px-4 py-2 shadow-sm">
            <div class="text-[10px] font-black uppercase text-slate-400">Temps de marche</div>
            <div class="text-2xl font-black text-purple-700" id="wsMinutesText">14 min</div>
            <div class="text-[10px] font-bold text-emerald-600">0 € de transport</div>
          </div>
        </div>

        <!-- Jauge d'accessibilité -->
        <div class="mt-4 pt-3 border-t border-purple-200">
          <div class="flex justify-between text-[10px] font-black uppercase text-slate-500 mb-1.5">
            <span>Accessibilité Piétonne</span>
            <span id="wsScorePercentText">95%</span>
          </div>
          <div class="progress-pill h-3.5">
            <div id="wsProgressBar" class="progress-pill-bar bg-emerald-500" style="width: 95%;"></div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ======================================================== -->
  <!-- MODAL : FICHE RÉCAPITULATIVE DU SÉJOUR (IMPRESSION / PDF) -->
  <!-- ======================================================== -->
  <div id="tripSummaryModal" class="hidden fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-3 md:p-6 overflow-y-auto" onclick="if(event.target===this)closeTripSummaryModal()">
    <div class="bg-white rounded-3xl border-2 border-slate-200 shadow-2xl max-w-4xl w-full max-h-[90vh] flex flex-col overflow-hidden">
      <!-- En-tête de la modale -->
      <div class="p-4 md:p-5 border-b-2 border-slate-100 flex items-center justify-between bg-slate-50 no-print">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-2xl bg-indigo-100 text-indigo-700 flex items-center justify-center font-black text-xl">📄</div>
          <div>
            <h3 class="text-base md:text-lg font-black text-slate-800">Fiche Récapitulative du Séjour</h3>
            <p class="text-xs font-bold text-slate-400">Synthèse imprimable et exportable en PDF pour les voyageurs</p>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <button type="button" onclick="window.print()" class="btn-3d btn-3d-green text-xs py-2 px-3.5 flex items-center gap-1.5 cursor-pointer">
            🖨️ Imprimer / Sauvegarder PDF
          </button>
          <button type="button" onclick="closeTripSummaryModal()" class="w-8 h-8 rounded-full bg-slate-200 hover:bg-slate-300 text-slate-700 font-black flex items-center justify-center cursor-pointer transition-colors" title="Fermer">
            ✕
          </button>
        </div>
      </div>

      <!-- Corps imprimable -->
      <div id="tripSummaryModalBody" class="p-4 md:p-8 overflow-y-auto space-y-6">
        <!-- Rempli dynamiquement par renderTripSummaryContent() -->
      </div>
      
      <!-- Pied de la modale -->
      <div class="p-4 border-t-2 border-slate-100 bg-slate-50 flex items-center justify-between text-xs text-slate-500 font-bold no-print">
        <span>💡 Astuce : Dans la boîte d'impression, choisissez « Enregistrer au format PDF ».</span>
        <button type="button" onclick="closeTripSummaryModal()" class="btn-3d btn-3d-white text-xs py-1.5 px-4 cursor-pointer">
          Fermer
        </button>
      </div>
    </div>
  </div>

  <!-- ======================================================== -->
  <!-- MODAL : WISHLIST / FAVORIS VOYAGEURS (COMPARATEUR FINAL) -->
  <!-- ======================================================== -->
  <div id="favoritesModal" class="hidden fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-3 md:p-6 overflow-y-auto" onclick="if(event.target===this)closeFavoritesModal()">
    <div class="bg-white rounded-3xl border-2 border-slate-200 shadow-2xl max-w-4xl w-full max-h-[90vh] flex flex-col overflow-hidden">
      <div class="p-4 md:p-5 border-b-2 border-slate-100 flex items-center justify-between bg-rose-50/50">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-2xl bg-rose-100 text-rose-600 flex items-center justify-center font-black text-xl">❤️</div>
          <div>
            <h3 class="text-base md:text-lg font-black text-slate-800">Mes Hébergements Coups de Cœur</h3>
            <p class="text-xs font-bold text-slate-400">Votre sélection personnelle sauvegardée pour ce séjour</p>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <button type="button" onclick="clearAllFavorites()" class="btn-3d btn-3d-white text-xs py-1.5 px-3 text-rose-600 hover:text-rose-700 cursor-pointer">
            🗑️ Tout vider
          </button>
          <button type="button" onclick="closeFavoritesModal()" class="w-8 h-8 rounded-full bg-slate-200 hover:bg-slate-300 text-slate-700 font-black flex items-center justify-center cursor-pointer transition-colors" title="Fermer">
            ✕
          </button>
        </div>
      </div>

      <div id="favoritesModalBody" class="p-4 md:p-6 overflow-y-auto space-y-4">
        <!-- État vide si aucun favori -->
        <div id="favoritesEmptyState" class="hidden text-center py-8">
          <div class="w-14 h-14 mx-auto mb-3 bg-rose-50 border-2 border-rose-200 text-rose-500 rounded-2xl flex items-center justify-center text-2xl shadow-xs">
            🤍
          </div>
          <h4 class="text-sm font-black text-slate-700 dark:text-white mb-1">Aucun coup de cœur pour l'instant</h4>
          <p class="text-xs text-slate-400 font-semibold max-w-sm mx-auto">Cliquez sur le cœur ❤️ d'un hébergement pour l'ajouter à vos favoris et suivre ses baisses de tarifs en direct.</p>
        </div>

        <!-- Liste des cartes de favoris -->
        <div id="favoritesListContainer" class="space-y-3"></div>
      </div>

      <div class="p-4 border-t-2 border-slate-100 bg-slate-50 flex items-center justify-between text-xs text-slate-500 font-bold">
        <span>💡 Retrouvez vos favoris à tout moment, même après rechargement de la page.</span>
        <button type="button" onclick="closeFavoritesModal()" class="btn-3d btn-3d-white text-xs py-1.5 px-4 cursor-pointer">
          Fermer
        </button>
      </div>
    </div>
  </div>

  <!-- ======================================================== -->
  <!-- MODAL : TABLEAU DE BORD PARTENAIRE & AFFILIATION (ADMIN) -->
  <!-- ======================================================== -->
  <div id="affiliateAdminModal" class="hidden fixed inset-0 z-50 bg-slate-900/70 backdrop-blur-xs flex items-center justify-center p-3 md:p-6 overflow-y-auto" onclick="if(event.target===this)closeAffiliateAdminModal()">
    <div class="bg-white rounded-3xl border-2 border-slate-200 shadow-2xl max-w-4xl w-full max-h-[92vh] flex flex-col overflow-hidden">
      <div class="p-4 md:p-5 border-b-2 border-slate-100 flex items-center justify-between bg-amber-50/60">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-2xl bg-amber-100 text-amber-800 flex items-center justify-center font-black text-xl">📊</div>
          <div>
            <div class="flex items-center gap-2">
              <h3 class="text-base md:text-lg font-black text-slate-800">Tableau de Bord Partenaire &amp; Monétisation</h3>
              <span class="bg-emerald-100 text-emerald-800 border border-emerald-300 text-[10px] font-black px-2 py-0.5 rounded-full">SaaS Pro</span>
            </div>
            <p class="text-xs font-bold text-slate-400">Suivi des clics sortants, volume d'affaires et configuration des identifiants partenaires</p>
          </div>
        </div>
        <button type="button" onclick="closeAffiliateAdminModal()" class="w-8 h-8 rounded-full bg-slate-200 hover:bg-slate-300 text-slate-700 font-black flex items-center justify-center cursor-pointer transition-colors" title="Fermer">
          ✕
        </button>
      </div>

      <div class="p-4 md:p-6 overflow-y-auto space-y-6">
        <!-- 4 Cartes de métriques clés -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          <div class="bg-blue-50 border-2 border-blue-200 rounded-2xl p-3">
            <span class="block text-[10px] font-black uppercase text-blue-500">Total Clics Sortants</span>
            <span class="text-xl md:text-2xl font-black text-blue-900" id="adminTotalClicks">0</span>
            <span class="block text-[10px] font-bold text-blue-600 mt-0.5">Vers les 10 OTA</span>
          </div>
          <div class="bg-emerald-50 border-2 border-emerald-200 rounded-2xl p-3">
            <span class="block text-[10px] font-black uppercase text-emerald-600">Top Plateforme</span>
            <span class="text-sm md:text-base font-black text-emerald-900 truncate block" id="adminTopPlatform">En attente</span>
            <span class="block text-[10px] font-bold text-emerald-700 mt-0.5" id="adminTopPlatformClicks">0 clic</span>
          </div>
          <div class="bg-purple-50 border-2 border-purple-200 rounded-2xl p-3">
            <span class="block text-[10px] font-black uppercase text-purple-600">Top Destination</span>
            <span class="text-sm md:text-base font-black text-purple-900 truncate block" id="adminTopDest">En attente</span>
            <span class="block text-[10px] font-bold text-purple-700 mt-0.5" id="adminTopDestClicks">0 clic</span>
          </div>
          <div class="bg-amber-50 border-2 border-amber-200 rounded-2xl p-3">
            <span class="block text-[10px] font-black uppercase text-amber-700">Commissions Estimées</span>
            <span class="text-xl md:text-2xl font-black text-amber-900" id="adminEstRevenue">0 €</span>
            <span class="block text-[10px] font-bold text-amber-700 mt-0.5">Basé sur ~3.5% panier</span>
          </div>
        </div>

        <!-- Formulaire de configuration des identifiants d'affiliation -->
        <div class="bg-slate-50 border-2 border-slate-200 rounded-2xl p-4 md:p-5">
          <div class="flex items-center justify-between mb-3">
            <div class="text-xs font-black uppercase text-slate-700 tracking-wider">⚙️ Paramétrage des Identifiants Partenaires</div>
            <span class="text-[11px] font-bold text-slate-400">Injectés automatiquement dans 100% des liens</span>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5 text-xs">
            <div>
              <label class="block font-black text-slate-600 mb-1">Booking.com Affiliate ID (aid)</label>
              <input type="text" id="affBookingAid" class="w-full px-3 py-2 bg-white border-2 border-slate-200 rounded-xl font-mono text-xs">
            </div>
            <div>
              <label class="block font-black text-slate-600 mb-1">Booking.com Label de Campagne</label>
              <input type="text" id="affBookingLabel" class="w-full px-3 py-2 bg-white border-2 border-slate-200 rounded-xl font-mono text-xs">
            </div>
            <div>
              <label class="block font-black text-slate-600 mb-1">Agoda Partner CID</label>
              <input type="text" id="affAgodaCid" class="w-full px-3 py-2 bg-white border-2 border-slate-200 rounded-xl font-mono text-xs">
            </div>
            <div>
              <label class="block font-black text-slate-600 mb-1">Expedia Group Camref / CID</label>
              <input type="text" id="affExpediaCamref" class="w-full px-3 py-2 bg-white border-2 border-slate-200 rounded-xl font-mono text-xs">
            </div>
            <div>
              <label class="block font-black text-slate-600 mb-1">Airbnb Partner Ref</label>
              <input type="text" id="affAirbnbRef" class="w-full px-3 py-2 bg-white border-2 border-slate-200 rounded-xl font-mono text-xs">
            </div>
            <div class="flex items-center gap-2 pt-5">
              <label class="flex items-center gap-2 cursor-pointer font-bold text-slate-700">
                <input type="checkbox" id="affGoogleUtm" class="w-4 h-4 rounded text-blue-600">
                <span>Activer tags UTM sur Google Travel &amp; Métamoteurs</span>
              </label>
