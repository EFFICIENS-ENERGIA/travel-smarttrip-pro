            <span>🌐 Fiche Google</span><span class="text-[9px]">↗</span>
          </a>
          <a id="hdmBtnDirect" href="#" target="_blank" rel="noopener noreferrer" class="btn-3d btn-3d-blue text-xs py-2 px-4 flex items-center gap-1.5 font-black shadow-sm cursor-pointer">
            <span id="hdmDirectBtnText">Voir sur Booking</span><span class="text-[9px]">↗</span>
          </a>
