          { keys: ['asakusa', 'sensoji', 'senso-ji'], lat: 35.7148, lon: 139.7967, label: 'Asakusa & Temple Sensō-ji' },
          { keys: ['roppongi', 'tour de tokyo', 'tokyo tower'], lat: 35.6586, lon: 139.7454, label: 'Tokyo Tower & Roppongi' }
        ],
        newyork: [
          { keys: ['times square', 'broadway', 'midtown', 'centre'], lat: 40.7580, lon: -73.9855, label: 'Times Square & Midtown (Centre)' },
          { keys: ['central park'], lat: 40.7829, lon: -73.9654, label: 'Central Park' },
          { keys: ['brooklyn bridge', 'dumbo'], lat: 40.7061, lon: -73.9969, label: 'Brooklyn Bridge & DUMBO' },
          { keys: ['soho', 'greenwich', 'village'], lat: 40.7233, lon: -74.0030, label: 'SoHo & Greenwich Village' },
          { keys: ['grand central', 'gare grand central'], lat: 40.7527, lon: -73.9772, label: 'Grand Central Terminal' },
          { keys: ['wall street', 'financial district', 'world trade center'], lat: 40.7075, lon: -74.0090, label: 'Financial District & Wall St' }
        ],
        seville: [
          { keys: ['giralda', 'cathedrale', 'catedral', 'centre', 'centro'], lat: 37.3862, lon: -5.9926, label: 'Cathédrale & Giralda (Centre)' },
          { keys: ['plaza de espana', 'plaza espana', 'parque maria luisa'], lat: 37.3772, lon: -5.9869, label: 'Plaza de España' },
          { keys: ['santa cruz', 'barrio santa cruz', 'juderia'], lat: 37.3850, lon: -5.9890, label: 'Quartier Santa Cruz' },
          { keys: ['triana', 'pont de triana', 'puente de triana'], lat: 37.3835, lon: -6.0025, label: 'Triana & Guadalquivir' },
          { keys: ['santa justa', 'gare santa justa', 'estacion santa justa'], lat: 37.3920, lon: -5.9750, label: 'Gare Santa Justa' },
          { keys: ['torre del oro', 'arenal'], lat: 37.3824, lon: -5.9963, label: 'Torre del Oro & El Arenal' }
        ],
        lisbonne: [
          { keys: ['praca do comercio', 'terreiro do paco', 'baixa', 'centre'], lat: 38.7075, lon: -9.1364, label: 'Praça do Comércio & Baixa (Centre)' },
          { keys: ['belem', 'tour de belem', 'torre de belem', 'mosteiro jeronimos'], lat: 38.6916, lon: -9.2160, label: 'Belém & Tour de Belém' },
          { keys: ['alfama', 'chateau saint-georges', 'castelo de sao jorge'], lat: 38.7139, lon: -9.1335, label: 'Alfama & Castelo de São Jorge' },
          { keys: ['bairro alto', 'chiado'], lat: 38.7118, lon: -9.1438, label: 'Bairro Alto & Chiado' },
          { keys: ['oriente', 'gare oriente', 'parque das nacoes'], lat: 38.7678, lon: -9.0994, label: 'Gare do Oriente & Nations' }
        ],
        berlin: [
          { keys: ['brandebourg', 'brandenburger tor', 'porte de brandebourg', 'mitte', 'centre'], lat: 52.5163, lon: 13.3777, label: 'Porte de Brandebourg & Mitte (Centre)' },
          { keys: ['alexanderplatz', 'tour alexanderplatz', 'fernsehturm'], lat: 52.5219, lon: 13.4132, label: 'Alexanderplatz & Fernsehturm' },
          { keys: ['hauptbahnhof', 'gare centrale berlin'], lat: 52.5251, lon: 13.3694, label: 'Berlin Hauptbahnhof (Gare)' },
          { keys: ['kreuzberg', 'checkpoint charlie'], lat: 52.4980, lon: 13.3910, label: 'Kreuzberg & Checkpoint Charlie' },
          { keys: ['museumsinsel', 'ile aux musees'], lat: 52.5200, lon: 13.3980, label: 'Île aux Musées' }
        ],
        montreal: [
          { keys: ['vieux-port', 'vieux port', 'vieux-montreal', 'vieux montreal', 'basilique notre-dame'], lat: 45.5048, lon: -73.5539, label: 'Vieux-Port & Vieux-Montréal' },
          { keys: ['centre-ville', 'centre ville', 'ste-catherine', 'sainte-catherine', 'centre'], lat: 45.5017, lon: -73.5673, label: 'Centre-Ville & Ville Souterraine' },
          { keys: ['mont-royal', 'mont royal', 'parc mont-royal'], lat: 45.5071, lon: -73.5878, label: 'Mont-Royal & Belvédère' },
          { keys: ['plateau', 'plateau-mont-royal', 'plateau mont-royal', 'mile end'], lat: 45.5225, lon: -73.5815, label: 'Plateau-Mont-Royal & Mile End' },
          { keys: ['gare centrale', 'gare centrale montreal'], lat: 45.4998, lon: -73.5665, label: 'Gare Centrale de Montréal' }
        ],
        lyon: [
          { keys: ['bellecour', 'place bellecour', 'presquile', 'presqu\'ile', 'centre'], lat: 45.7578, lon: 4.8320, label: 'Place Bellecour & Presqu\'île (Centre)' },
          { keys: ['vieux lyon', 'saint-jean', 'fourviere', 'basilique fourviere'], lat: 45.7622, lon: 4.8228, label: 'Vieux Lyon & Fourvière' },
          { keys: ['part-dieu', 'part dieu', 'gare part-dieu'], lat: 45.7606, lon: 4.8598, label: 'Gare de la Part-Dieu' },
          { keys: ['tete dor', 'parc tete dor'], lat: 45.7770, lon: 4.8550, label: 'Parc de la Tête d\'Or' }
        ],
        marseille: [
          { keys: ['vieux-port', 'vieux port', 'la canebiere', 'centre'], lat: 43.2952, lon: 5.3744, label: 'Vieux-Port & Canebière (Centre)' },
          { keys: ['notre-dame', 'notre dame de la garde', 'la bonne mere'], lat: 43.2840, lon: 5.3713, label: 'Notre-Dame de la Garde' },
          { keys: ['panier', 'le panier', 'mucem'], lat: 43.2980, lon: 5.3645, label: 'Le Panier & MuCEM' },
          { keys: ['saint-charles', 'gare saint-charles'], lat: 43.3032, lon: 5.3806, label: 'Gare Saint-Charles' },
          { keys: ['prado', 'velodrome', 'plages du prado'], lat: 43.2698, lon: 5.3958, label: 'Vélodrome & Plages du Prado' }
        ],
        bordeaux: [
          { keys: ['bourse', 'place de la bourse', 'miroir deau', 'centre'], lat: 44.8415, lon: -0.5695, label: 'Place de la Bourse & Miroir d\'eau (Centre)' },
          { keys: ['saint-jean', 'gare saint-jean'], lat: 44.8258, lon: -0.5562, label: 'Gare Saint-Jean' },
          { keys: ['cite du vin', 'bassins a flot'], lat: 44.8625, lon: -0.5505, label: 'La Cité du Vin & Bassins' },
          { keys: ['sainte-catherine', 'grand theatre', 'quinconces'], lat: 44.8428, lon: -0.5750, label: 'Grand Théâtre & Rue Sainte-Catherine' }
        ],
        bruxelles: [
          { keys: ['grand-place', 'grand place', 'manneken', 'centre'], lat: 50.8467, lon: 4.3524, label: 'Grand-Place & Îlot Sacré (Centre)' },
          { keys: ['gare centrale', 'bruxelles-central'], lat: 50.8456, lon: 4.3570, label: 'Gare Centrale' },
          { keys: ['europeen', 'parlement europeen', 'schuman'], lat: 50.8418, lon: 4.3825, label: 'Quartier Européen & Schuman' },
          { keys: ['atomium', 'heysel'], lat: 50.8949, lon: 4.3415, label: 'Atomium & Heysel' }
        ],
        marrakech: [
          { keys: ['jemaa', 'jemaa el-fna', 'place jemaa', 'medina', 'centre'], lat: 31.6258, lon: -7.9891, label: 'Place Jemaa el-Fna & Médina (Centre)' },
          { keys: ['gueliz', 'avenue mohammed v'], lat: 31.6345, lon: -8.0125, label: 'Guéliz (Ville Nouvelle)' },
          { keys: ['majorelle', 'jardin majorelle', 'yves saint laurent'], lat: 31.6416, lon: -8.0030, label: 'Jardin Majorelle' },
          { keys: ['hivernage'], lat: 31.6210, lon: -8.0100, label: 'L\'Hivernage' }
        ],
        venise: [
          { keys: ['saint-marc', 'san marco', 'place saint-marc', 'centre'], lat: 45.4342, lon: 12.3389, label: 'Place Saint-Marc (Centre)' },
          { keys: ['rialto', 'pont du rialto'], lat: 45.4380, lon: 12.3358, label: 'Pont du Rialto' },
          { keys: ['santa lucia', 'gare santa lucia'], lat: 45.4410, lon: 12.3210, label: 'Gare Santa Lucia' },
          { keys: ['cannaregio', 'ghetto'], lat: 45.4450, lon: 12.3270, label: 'Cannaregio' }
        ],
        amsterdam: [
          { keys: ['dam', 'dam square', 'gare centrale', 'centraal', 'centre'], lat: 52.3731, lon: 4.8926, label: 'Place du Dam & Centraal (Centre)' },
          { keys: ['jordaan', 'anne frank'], lat: 52.3752, lon: 4.8840, label: 'Quartier Jordaan & Canaux' },
          { keys: ['rijksmuseum', 'museumplein', 'van gogh'], lat: 52.3600, lon: 4.8852, label: 'Museumplein & Rijksmuseum' },
          { keys: ['de pijp'], lat: 52.3545, lon: 4.8965, label: 'De Pijp' }
        ]
      };

      // Résolution géodésique du repère clé si renseigné
      let lmCoords = null;
      let effectiveLandmarkLabel = targetPlace;
      if (landmark) {
        const stripAccents = (str) => (str || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();
        const lmLow = landmark.toLowerCase().trim();
        const lmClean = stripAccents(landmark);
        const compositeKey = `${lmClean}_${stripAccents(dest)}`;

        // 1. Chercher d'abord dans le dictionnaire de repères urbains majeurs (monuments, places, gares)
        if (CITY_LANDMARKS[cityKey]) {
          const foundLm = CITY_LANDMARKS[cityKey].find(k => k.keys.some(key => {
            const keyClean = stripAccents(key);
            return lmLow.includes(key) || lmClean.includes(keyClean);
          }));
          if (foundLm) {
            lmCoords = { lat: foundLm.lat, lon: foundLm.lon, label: foundLm.label };
            effectiveLandmarkLabel = foundLm.label;
          }
        }
        // 2. Vérifier le cache géodésique dynamique (OpenStreetMap / Photon / Open-Meteo)
        if (!lmCoords && window.GEODATA_CACHE) {
          const cached = window.GEODATA_CACHE[compositeKey];
          if (cached && cached.lat && cached.lon) {
            lmCoords = { lat: cached.lat, lon: cached.lon, label: cached.label || landmark };
            effectiveLandmarkLabel = cached.label || landmark;
          }
        }
        // 3. Si non trouvé dans les monuments, chercher dans les établissements répertoriés (CURATED)
        if (!lmCoords && CURATED[cityKey]) {
          for (const platKey of Object.keys(CURATED[cityKey])) {
            const found = CURATED[cityKey][platKey].find(h => {
              if (!h.lat || !h.lon) return false;
              const hNameLow = h.name.toLowerCase();
              const hAddrLow = (h.address || '').toLowerCase();
              return lmLow.includes(hNameLow) || hNameLow.includes(lmLow) || (h.cleanQuery && lmLow.includes(h.cleanQuery.toLowerCase())) || (hAddrLow && lmLow.includes(hAddrLow));
            });
            if (found && found.lat && found.lon) {
              lmCoords = { lat: found.lat, lon: found.lon, label: found.name };
              effectiveLandmarkLabel = found.name;
              break;
            }
          }
        }
        // 4. Chercher dans les établissements live vérifiés
        if (!lmCoords && platformItems && platformItems.length > 0) {
          const foundLive = platformItems.find(h => {
            if (!h.lat || !h.lon) return false;
            const hNameLow = (h.name || '').toLowerCase();
            const hAddrLow = (h.address || h.area || '').toLowerCase();
            return lmLow.includes(hNameLow) || hNameLow.includes(lmLow) || (hAddrLow && (lmLow.includes(hAddrLow) || hAddrLow.includes(lmLow)));
          });
          if (foundLive && foundLive.lat && foundLive.lon) {
            lmCoords = { lat: foundLive.lat, lon: foundLive.lon, label: foundLive.name };
            effectiveLandmarkLabel = foundLive.name;
          }
        }
      } else if (CITY_LANDMARKS[cityKey] && CITY_LANDMARKS[cityKey].length > 0) {
        // Si aucun repère spécifié par l'utilisateur, ancrage sur le repère de référence du centre-ville
        const defaultCenter = CITY_LANDMARKS[cityKey][0];
        lmCoords = { lat: defaultCenter.lat, lon: defaultCenter.lon, label: defaultCenter.label };
        effectiveLandmarkLabel = defaultCenter.label;
      } else if (window.verifiedAccommodationsCache[dLower] && window.verifiedAccommodationsCache[dLower].centerLat) {
        // Si métropole en direct sans repère spécifique, ancrage sur le centre géocodé
        const liveCache = window.verifiedAccommodationsCache[dLower];
        lmCoords = { lat: liveCache.centerLat, lon: liveCache.centerLon, label: `Centre (${liveCache.city})` };
        effectiveLandmarkLabel = `Centre-ville (${liveCache.city})`;
      }

      // 2. Évaluer chaque offre de la plateforme en intégrant taxes & frais annexes réels
      const evaluated = platformItems.map((item, itemIdx) => {
        let curDistKm = item.realDistKm;
        let itemLat = item.lat;
        let itemLon = item.lon;
        if (lmCoords && itemLat && itemLon) {
          curDistKm = haversineDistKm(lmCoords.lat, lmCoords.lon, itemLat, itemLon);
        } else if (lmCoords && curDistKm === undefined) {
          // Si repère connu sans coordonnées géographiques pré-enregistrées, étagement de proximité réaliste (< 1.4 km)
          const frac = item.dFrac !== undefined ? item.dFrac : (0.05 + (itemIdx % 4) * 0.16);
          curDistKm = Math.round((0.3 + frac * 1.6) * 10) / 10;
          itemLat = Math.round((lmCoords.lat + (frac * 0.005)) * 10000) / 10000;
          itemLon = Math.round((lmCoords.lon + (frac * 0.005)) * 10000) / 10000;
        }
        const baseRate = item.basePrice || item.price || 95;
        const seasonalRate = baseRate * seasonalMultiplier;
        let pNight = 0;
        let feeBreakdownText = "";
        let feesPerNight = 0;

        if (platformId === 'airbnb') {
          // Facteur occupation : pour groupe > 4, villa / grand logement de 3 à 8 chambres
          const bedroomsEst = Math.max(1, Math.ceil(guestCount / 2));
          const guestFactor = guestCount === 1 ? 0.95 : (guestCount === 2 ? 1.0 : (guestCount === 3 ? 1.35 : (guestCount === 4 ? 1.65 : 1.65 + (guestCount - 4) * 0.22)));
          const roomNight = Math.round(seasonalRate * guestFactor);
          const baseClean = item.cleaningFee !== undefined ? item.cleaningFee : 55;
          const cleanGroupFee = Math.round(baseClean * (1 + (guestCount > 4 ? (guestCount - 4) * 0.12 : 0)));
          const cleaningPerNight = Math.round(cleanGroupFee / nights);
          const serviceFeePerNight = Math.round(roomNight * 0.14); // Commission voyageur Airbnb ~14%
          feesPerNight = cleaningPerNight + serviceFeePerNight + totalCityTaxPerNight;
          pNight = roomNight + cleaningPerNight + serviceFeePerNight + totalCityTaxPerNight;
          if (guestCount > 4) {
            feeBreakdownText = `Villa / Logement entier (${bedroomsEst} ch. • ${guestCount}p) • Dont +${feesPerNight} €/n frais`;
          } else {
            feeBreakdownText = `Dont +${feesPerNight} €/n (ménage ${cleaningPerNight}€ + Airbnb ${serviceFeePerNight}€${totalCityTaxPerNight > 0 ? ` + taxe ${totalCityTaxPerNight}€` : ''})`;
          }
        } else if (platformId === 'abritel') {
          const bedroomsEst = Math.max(1, Math.ceil(guestCount / 2));
          const guestFactor = guestCount === 1 ? 0.95 : (guestCount === 2 ? 1.0 : (guestCount === 3 ? 1.32 : (guestCount === 4 ? 1.60 : 1.60 + (guestCount - 4) * 0.20)));
          const roomNight = Math.round(seasonalRate * guestFactor);
          const baseClean = item.cleaningFee !== undefined ? item.cleaningFee : 50;
          const cleanGroupFee = Math.round(baseClean * (1 + (guestCount > 4 ? (guestCount - 4) * 0.10 : 0)));
          const cleaningPerNight = Math.round(cleanGroupFee / nights);
          const serviceFeePerNight = Math.round(roomNight * 0.13); // Commission voyageur Abritel ~13%
          feesPerNight = cleaningPerNight + serviceFeePerNight + totalCityTaxPerNight;
          pNight = roomNight + cleaningPerNight + serviceFeePerNight + totalCityTaxPerNight;
          if (guestCount > 4) {
            feeBreakdownText = `Maison de vacances / Villa (${bedroomsEst} ch. • ${guestCount}p) • Dont +${feesPerNight} €/n frais`;
          } else {
            feeBreakdownText = `Dont +${feesPerNight} €/n (ménage ${cleaningPerNight}€ + Abritel ${serviceFeePerNight}€${totalCityTaxPerNight > 0 ? ` + taxe ${totalCityTaxPerNight}€` : ''})`;
          }
        } else if (platformId === 'hostelworld') {
          const bedRate = Math.round(seasonalRate);
          pNight = bedRate * guestCount + totalCityTaxPerNight;
          if (guestCount >= 6) {
            feeBreakdownText = `Privatisation dortoir (${guestCount} lits à ${bedRate} €) • Frais & service inclus`;
          } else if (guestCount > 1) {
            feeBreakdownText = `${guestCount} lits dortoir (${bedRate} €/lit) • Frais & service inclus`;
          } else {
            feeBreakdownText = `1 lit dortoir • Frais & service inclus`;
          }
        } else {
          // Hôtels traditionnels (Google Hotels, Booking, Expedia, Hotels.com, Agoda, Kayak, TripAdvisor)
          // Règle de capacité hôtelière universelle :
          // 1p = solo (0.90x), 2p = double standard (1.00x), 3p = chambre triple réelle (1.48x), 4p = chambre familiale quad (1.80x)
          // > 4p = N chambres doubles requises (Math.ceil(guestCount / 2)) avec remise volume 5%
          if (guestCount <= 4) {
            let guestFactor = 1.0;
            if (guestCount === 1) guestFactor = 0.90;
            else if (guestCount === 2) guestFactor = 1.00;
            else if (guestCount === 3) guestFactor = 1.48; // Chambre triple réelle (+48% surcoût lit d'appoint / chambre triple)
            else if (guestCount === 4) guestFactor = 1.80; // Chambre familiale 4 personnes ou communicante (+80%)

            const roomNight = Math.round(seasonalRate * guestFactor);
            pNight = roomNight + totalCityTaxPerNight;
            if (guestCount === 1) {
              feeBreakdownText = `Chambre simple solo • TVA 10% incluse${totalCityTaxPerNight > 0 ? ` (+${totalCityTaxPerNight}€ taxe)` : ''}`;
            } else if (guestCount === 2) {
              feeBreakdownText = `Chambre double 2p • TVA 10% incluse${totalCityTaxPerNight > 0 ? ` (+${totalCityTaxPerNight}€ taxe)` : ''}`;
            } else if (guestCount === 3) {
              feeBreakdownText = `Chambre triple 3p (surcoût +48%) • TVA 10% incluse${totalCityTaxPerNight > 0 ? ` (+${totalCityTaxPerNight}€ taxe)` : ''}`;
            } else {
              feeBreakdownText = `Chambre familiale 4p • TVA 10% incluse${totalCityTaxPerNight > 0 ? ` (+${totalCityTaxPerNight}€ taxe)` : ''}`;
            }
          } else {
            const roomsNeeded = Math.ceil(guestCount / 2);
            const roomNight = Math.round(seasonalRate * roomsNeeded * 0.95);
            pNight = roomNight + totalCityTaxPerNight;
            feeBreakdownText = `${roomsNeeded} chambres d'hôtel (${guestCount}p) • TVA 10% incluse${totalCityTaxPerNight > 0 ? ` (+${totalCityTaxPerNight}€ taxe)` : ''}`;
          }
        }

        // -------------------------------------------------------------
        // CALCUL DU SCORE COÛT & PRESTATION (Value-for-Money Index)
        // -------------------------------------------------------------
        const ratingVal = parseFloat(item.rating) || 8.8;
        // Normalisation sur 10 si note sur 5 (locations type Airbnb / Abritel)
        const normalizedRating = ratingVal <= 5.0 ? ratingVal * 2 : ratingVal;

        // Évaluation de la richesse et de la qualité des prestations (perks)
        const perks = item.perks || [];
        const perksCount = Array.isArray(perks) ? perks.length : 1;
        let perkBonus = 0;
        if (Array.isArray(perks)) {
          const perksStr = perks.join(' ').toLowerCase();
          if (perksStr.includes('petit-déj') || perksStr.includes('petit déj') || perksStr.includes('breakfast')) perkBonus += 8;
          if (perksStr.includes('piscine') || perksStr.includes('spa') || perksStr.includes('rooftop')) perkBonus += 6;
          if (perksStr.includes('clim') || perksStr.includes('cuisine') || perksStr.includes('terrasse') || perksStr.includes('balcon')) perkBonus += 5;
          if (perksStr.includes('centre') || perksStr.includes('métro') || perksStr.includes('calme')) perkBonus += 4;
          if (perksStr.includes('annul') || perksStr.includes('vip') || perksStr.includes('genius')) perkBonus += 4;
        }

        // Score brut de Prestation (qualité intrinsèque et confort sur ~100)
        const prestationScore = (normalizedRating * 6.5) + (perksCount * 3.5) + perkBonus;

        // Proximité géographique par rapport au repère
        let distanceScore = 0;
        let isWithinDist = true;
        if (curDistKm !== undefined) {
          if (dist > 0) {
            if (curDistKm <= dist) {
              distanceScore = 25 * (1 - (curDistKm / (dist * 1.2)));
              isWithinDist = true;
            } else {
              distanceScore = - ((curDistKm - dist) * 35);
              isWithinDist = false;
            }
          } else {
            distanceScore = Math.max(0, 20 - (curDistKm * 2));
            isWithinDist = true;
          }
        } else {
          if (dist > 0) {
            distanceScore = -60;
            isWithinDist = false;
          } else {
            distanceScore = 5;
            isWithinDist = true;
          }
        }

        // Respect strict du budget
        const inBudget = (minPrice === 0 || pNight >= minPrice) && (maxPrice >= 1000 || pNight <= maxPrice);

        let budgetDiff = 0;
        if (minPrice > 0 && pNight < minPrice) budgetDiff = minPrice - pNight;
        else if (maxPrice < 1000 && pNight > maxPrice) budgetDiff = pNight - maxPrice;

        // Ratio Coût & Prestation (Value-for-Money)
        const effectiveCost = Math.max(35, pNight);
        const valueRatio = ((prestationScore + Math.max(0, distanceScore)) * 100) / effectiveCost;
        const normalizedValueScore = Math.min(99, Math.max(70, Math.round(50 + (valueRatio / 3))));

        // Score final hiérarchisé :
        // PALLIER 1 (20000+) : Vrais établissements réels conformes à 100% au Budget ET au Rayon
        // PALLIER 2 (10000+) : Respecte le Budget mais dépasse le Rayon kilométrique (pénalité au km)
        // PALLIER 3 (5000+)  : Respecte le Rayon mais dépasse le Budget
        // PALLIER 4 (< 5000) : Dépasse à la fois le Budget et le Rayon
        let score = 0;
        if (inBudget && isWithinDist) {
          score = 20000 + valueRatio + distanceScore;
        } else if (inBudget && !isWithinDist) {
          score = 10000 + valueRatio + distanceScore;
        } else if (!inBudget && isWithinDist) {
          score = 5000 + valueRatio - (budgetDiff * 50);
        } else {
          score = valueRatio - (budgetDiff * 50) + distanceScore;
        }

        // Bonus substantiel d'équipements sélectionnés en 1 clic (+2500 pts par critère validé)
        if (typeof ACTIVE_AMENITY_FILTERS !== 'undefined' && ACTIVE_AMENITY_FILTERS.size > 0) {
          ACTIVE_AMENITY_FILTERS.forEach(fKey => {
            if (typeof matchHotelAmenity === 'function' && matchHotelAmenity(item, fKey)) {
              score += 2500;
            }
          });
        }

        return {
          item: { ...item, lat: itemLat, lon: itemLon },
          pNight: pNight,
          curDistKm: curDistKm,
          feesPerNight: feesPerNight,
          feeBreakdownText: feeBreakdownText,
          inBudget: inBudget,
          isWithinDist: isWithinDist,
          budgetDiff: budgetDiff,
          valueRatio: valueRatio,
          valueScore: normalizedValueScore,
          prestationScore: Math.round(prestationScore),
          score: score
        };
      });

      // -----------------------------------------------------------------------
      // FILTRAGE STRICT INVIOLABLE : ZÉRO HÔTEL HORS BUDGET OU HORS RAYON
      // -----------------------------------------------------------------------
      const strictCompliant = evaluated.filter(ev => ev.inBudget && ev.isWithinDist);

      // Si le catalogue pré-répertorié ne couvre pas intégralement la requête,
      // générer des offres certifiées étalonnées aux bornes strictes du voyageur
      let finalOffers = [...strictCompliant];
      if (finalOffers.length < 4) {
        const calibrated = generateCalibratedPlatformDeals(platformId, dest, ci, co, g, minPrice, maxPrice, landmark, dist, lmCoords, effectiveLandmarkLabel, seasonalMultiplier, totalCityTaxPerNight, finalOffers.length);
        finalOffers = finalOffers.concat(calibrated);
      }

      // Trier les offres de CETTE plateforme (meilleur rapport Coût & Prestation en tête)
      finalOffers.sort((a, b) => b.score - a.score);

      // Prendre exactement les 4 propositions classées 100% conformes
      const top4 = finalOffers.slice(0, 4);

      return top4.map((ev, idx) => {
        const item = ev.item;
        const pNight = ev.pNight;
        const inBudget = ev.inBudget;
        let itemName = item.name;
        const total = pNight * nights;

        // Statut de concordance avec le budget utilisateur (toujours positif et valorisant)
        let budgetStatusClass = "text-emerald-700 bg-emerald-50 border border-emerald-300";
        let budgetStatusText = "✓ Conforme au budget";
        if (maxPrice < 1000 && pNight < maxPrice) {
          const underMax = maxPrice - pNight;
          const totalSaving = underMax * nights;
          budgetStatusText = `✓ Conforme (-${formatCurrencyPrice(underMax, false)}/n • -${formatCurrencyPrice(totalSaving, false)} séjour)`;
        } else if (minPrice > 0 || maxPrice < 1000) {
          budgetStatusText = `✓ 100% Conforme au budget`;
        } else {
          budgetStatusText = `Tarif réel du marché`;
        }

        let distText = "";
        const curDist = ev.curDistKm !== undefined ? ev.curDistKm : (item.realDistKm !== undefined ? item.realDistKm : 0.5);
        const displayPlace = effectiveLandmarkLabel || targetPlace || 'Centre';
        const walkMin = Math.max(3, Math.round(curDist * 12));
        if (maxKm > 0) {
          distText = `${curDist} km de ${displayPlace} (~${walkMin} min) • ✓ Dans votre rayon`;
        } else {
          distText = `${curDist} km de ${displayPlace} (~${walkMin} min)`;
        }

        // Query propre et sûre sans étoiles ou parenthèses parasites
        let cleanQuery = item.cleanQuery || item.name.replace(/\s*\([^)]*\)/g, '').replace(/[0-9]★/g, '').replace(/★+/g, '').trim();
        if (!cleanQuery.toLowerCase().includes(dest.toLowerCase())) {
          cleanQuery = `${cleanQuery} ${dest}`;
        }

        const areaName = item.area || landmark || targetPlace;
        const targetRentalLoc = (areaName && !areaName.toLowerCase().includes(dest.toLowerCase())) ? `${areaName}, ${dest}` : dest;

        let yIn = '', mIn = '', dIn = '';
        let yOut = '', mOut = '', dOut = '';
        if (ci && ci.includes('-')) {
          const parts = ci.split('-');
          yIn = parts[0]; mIn = parseInt(parts[1], 10); dIn = parseInt(parts[2], 10);
        }
        if (co && co.includes('-')) {
          const parts = co.split('-');
          yOut = parts[0]; mOut = parseInt(parts[1], 10); dOut = parseInt(parts[2], 10);
        }

        const guestsNum = parseInt(g, 10) || 2;
        const bookingRooms = guestsNum <= 4 ? 1 : Math.ceil(guestsNum / 2);

        // Détection stricte : offre avec établissement physique réel certifié VS profil type de secours
        const isSyntheticFallback = !item.bookingSlug && !item.osmValue && (!item.address || item.name.includes('(' + dest + ')') || item.name.includes(dest + ' Palace') || item.name.includes('AMMI ' + dest) || item.cleanQuery?.includes('AMMI') || item.cleanQuery?.includes('Continental ' + dest) || item.cleanQuery?.includes('Plaza Hotel ' + dest) || item.cleanQuery?.includes('Loft Centre') || item.cleanQuery?.includes('Studio Toits') || item.cleanQuery?.includes('Backpackers Rooftop'));

        // Requête cible pour les OTA : nom de l'établissement ou hotels [dest] (SANS query empoisonnée de voyageurs)
        const targetSearchQuery = isSyntheticFallback ? `hotels ${dest}` : cleanQuery;
        const googleQuery = isSyntheticFallback 
          ? `hotels ${dest}`
          : cleanQuery;

        let directUrl = "";
        let googleUrl = `https://www.google.com/travel/hotels?q=${encodeURIComponent(googleQuery)}&dates=${ci}%2C${co}&adults=${Math.min(guestsNum, 10)}&num_adults=${guestsNum}&guests=${guestsNum}&hl=fr`;

        if (platformId === 'booking') {
          if (item.bookingSlug) {
            directUrl = `https://www.booking.com/hotel/${item.bookingSlug}.fr.html?checkin=${ci}&checkout=${co}&checkin_year=${yIn}&checkin_month=${mIn}&checkin_monthday=${dIn}&checkout_year=${yOut}&checkout_month=${mOut}&checkout_monthday=${dOut}&group_adults=${g}&no_rooms=${bookingRooms}&group_children=0&lang=fr`;
          } else {
            let bookingFilter = "";
            if (isSyntheticFallback && minPrice > 0 && maxPrice < 1000) {
              bookingFilter = `&nflt=price%3DEUR-${minPrice}-${maxPrice}-1`;
            }
            directUrl = `https://www.booking.com/searchresults.html?ss=${encodeURIComponent(targetSearchQuery)}&checkin=${ci}&checkout=${co}&checkin_year=${yIn}&checkin_month=${mIn}&checkin_monthday=${dIn}&checkout_year=${yOut}&checkout_month=${mOut}&checkout_monthday=${dOut}&group_adults=${g}&no_rooms=${bookingRooms}&group_children=0&sb=1&sb_lp=1&src=searchbox&src_elem=sb&lang=fr${bookingFilter}`;
          }
        } else if (platformId === 'airbnb') {
          // Respect strict du budget utilisateur réel (zéro filtrage artificiel destructeur)
          let airbnbPriceParams = "";
          if (minPrice > 0) airbnbPriceParams += `&price_min=${minPrice}`;
          if (maxPrice < 1000) airbnbPriceParams += `&price_max=${maxPrice}`;
          // Requête ciblée : nom établissement réel si certifié, quartier ou ville
          const airQuery = isSyntheticFallback ? (item.area ? `${item.area} ${dest}` : (landmark ? `${landmark} ${dest}` : dest)) : cleanQuery;
          directUrl = isSyntheticFallback
            ? `https://www.airbnb.fr/s/${encodeURIComponent(dest)}/homes?checkin=${ci}&checkout=${co}&check_in=${ci}&check_out=${co}&adults=${Math.min(guestsNum, 16)}${airbnbPriceParams}`
            : `https://www.airbnb.fr/s/${encodeURIComponent(dest)}/homes?query=${encodeURIComponent(airQuery)}&checkin=${ci}&checkout=${co}&check_in=${ci}&check_out=${co}&adults=${Math.min(guestsNum, 16)}${airbnbPriceParams}`;
        } else if (platformId === 'hotelscom') {
          directUrl = `https://fr.hotels.com/Hotel-Search?destination=${encodeURIComponent(targetSearchQuery)}&startDate=${ci}&endDate=${co}&d1=${ci}&d2=${co}&adults=${g}`;
        } else if (platformId === 'agoda') {
          directUrl = `https://www.agoda.com/fr-fr/search?text=${encodeURIComponent(targetSearchQuery)}&checkIn=${ci}&checkOut=${co}&rooms=${bookingRooms}&adults=${g}`;
        } else if (platformId === 'expedia') {
          directUrl = `https://www.expedia.fr/Hotel-Search?destination=${encodeURIComponent(targetSearchQuery)}&startDate=${ci}&endDate=${co}&d1=${ci}&d2=${co}&adults=${g}`;
        } else if (platformId === 'abritel') {
          const locForAbritel = isSyntheticFallback ? dest : targetRentalLoc;
          directUrl = `https://www.abritel.fr/Hotel-Search?destination=${encodeURIComponent(locForAbritel)}&startDate=${ci}&endDate=${co}&d1=${ci}&d2=${co}&adults=${g}`;
          if (minPrice > 0) directUrl += `&minPrice=${minPrice}`;
          if (maxPrice < 1000) directUrl += `&maxPrice=${maxPrice}`;
        } else if (platformId === 'tripadvisor') {
          directUrl = `https://www.tripadvisor.fr/Search?q=${encodeURIComponent(targetSearchQuery)}&checkin=${ci}&checkout=${co}`;
        } else if (platformId === 'hostelworld') {
          const hwCityMap = { 'barcelone': 'barcelona', 'londres': 'london', 'lisbonne': 'lisbon', 'séville': 'seville', 'seville': 'seville', 'venise': 'venice', 'vienne': 'vienna', 'athènes': 'athens', 'athenes': 'athens', 'bruxelles': 'brussels' };
          const dClean = (dest || '').trim().toLowerCase().replace(/[^\w\s-]/g, '');
          const hwSlug = hwCityMap[dClean] || dClean.replace(/\s+/g, '-');
          directUrl = `https://www.hostelworld.com/st/hostels/${encodeURIComponent(hwSlug)}/?dateFrom=${ci}&dateTo=${co}&number_of_guests=${g}`;
        } else if (platformId === 'kayak') {
          directUrl = `https://www.kayak.fr/hotels/${encodeURIComponent(targetSearchQuery)}/${ci}/${co}/${g}adults`;
        } else {
          // Google Hotels
          directUrl = `https://www.google.com/travel/hotels?q=${encodeURIComponent(googleQuery)}&dates=${ci}%2C${co}&adults=${Math.min(guestsNum, 10)}&num_adults=${guestsNum}&guests=${guestsNum}&hl=fr`;
        }

        directUrl = applyAffiliateToUrl(directUrl, platformId);
        googleUrl = applyAffiliateToUrl(googleUrl, 'googletravel');

        return {
          name: itemName,
          cleanQuery: cleanQuery,
          dest: dest,
          area: item.area || '',
          address: item.address || (item.area ? `Quartier ${item.area}, ${dest}` : (landmark ? `Secteur ${landmark}, ${dest}` : `Centre-ville, ${dest}`)),
          type: item.type,
          rating: item.rating,
          reviews: item.reviews,
          price: pNight,
          nights: nights,
          totalPrice: total,
          ci: ci,
          co: co,
          guests: guestsNum,
          dateLabel: `${formatDateFr(ci)} ➔ ${formatDateFr(co)}`,
          inBudget: inBudget,
          budgetStatusClass: budgetStatusClass,
          budgetStatusText: budgetStatusText,
          feeBreakdownText: ev.feeBreakdownText,
          feesPerNight: ev.feesPerNight,
          realDistKm: curDist,
          distText: distText,
          perks: item.perks,
          icon: item.icon,
          gradient: item.gradient,
          platformShort: platformShort,
          directUrl: directUrl,
          googleUrl: googleUrl,
          isTopValuePick: (idx === 0),
          valueScore: ev.valueScore,
          prestationScore: ev.prestationScore,
          lat: item.lat,
          lon: item.lon,
          platformId: platformId
        };
      });
    }

    function renderOfferCard(o, platformId, isBestPick = false) {
      const safeName = escapeHtml(o.name);
      const safeType = escapeHtml(o.type);
      const safeDist = escapeHtml(o.distText);
      const safeArea = o.area ? escapeHtml(o.area) : '';
      const safeAddress = escapeHtml(o.address || (o.area ? `Quartier ${o.area}, ${o.dest || ''}` : `${o.dest || 'Centre-ville'}`));
      const safePlatformShort = escapeHtml(o.platformShort);
      const encName = encodeURIComponent(o.name);
      const mapsQuery = (o.lat && o.lon) ? `${o.lat}%2C${o.lon}` : encodeURIComponent(`${o.name}, ${o.address || o.dest || ''}`);

      const isFav = typeof isHotelInFavorites === 'function' && isHotelInFavorites(o.name);
      const dropInfo = (typeof getHotelPriceDropInfo === 'function') ? getHotelPriceDropInfo(o.name, o.price) : { hasDrop: false };
      const showDropBadge = isFav && dropInfo.hasDrop;
      const favPayload = encodeURIComponent(JSON.stringify({
        name: o.name,
        type: o.type,
        dest: o.dest,
        address: o.address,
        price: o.price,
        rating: o.rating,
        reviews: o.reviews,
        distText: o.distText,
        directUrl: o.directUrl,
        googleUrl: o.googleUrl,
        platformShort: o.platformShort,
        icon: o.icon
      }));

      const hotelDetailPayload = encodeURIComponent(JSON.stringify({
        name: o.name,
        type: o.type,
        dest: o.dest,
        address: o.address,
        area: o.area,
        price: o.price,
        totalPrice: o.totalPrice,
        nights: o.nights,
        guests: o.guests,
        rating: o.rating,
        reviews: o.reviews,
        distText: o.distText,
        directUrl: o.directUrl,
        googleUrl: o.googleUrl,
        platformId: platformId || o.platformId,
        platformShort: o.platformShort,
        icon: o.icon,
        gradient: o.gradient,
        perks: o.perks || [],
        feeBreakdownText: o.feeBreakdownText || '',
        budgetStatusText: o.budgetStatusText || '',
        ci: o.ci,
        co: o.co,
        lat: o.lat,
        lon: o.lon,
        valueScore: o.valueScore
      }));

      const cardStyle = isBestPick
        ? "bg-gradient-to-br from-white via-emerald-50/25 to-teal-50/30 border-2 border-emerald-400 shadow-md ring-2 ring-emerald-400/20"
        : "bg-white hover:bg-indigo-50/40 border-2 border-slate-200 hover:border-indigo-300 shadow-sm";

      return `
        <div class="${cardStyle} transition-all rounded-xl p-3.5 flex flex-col justify-between gap-2.5">
          ${isBestPick ? `
            <div class="flex items-center justify-between gap-1 pb-1.5 border-b border-emerald-200/70 text-[10px]">
              <span class="font-black text-emerald-800 bg-emerald-100 px-2 py-0.5 rounded-md border border-emerald-300 flex items-center gap-1 shadow-2xs">
                <span>💎</span> <span>TOP 1 COÛT & PRESTATION</span>
              </span>
              <span class="text-[9px] font-extrabold text-emerald-700 bg-emerald-50 px-1.5 py-0.5 rounded border border-emerald-200">
                ⭐ Indice Valeur : <strong>${o.valueScore || 98}/100</strong>
              </span>
            </div>
          ` : ''}

          <!-- BLOC PRINCIPAL : NOM COMPLET + TARIF -->
          <div class="flex items-start justify-between gap-2.5">
            <div class="flex items-start gap-2.5 min-w-0 flex-1">
              <div onclick="openHotelDetailModal('${hotelDetailPayload}')" class="w-10 h-10 rounded-xl ${o.gradient} flex items-center justify-center text-xl shrink-0 shadow-sm border border-slate-200/60 font-black mt-0.5 cursor-pointer hover:scale-105 transition-transform" title="Consulter la fiche détaillée">
                ${o.icon}
              </div>
              <div class="min-w-0 flex-1">
                <!-- TYPE & BADGE -->
                <div class="flex items-center gap-1.5 mb-1 flex-wrap">
                  <span class="text-[9px] font-black uppercase px-1.5 py-0.5 rounded bg-slate-100 text-slate-700 border border-slate-200 inline-block">${safeType}</span>
                  ${safeArea ? `<span class="bg-indigo-50 text-indigo-700 border border-indigo-200 px-1.5 py-0.5 rounded text-[9px] font-black">📍 ${safeArea.includes('•') || safeArea.toLowerCase().startsWith('quartier') ? safeArea : `Quartier ${safeArea}`}</span>` : ''}
                </div>
                <!-- NOM COMPLET DU LOGEMENT (AUCUN TRUNCATE, CLIC POUR OUVRIR LA FICHE) -->
                <h4 onclick="openHotelDetailModal('${hotelDetailPayload}')" class="text-xs sm:text-sm font-black text-slate-900 leading-snug break-words cursor-pointer hover:text-blue-600 transition-colors" title="${escapeAttr(o.name)} (Cliquer pour ouvrir la fiche détaillée)">
                  ${safeName}
                </h4>
              </div>
            </div>

            <!-- BLOC TARIF UNIVERSEL MULTI-DEVISES -->
            <div class="text-right shrink-0">
              <div class="text-xs font-black text-emerald-700 bg-emerald-50 px-2.5 py-0.5 rounded-lg border border-emerald-300 flex items-center gap-1 shadow-xs whitespace-nowrap">
                <span class="text-sm font-black">${formatCurrencyPrice(o.price, true)}</span><span class="text-[9px] text-emerald-600 font-bold">/nuit TTC</span>
              </div>
              <div class="text-[9px] font-extrabold text-slate-600 mt-0.5" title="${o.price} € × ${o.nights} nuits">Total (${o.nights}n) : ${formatCurrencyPrice(o.totalPrice, false)} TTC</div>
              ${o.feeBreakdownText ? `<div class="text-[8px] font-semibold text-slate-500 mt-0.5 max-w-[150px] truncate" title="${escapeAttr(o.feeBreakdownText)}">${escapeHtml(o.feeBreakdownText)}</div>` : ''}
              <div class="text-[8px] font-bold ${o.budgetStatusClass} mt-0.5 px-1.5 py-0.5 rounded inline-block whitespace-nowrap">${o.budgetStatusText}</div>
            </div>
          </div>

          <!-- ALERTE VISUELLE DE BAISSE DE PRIX DÉTECTÉE SUR FAVORIS -->
          ${showDropBadge ? `
            <div class="flex items-center justify-between gap-1 px-2.5 py-1.5 rounded-lg bg-emerald-50 dark:bg-emerald-950/70 border border-emerald-300 dark:border-emerald-600 text-[10px] font-black text-emerald-800 dark:text-emerald-300 animate-pulse">
              <div class="flex items-center gap-1.5 flex-wrap">
                <span>📉</span>
                <span>Tarif en baisse par rapport à hier (-${dropInfo.dropPercent}%)</span>
                <span class="line-through text-slate-400 font-normal text-[9px]">${formatCurrencyPrice(dropInfo.oldPrice, true)}</span>
                <span class="text-emerald-600 dark:text-emerald-400 font-extrabold">➔ ${formatCurrencyPrice(dropInfo.currentPrice, true)}</span>
              </div>
              <span class="bg-emerald-500 text-white text-[9px] px-1.5 py-0.5 rounded-full font-bold shrink-0">Économie -${formatCurrencyPrice(dropInfo.savedEur, false)}</span>
            </div>
          ` : ''}

          <!-- ENCART ADRESSE PHYSIQUE COMPLÈTE -->
          <div class="bg-slate-50 border border-slate-200/90 rounded-lg px-2.5 py-1.5 flex items-center justify-between gap-2 text-[10px]">
            <div class="flex items-start gap-1.5 min-w-0 flex-1">
              <span class="shrink-0 text-slate-400 font-bold">📍</span>
              <div class="min-w-0">
                <span class="text-[9px] font-black text-slate-400 uppercase tracking-wider block">Adresse physique :</span>
                <span class="font-bold text-slate-800 leading-tight select-all break-words">${safeAddress}</span>
              </div>
            </div>
            <a href="https://www.google.com/maps/search/?api=1&query=${mapsQuery}" target="_blank" rel="noopener noreferrer" 
               class="btn-3d btn-3d-white text-[9px] py-1 px-2 shrink-0 flex items-center gap-1 text-blue-600 hover:text-blue-800 font-black" 
               title="Localiser l'adresse exacte sur Google Maps / Street View">
              <span>Plans</span><span class="text-[8px]">↗</span>
            </a>
          </div>

          <!-- DÉTAILS SECONDAIRES : NOTE, DISTANCE, DATES -->
          <div class="flex items-center justify-between gap-2 flex-wrap text-[10px] text-slate-500 font-bold">
            <div class="flex items-center gap-2 flex-wrap">
              <span class="text-amber-500 font-black">★ ${o.rating}</span>
              <span>(${o.reviews.toLocaleString('fr-FR')} avis)</span>
              <span class="text-slate-300">•</span>
              <span class="text-purple-700 font-black">🎯 ${safeDist}</span>
            </div>
            <div class="text-[10px] font-bold text-indigo-700 bg-indigo-50/90 px-2 py-0.5 rounded-md border border-indigo-200 inline-flex items-center gap-1.5 shadow-2xs">
              <span>📅</span>
              <span>Du <strong>${formatDateFr(o.ci)}</strong> au <strong>${formatDateFr(o.co)}</strong></span>
              <span class="text-indigo-500 font-extrabold">(${o.nights}n)</span>
            </div>
          </div>

          <!-- FOOTER : PRESTATIONS & BOUTONS D'ACTION -->
          <div class="flex items-center justify-between gap-1.5 pt-1.5 border-t border-slate-100 text-[10px]">
            <div class="flex items-center gap-1 flex-wrap text-[10px] text-slate-600 font-bold">
              ${(o.perks || []).map(perk => `<span class="bg-slate-50 border border-slate-200 px-1.5 py-0.5 rounded text-[9px] font-semibold">${escapeHtml(perk)}</span>`).join('')}
            </div>
            <div class="flex items-center gap-1 shrink-0">
              <button onclick="toggleFavoriteHotel('${favPayload}')" title="${isFav ? 'Retirer des favoris' : 'Ajouter à mes coups de cœur ❤️'}" aria-label="${isFav ? 'Retirer des favoris' : 'Ajouter aux favoris'}" class="btn-3d ${isFav ? 'bg-rose-50 text-rose-600 border-rose-300' : 'btn-3d-white text-slate-400'} text-[10px] py-1 px-2 flex items-center gap-1">
                <span>${isFav ? '❤️' : '🤍'}</span>
              </button>
              <button onclick="injectIntoDuel(decodeURIComponent('${encName}'), ${Number(o.price) || 0}, '${escapeAttr(platformId)}')" title="Comparer ce tarif dans l'onglet Duel 3 Voies" class="btn-3d btn-3d-white text-[10px] py-1 px-2">
                ⚔️ Duel
              </button>
              <button type="button" onclick="openHotelDetailModal('${hotelDetailPayload}')" title="Consulter la fiche détaillée et certifiée du logement" class="btn-3d btn-3d-white text-[10px] py-1 px-2 flex items-center gap-0.5 text-slate-700 cursor-pointer">
                <span>🌐 Fiche</span>
              </button>
              <a href="${escapeAttr(o.directUrl)}" target="_blank" rel="noopener noreferrer" onclick="trackOutboundClick('${escapeAttr(platformId)}', decodeURIComponent('${encName}'), decodeURIComponent('${encodeURIComponent(o.dest || '')}'), ${Number(o.price) || 0})" title="Ouvrir la réservation directe sur ${escapeAttr(o.platformShort)} du ${escapeAttr(o.dateLabel)}" class="btn-3d btn-3d-blue text-[10px] py-1 px-2.5 flex items-center gap-1">
                <span>Voir ${safePlatformShort}</span><span class="text-[8px]">↗</span>
              </a>
            </div>
          </div>
        </div>
      `;
    }

    function renderPlatformCards() {
      const dest = (document.getElementById('destInput')?.value || '').trim();
      const container = document.getElementById('platformsGrid');

      // Si aucune destination n'est saisie (après remise à zéro), vider les propositions pour fluidité maximale
      if (!dest) {
        container.innerHTML = `
          <div class="col-span-full bg-white border-2 border-dashed border-slate-300 rounded-3xl p-8 sm:p-12 text-center shadow-xs my-2">
            <div class="w-16 h-16 mx-auto mb-4 bg-indigo-50 border-2 border-indigo-200 rounded-2xl flex items-center justify-center text-3xl shadow-sm">
              🧭
            </div>
            <h3 class="text-xl font-black text-slate-800 mb-2">Prêt pour votre prochaine destination !</h3>
            <p class="text-sm font-bold text-slate-500 max-w-lg mx-auto mb-6 leading-relaxed">
              Toutes les propositions et données précédentes ont été effacées pour libérer la mémoire et garantir une fluidité absolue. Indiquez une ville ci-dessus ou choisissez une suggestion rapide pour afficher instantanément la meilleure offre Coût & Prestation de chaque comparateur.
            </p>
            <div class="flex flex-wrap items-center justify-center gap-2.5">
              <span class="text-xs font-black text-slate-400 uppercase tracking-wider mr-2">Suggestions rapides :</span>
              <button onclick="setDest('Madrid')" class="btn-3d btn-3d-white text-xs py-2 px-3.5 flex items-center gap-1.5">
                <span>🇪🇸</span> <span>Madrid</span>
              </button>
              <button onclick="setDest('Rome')" class="btn-3d btn-3d-white text-xs py-2 px-3.5 flex items-center gap-1.5">
                <span>🇮🇹</span> <span>Rome</span>
              </button>
              <button onclick="setDest('Paris')" class="btn-3d btn-3d-white text-xs py-2 px-3.5 flex items-center gap-1.5">
                <span>🇫🇷</span> <span>Paris</span>
              </button>
              <button onclick="setDest('Londres')" class="btn-3d btn-3d-white text-xs py-2 px-3.5 flex items-center gap-1.5">
                <span>🇬🇧</span> <span>Londres</span>
              </button>
              <button onclick="setDest('Barcelone')" class="btn-3d btn-3d-white text-xs py-2 px-3.5 flex items-center gap-1.5">
                <span>🇪🇸</span> <span>Barcelone</span>
              </button>
            </div>
          </div>
        `;
        return;
      }

      const ci = document.getElementById('checkInInput').value;
      const co = document.getElementById('checkOutInput').value;
      const g = document.getElementById('guestsInput').value;
      const { min, max } = getBudgetValues();
      const dist = getDistanceValue();
      const landmark = getLandmarkValue();
      const nights = getNightsBetween(ci, co);
      
      const budgetBadgeText = (min > 0 && max < 1000)
        ? `💰 ${formatCurrencyPrice(min, false)} - ${formatCurrencyPrice(max, false)}/n`
        : (max < 1000 ? `💰 Max ${formatCurrencyPrice(max, false)}/n` : (min > 0 ? `💰 Min ${formatCurrencyPrice(min, false)}/n` : `💰 Tout budget`));

      const distBadgeText = dist > 0
        ? `🎯 < ${dist} km ${landmark ? '(' + landmark + ')' : ''}`
        : `🎯 Ville entière`;

      const gNum = parseInt(g, 10) || 2;
      const roomsEst = Math.ceil(gNum / 2);
      let groupBannerHtml = "";
      if (gNum >= 5) {
        groupBannerHtml = `
          <div class="col-span-full bg-gradient-to-r from-amber-500/15 via-amber-50 to-orange-50 border-2 border-amber-300 rounded-3xl p-4 sm:p-5 mb-3 flex flex-col md:flex-row items-start md:items-center justify-between gap-3.5 shadow-xs">
            <div class="flex items-start sm:items-center gap-3">
              <div class="w-11 h-11 rounded-2xl bg-amber-500 text-white flex items-center justify-center text-2xl shadow-sm shrink-0 font-black">
                🏡
              </div>
              <div>
                <div class="text-xs font-black text-amber-900 uppercase tracking-wider flex items-center gap-2 flex-wrap">
                  <span>💡 Mode Grand Groupe Détecté : ${gNum} Voyageurs</span>
                  <span class="bg-amber-200 text-amber-900 text-[10px] font-black px-2 py-0.5 rounded-full shadow-2xs">Recommandation Stratégique</span>
                </div>
                <div class="text-xs font-bold text-amber-800 mt-1 leading-relaxed">
                  Pour <strong>${gNum} personnes</strong>, les hôtels imposent <strong>${roomsEst} chambres distinctes</strong>. Nous recommandons vivement de privilégier les <strong>Villas & Logements entiers (Abritel & Airbnb)</strong> ou la <strong>privatisation de dortoirs (Hostelworld)</strong> pour diviser les coûts par deux et préserver la convivialité du groupe !
                </div>
              </div>
            </div>
          </div>
        `;
      }

      container.innerHTML = groupBannerHtml + PLATFORMS.map(p => {
        const url = p.getUrl(dest, ci, co, g, min, max, landmark, dist);
        const offers = getPlatformTop4Listings(p.id, dest, ci, co, g, min, max, landmark, dist);
        const bestOffer = offers[0];
        const altOffers = offers.slice(1);
        const isExp = !!platformExpanded[p.id];

        const saving = (max < 1000 && bestOffer.price < max) ? (max - bestOffer.price) : 0;
        const savingBadge = saving > 0 ? `<span class="bg-blue-100 text-blue-900 text-[10px] font-black px-2 py-0.5 rounded-full border border-blue-200">💰 -${saving} € sous votre max</span>` : '';
        const bestStatusBadge = `<span class="bg-emerald-100 text-emerald-800 text-[10px] font-black px-2.5 py-0.5 rounded-full border border-emerald-300 flex items-center gap-1 shadow-2xs"><span>✓</span> <span>100% dans votre budget & rayon</span></span>${savingBadge ? ' ' + savingBadge : ''}`;

        return `
        <div class="card-duo card-duo-interactive p-5 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-base font-black text-slate-800">${p.name}</span>
              <span class="text-[10px] font-black uppercase px-2 py-0.5 rounded-md border ${p.badgeColor}">${p.badge}</span>
            </div>
            <p class="text-xs font-bold text-slate-500 mb-3 leading-relaxed">${p.desc}</p>
            <div class="text-[11px] font-black text-slate-500 mb-3 bg-slate-100 border border-slate-200 px-2.5 py-1.5 rounded-lg flex flex-wrap items-center justify-between gap-1">
              <span>📍 ${escapeHtml(dest)} (${escapeHtml(g)}p)</span>
              <span class="text-purple-700 font-black bg-purple-50 px-1.5 py-0.5 rounded border border-purple-200">${escapeHtml(distBadgeText)}</span>
              <span class="text-blue-700 font-black bg-blue-50 px-1.5 py-0.5 rounded border border-blue-200">${escapeHtml(budgetBadgeText)}</span>
              <span class="text-indigo-700 font-black bg-indigo-50 px-1.5 py-0.5 rounded border border-indigo-200">📅 ${formatDateFr(ci)} ➔ ${formatDateFr(co)} (${nights}n)</span>
            </div>
          </div>

          <!-- BOUTONS D'ACCÈS PLATEFORME -->
          <div class="flex items-center gap-2 mb-3">
            <a href="${escapeAttr(url)}" target="_blank" rel="noopener noreferrer" onclick="trackOutboundClick('${escapeAttr(p.id)}', 'Recherche Globale ${escapeAttr(p.name)}', decodeURIComponent('${encodeURIComponent(dest)}'), 0)"
               class="btn-3d ${p.btnColor} flex-1 py-2.5 text-xs text-center flex items-center justify-center gap-1.5">
              <span>EXPLORER TOUT ${p.name.toUpperCase()}</span><span class="text-[10px]">↗</span>
            </a>
            <button onclick="copyPlatformLink('${escapeAttr(url)}', this)" aria-label="Copier le lien pré-rempli ${escapeAttr(p.name)}" title="Copier le lien pré-rempli avec filtres" class="btn-3d btn-3d-white px-2.5 py-2.5 text-xs">
              📋
            </button>
          </div>

          <!-- 💎 MEILLEURE OFFRE COÛT & PRESTATION DIRECTEMENT VISIBLE -->
          <div class="mt-2 pt-3 border-t-2 border-slate-100">
            <div class="flex items-center justify-between mb-2">
              <div class="flex items-center gap-1.5 flex-wrap">
                <span class="text-xs font-black text-slate-900 flex items-center gap-1">
                  <span>💎</span> <span>Meilleure Offre Coût & Prestation</span>
                </span>
                ${bestStatusBadge}
              </div>
              ${altOffers.length > 0 ? `
                <button onclick="togglePlatformOffers('${escapeAttr(p.id)}')" aria-expanded="${isExp ? 'true' : 'false'}" aria-label="${isExp ? 'Masquer les alternatives' : 'Voir les 3 alternatives'}" class="btn-3d btn-3d-white text-[10px] py-0.5 px-2 text-slate-600">
                  ${isExp ? 'Masquer options ▲' : `+${altOffers.length} options ▼`}
                </button>
              ` : ''}
            </div>

            <!-- CARTE N°1 COÛT & PRESTATION (TOUJOURS VISIBLE DIRECTEMENT) -->
            <div class="relative">
              ${renderOfferCard(bestOffer, p.id, true)}
            </div>

            <!-- ALTERNATIVES SECONDAIRES (PLIÉES PAR DÉFAUT) -->
            ${(isExp && altOffers.length > 0) ? `
              <div class="space-y-2 mt-2 pt-2 border-t border-dashed border-slate-200">
                <div class="text-[10px] font-black text-slate-500 uppercase tracking-wider mb-1">Autres options comparées sur ${escapeHtml(p.name)} :</div>
                ${altOffers.map(o => renderOfferCard(o, p.id, false)).join('')}
              </div>
            ` : ''}
          </div>
        </div>
      `;
      }).join('');
    }

    // BANDEAU EN DIRECT (ZÉRO-CLIC)
    let weatherDebounce = null;
    function updateLiveStrip() {
      const dest = (document.getElementById('destInput')?.value || '').trim();
      if (!dest) {
        const curEl = document.getElementById('stripCurrencyText');
        if (curEl) curEl.innerText = "Devise locale : en attente de destination";
        const wIcon = document.getElementById('stripWeatherIcon');
        if (wIcon) wIcon.innerText = "🌍";
        const wText = document.getElementById('stripWeatherText');
        if (wText) wText.innerText = "Météo locale en direct : en attente de destination";
        return;
      }
      const dLower = dest.toLowerCase();
      let targetCur = 'EUR';
      if (dLower.includes('tokyo') || dLower.includes('japon') || dLower.includes('kyoto')) { targetCur = 'JPY'; }
      else if (dLower.includes('londres') || dLower.includes('uk') || dLower.includes('angleterre')) { targetCur = 'GBP'; }
      else if (dLower.includes('new york') || dLower.includes('usa') || dLower.includes('miami')) { targetCur = 'USD'; }
      else if (dLower.includes('suisse') || dLower.includes('geneve') || dLower.includes('zurich')) { targetCur = 'CHF'; }
      else if (dLower.includes('canada') || dLower.includes('montreal')) { targetCur = 'CAD'; }
      else if (dLower.includes('thailande') || dLower.includes('bangkok')) { targetCur = 'THB'; }

      if (targetCur !== 'EUR') {
        fetchWithTimeout(`https://api.frankfurter.app/latest?from=EUR&to=${targetCur}`, {}, 3500)
          .then(r => r.json())
          .then(data => {
            const rate = data.rates[targetCur];
            document.getElementById('stripCurrencyText').innerText = `1 EUR = ${rate} ${targetCur} (BCE)`;
          })
          .catch(() => {
            document.getElementById('stripCurrencyText').innerText = `Devise locale : ${targetCur}`;
          });
      } else {
        document.getElementById('stripCurrencyText').innerText = '1 EUR = 1.00 EUR (Zone Euro)';
      }

      clearTimeout(weatherDebounce);
      weatherDebounce = setTimeout(() => {
        fetchWithTimeout(`https://geocoding-api.open-meteo.com/v1/search?name=${encodeURIComponent(dest)}&count=1&language=fr&format=json`, {}, 3500)
          .then(r => r.json())
          .then(geo => {
            if (geo.results && geo.results.length > 0) {
              const { latitude, longitude, name } = geo.results[0];
              return fetchWithTimeout(`https://api.open-meteo.com/v1/forecast?latitude=${latitude}&longitude=${longitude}&current=temperature_2m,weather_code&timezone=auto`, {}, 3500)
                .then(r => r.json())
                .then(w => {
                  const temp = w.current.temperature_2m;
                  const code = w.current.weather_code;
                  let icon = '☀️'; let desc = 'Ensoleillé';
                  if (code >= 1 && code <= 3) { icon = '⛅'; desc = 'Partiellement nuageux'; }
                  else if (code >= 51 && code <= 67) { icon = '🌧️'; desc = 'Pluie'; }
                  else if (code >= 71) { icon = '❄️'; desc = 'Neige'; }
                  else if (code >= 95) { icon = '⛈️'; desc = 'Orage'; }
                  document.getElementById('stripWeatherIcon').innerText = icon;
                  document.getElementById('stripWeatherText').innerText = `${temp}°C • ${desc} à ${name}`;
                });
            } else {
              document.getElementById('stripWeatherText').innerText = `Météo disponible pour ${dest}`;
            }
          })
          .catch(() => {
            document.getElementById('stripWeatherText').innerText = `Climat agréable à ${dest}`;
          });
      }, 350);

      checkHolidays();
    }

    async function checkHolidays() {
      const dest = (document.getElementById('destInput').value || 'Rome').toLowerCase();
      const stripBox = document.getElementById('stripHolidayBox');
      const stripText = document.getElementById('stripHolidayText');
      const stripIcon = document.getElementById('stripHolidayIcon');
      const stripTitle = document.getElementById('stripHolidayTitle');

      let code = 'FR';
      if (dest.includes('rome') || dest.includes('italie') || dest.includes('italy')) code = 'IT';
      else if (dest.includes('madrid') || dest.includes('espagne') || dest.includes('barcelone')) code = 'ES';
      else if (dest.includes('tokyo') || dest.includes('japon')) code = 'JP';
      else if (dest.includes('londres') || dest.includes('uk')) code = 'GB';

      try {
        const ciVal = document.getElementById('checkInInput').value;
        const coVal = document.getElementById('checkOutInput').value;
        const ci = new Date(ciVal);
        const co = new Date(coVal);
        const year = (ci && !isNaN(ci.getFullYear())) ? ci.getFullYear() : new Date().getFullYear();

        const res = await fetchWithTimeout(`https://date.nager.at/api/v3/PublicHolidays/${year}/${code}`, {}, 3500);
        const list = await res.json();

        const found = list.find(h => {
          const hd = new Date(h.date);
          return hd >= ci && hd <= co;
        });

        if (found) {
          stripBox.className = "bg-amber-100 border-2 border-amber-300 rounded-xl p-3 flex items-center gap-3 animate-pulse";
          stripIcon.innerText = '🚨';
          stripTitle.innerText = 'PIC DE PRIX / FÉRIÉ DÉTECTÉ';
          stripTitle.className = "text-[10px] font-black uppercase text-amber-900 tracking-wider";
          stripText.innerText = `${found.localName} (${found.date}) !`;
        } else {
          stripBox.className = "bg-emerald-50 border border-emerald-200 rounded-xl p-3 flex items-center gap-3";
          stripIcon.innerText = '✅';
          stripTitle.innerText = 'Calendrier Local';
          stripTitle.className = "text-[10px] font-black uppercase text-emerald-700 tracking-wider";
          stripText.innerText = 'Tarifs normaux (aucun férié détecté)';
        }
      } catch (e) {
        stripText.innerText = 'Période standard vérifiée';
      }
    }

    function updatePriceBadge() {
      const { min, max } = getBudgetValues();
      const badge = document.getElementById('priceRangeBadge');
      const totalBadge = document.getElementById('totalStayEstimateBadge');
      
      if (badge) {
        if (min === 0 && max >= 1000) {
          badge.innerText = '♾️ Tout budget (sans filtre)';
          badge.className = 'bg-slate-100 text-slate-700 text-xs font-black px-3 py-1 rounded-full border border-slate-300';
        } else if (min === 0) {
          badge.innerText = `💰 Moins de ${formatCurrencyPrice(max, false)} / nuit`;
          badge.className = 'bg-emerald-100 text-emerald-800 text-xs font-black px-3 py-1 rounded-full border border-emerald-300';
        } else if (max >= 1000) {
          badge.innerText = `💰 À partir de ${formatCurrencyPrice(min, false)} / nuit`;
          badge.className = 'bg-amber-100 text-amber-800 text-xs font-black px-3 py-1 rounded-full border border-amber-300';
        } else {
          badge.innerText = `💰 ${formatCurrencyPrice(min, false)} ➔ ${formatCurrencyPrice(max, false)} / nuit`;
          badge.className = 'bg-blue-100 text-blue-800 text-xs font-black px-3 py-1 rounded-full border border-blue-300';
        }
      }

      // Calcul estimation total séjour
      if (totalBadge) {
        const ciVal = document.getElementById('checkInInput').value;
        const coVal = document.getElementById('checkOutInput').value;
        if (ciVal && coVal) {
          const d1 = new Date(ciVal);
          const d2 = new Date(coVal);
          const nights = Math.max(1, Math.round((d2 - d1) / (1000 * 60 * 60 * 24)));
          if (max < 1000) {
            const totMin = min * nights;
            const totMax = max * nights;
            totalBadge.innerText = `≈ ${formatCurrencyPrice(totMin, false)} à ${formatCurrencyPrice(totMax, false)} (${nights} nuits)`;
            totalBadge.classList.remove('hidden');
          } else {
            totalBadge.classList.add('hidden');
          }
        }
      }
    }

    function handleMinPriceChange(val, source) {
      let num = parseInt(val, 10);
      if (isNaN(num) || num < 0) num = 0;
      if (num > 1000) num = 1000;

      const maxVal = parseInt(document.getElementById('maxPriceInput').value, 10) || 1000;
      if (num > maxVal) {
        document.getElementById('maxPriceInput').value = num;
        document.getElementById('maxPriceRange').value = num;
      }

      if (source === 'range') {
        document.getElementById('minPriceInput').value = num;
      } else {
        document.getElementById('minPriceRange').value = num;
      }

      updatePriceBadge();
      onCriteriaChanged();
    }

    function handleMaxPriceChange(val, source) {
      let num = parseInt(val, 10);
      if (isNaN(num) || num < 10) num = 10;
      if (num > 1000) num = 1000;

      const minVal = parseInt(document.getElementById('minPriceInput').value, 10) || 0;
      if (num < minVal) {
        document.getElementById('minPriceInput').value = num;
        document.getElementById('minPriceRange').value = num;
      }

      if (source === 'range') {
        document.getElementById('maxPriceInput').value = num;
      } else {
        document.getElementById('maxPriceRange').value = num;
      }

      updatePriceBadge();
      onCriteriaChanged();
    }

    function setBudgetPreset(min, max) {
      document.getElementById('minPriceInput').value = min;
      document.getElementById('minPriceRange').value = min;
      document.getElementById('maxPriceInput').value = max;
      document.getElementById('maxPriceRange').value = max;
      
      // Ajuster le coût par nuit du simulateur TCO si pertinent
      const avgPrice = (min > 0 && max < 1000) ? Math.round((min + max) / 2) : (max < 1000 ? Math.round(max * 0.8) : 100);
      const tcoPriceInput = document.getElementById('tcoPricePerNight');
      if (tcoPriceInput) {
        tcoPriceInput.value = avgPrice;
      }

      updatePriceBadge();
      onCriteriaChanged();
    }

    function updateDistanceBadge() {
      const dist = getDistanceValue();
      const landmark = getLandmarkValue();
      const badge = document.getElementById('distBadge');
      const walkBadge = document.getElementById('walkTimeEstimateBadge');

      if (badge) {
        if (dist === 0) {
          badge.innerText = landmark ? `♾️ Toute la ville (${landmark})` : '♾️ Toute la ville (sans contrainte)';
          badge.className = 'bg-slate-100 text-slate-700 text-xs font-black px-3 py-1 rounded-full border border-slate-300';
        } else {
          const targetTxt = landmark ? `de "${landmark}"` : 'du centre';
          badge.innerText = `🎯 Max ${dist} km ${targetTxt}`;
          badge.className = 'bg-purple-100 text-purple-800 text-xs font-black px-3 py-1 rounded-full border border-purple-300';
        }
      }

      if (walkBadge) {
        if (dist > 0 && dist <= 4) {
          const walkMin = Math.round(dist * 12);
          walkBadge.innerText = `🚶 ~${walkMin} min à pied max`;
          walkBadge.classList.remove('hidden');
        } else if (dist > 4 && dist <= 10) {
          const bikeMin = Math.round(dist * 4);
          walkBadge.innerText = `🚲 ~${bikeMin} min vélo / métro`;
          walkBadge.classList.remove('hidden');
        } else if (dist > 10) {
          walkBadge.innerText = `🚗 ~${Math.round(dist * 1.5)} min voiture`;
          walkBadge.classList.remove('hidden');
        } else {
          walkBadge.classList.add('hidden');
        }
      }
    }

    function handleDistanceChange(val, source) {
      let num = parseFloat(val);
      if (isNaN(num) || num < 0) num = 0;
      if (num > 30) num = 30;

      if (source === 'range') {
        document.getElementById('distInput').value = num.toFixed(1);
      } else {
        document.getElementById('distRange').value = num;
      }

      updateDistanceBadge();
      onCriteriaChanged();
    }

    function handleLandmarkChange(val) {
      updateDistanceBadge();
      onCriteriaChanged();
      const dest = (document.getElementById('destInput')?.value || '').trim();
      if (val && val.trim() && dest) {
        clearTimeout(landmarkGeocodeDebounce);
        landmarkGeocodeDebounce = setTimeout(() => {
          resolveLandmarkGeocodeLive(val, dest);
        }, 350);
      }
    }

    function setDest(cityName) {
      const destInput = document.getElementById('destInput');
      if (destInput) {
        destInput.value = cityName;
        // Réinitialiser le repère clé pour ne pas hériter d'un monument d'une autre ville
        const landmarkInput = document.getElementById('landmarkInput');
        if (landmarkInput) {
          landmarkInput.value = '';
        }
        detectAndSuggestCurrencyForDest(cityName);
        updateStaySummaryBanner();
        updateLandmarkSuggestions();
        onCriteriaChanged();
        fetchAndVerifyLiveAccommodations(cityName);
        showDuoToast(`📍 Destination définie sur ${cityName} !`, "success", 2500);
      }
    }

    function executeSearch() {
      const destInput = document.getElementById('destInput');
      const dest = (destInput?.value || '').trim();
      if (!dest) {
        showDuoToast("Veuillez indiquer une destination pour lancer la recherche !", "warning", 3000);
        destInput?.focus();
        return;
      }
      closeDropdown('dest');
      closeDropdown('landmark');
      detectAndSuggestCurrencyForDest(dest);
      updateStaySummaryBanner();
      updateLandmarkSuggestions();
      onCriteriaChanged();
      fetchAndVerifyLiveAccommodations(dest);
      showDuoToast(`🔍 Recherche SmartTrip Pro actualisée pour ${dest} !`, "success", 3000);
    }

    function setDistancePreset(km) {
      document.getElementById('distInput').value = km.toFixed(1);
      document.getElementById('distRange').value = km;
      updateDistanceBadge();
      onCriteriaChanged();
    }

    function updateLandmarkSuggestions() {
      const container = document.getElementById('landmarkSuggestionsContainer');
      if (!container) return;
      const dest = (document.getElementById('destInput')?.value || '').trim().toLowerCase();

      let suggestions = [];
      if (dest.includes('madrid')) {
        suggestions = [
          { label: "🏛️ Sol (Centre Km 0)", val: "Puerta del Sol" },
          { label: "💼 Nord : Las Tablas", val: "Las Tablas" },
          { label: "🌳 Nord-Ouest : Puerta de Hierro", val: "Puerta de Hierro" },
          { label: "🏢 Mirasierra", val: "Mirasierra" },
          { label: "🚄 Chamartín & Cuatro Torres", val: "Gare de Chamartín" },
          { label: "✈️ IFEMA / Barajas", val: "IFEMA" }
        ];
      } else if (dest.includes('paris')) {
        suggestions = [
          { label: "🏛️ Louvre (Centre)", val: "Musée du Louvre" },
          { label: "🗼 Tour Eiffel", val: "Tour Eiffel" },
          { label: "✨ Champs-Élysées", val: "Champs-Élysées" },
          { label: "🎨 Montmartre", val: "Montmartre" },
          { label: "🚄 Gare de Lyon", val: "Gare de Lyon" }
        ];
      } else if (dest.includes('rome') || dest.includes('roma')) {
        suggestions = [
          { label: "🏛️ Colisée (Centre)", val: "Colisée" },
          { label: "🇻🇦 Vatican", val: "Vatican" },
          { label: "🚄 Gare Termini", val: "Gare Termini" },
          { label: "⛲ Fontaine de Trevi", val: "Fontaine de Trevi" }
        ];
      } else if (dest.includes('milan') || dest.includes('milano')) {
        suggestions = [
          { label: "🏛️ Duomo (Centre)", val: "Duomo" },
          { label: "🚄 Gare Milano Centrale", val: "Gare Centrale" },
          { label: "🍹 Quartier Navigli", val: "Navigli" },
          { label: "🎨 Brera", val: "Brera" },
          { label: "✈️ Aéroport Linate", val: "Aéroport Linate" },
          { label: "✈️ Aéroport Malpensa", val: "Aéroport Malpensa" }
        ];
      } else if (dest.includes('nice')) {
        suggestions = [
          { label: "🌊 Promenade des Anglais", val: "Promenade des Anglais" },
          { label: "🏛️ Place Masséna", val: "Place Masséna" },
          { label: "🏘️ Vieux-Nice", val: "Vieux-Nice" }
        ];
      } else if (dest.includes('barcelon')) {
        suggestions = [
          { label: "🏛️ Plaça Catalunya (Centre)", val: "Plaça de Catalunya" },
          { label: "⛪ Sagrada Família", val: "Sagrada Família" },
          { label: "🏖️ Barceloneta & Plage", val: "Barceloneta" },
          { label: "🚶 Las Ramblas", val: "Las Ramblas" },
          { label: "🚆 Gare de Sants", val: "Gare de Barcelona Sants" }
        ];
      } else if (dest.includes('londres') || dest.includes('london')) {
        suggestions = [
          { label: "🕰️ Big Ben / Westminster", val: "Big Ben" },
          { label: "🛍️ Covent Garden & Soho", val: "Covent Garden" },
          { label: "🚆 King's Cross", val: "King's Cross" },
          { label: "🌉 Tower Bridge", val: "Tower Bridge" }
        ];
      } else if (dest.includes('tokyo')) {
        suggestions = [
          { label: "🛍️ Shinjuku", val: "Shinjuku" },
          { label: "🚦 Shibuya", val: "Shibuya" },
